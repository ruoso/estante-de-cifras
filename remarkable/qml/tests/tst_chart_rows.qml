// behavior — the chart's rows (reader.qml_chart): SheetView over the
// backend's own sheet for fixtures/songs/every-row.cifra.md (generated by
// TestQMLFixtures, so the rows are chartRows exactly; design §6), and over
// that sheet with an `empty` row and a row of an unknown type spliced in.
// Each row type is drawn with the text it carries; repeats are drawn on their
// bars; an unknown row changes nothing; everything is one bit, in whole
// pixels (workflow 19 rule 6), in the reader's faces (workflow 19 §The
// screen, as amended).
import QtQuick
import QtTest
import "../chart"
import "../chart/metrics.js" as M
import "fixtures/every-row.js" as EveryRow
import "walk.js" as Walk

TestCase {
    id: testCase
    name: "ChartRows"
    when: windowShown
    width: 1404
    height: 1872

    Component {
        id: sheetView
        SheetView {}
    }

    function copy(sheet) {
        return JSON.parse(JSON.stringify(sheet));
    }

    function rowIndex(sheet, pred) {
        for (let i = 0; i < sheet.rows.length; ++i) {
            if (pred(sheet.rows[i]))
                return i;
        }
        return -1;
    }

    // every-row with an `empty` row after the Tab section's name and rows of
    // an unknown type at the start, in the middle and at the end.
    function withExtras() {
        const sheet = copy(EveryRow.sheet);
        const tab = rowIndex(sheet, r => r.type === "section" && r.name === "Tab");
        sheet.rows.splice(tab + 1, 0, { type: "empty" });
        return sheet;
    }

    function withUnknown() {
        const sheet = copy(EveryRow.sheet);
        const verse = rowIndex(sheet, r => r.type === "section" && r.name === "Verse");
        sheet.rows.splice(verse + 1, 0, { type: "hologram", text: "nothing to see", height: 900 });
        sheet.rows.unshift({ type: "hologram" });
        sheet.rows.push({ type: "marquee", text: "scrolling" });
        return sheet;
    }

    function open(sheet) {
        // Hosted in the test window's root, which is shown (TestCase is not),
        // so a page's visibility is its own.
        const view = createTemporaryObject(sheetView, testCase.parent, {
            sheet: sheet, width: M.chartWidth, height: M.contentHeight
        });
        verify(view !== null);
        compare(view.facesReady, true);
        verify(view.pageCount >= 1);
        return view;
    }

    function pieces(view, p) {
        return Walk.named(view.pageItem(p), "piece");
    }

    function texts(root, name) {
        return Walk.named(root, name).map(t => t.text);
    }

    function pieceOfRow(view, row) {
        return pieces(view, 0).filter(p => p.rowIndex === row);
    }

    // Design §6, chartRows: each row type drawn with the text its row carries.
    function test_eachRowTypeDrawn() {
        const sheet = withExtras();
        const view = open(sheet);
        compare(view.pageCount, 1);
        const page = view.pageItem(0);
        verify(page.visible);
        const rows = sheet.rows;

        // section, with ` ×2` for a heading that plays it twice
        compare(texts(page, "sectionName"), ["Intro ×2", "Verse", "Spoken", "Tab"]);

        // bars: the cells' text, in order
        const bars = rowIndex(sheet, r => r.type === "bars");
        const barPiece = pieceOfRow(view, bars);
        compare(barPiece.length, 1);
        compare(texts(barPiece[0], "chord"), rows[bars].cells.map(c => c[0].text));
        compare(Walk.named(barPiece[0], "bar").length, rows[bars].cells.length);

        // run: its cells in sequence
        const run = rowIndex(sheet, r => r.type === "run");
        compare(pieceOfRow(view, run).length, 1);
        compare(texts(pieceOfRow(view, run)[0], "chord"), rows[run].tokens.map(t => t.text));
        compare(pieceOfRow(view, run)[0].kind, "run");

        // sung: each chord over its words, at the segment's left edge
        const sungRows = [];
        for (let i = 0; i < rows.length; ++i)
            if (rows[i].type === "sung")
                sungRows.push(i);
        verify(sungRows.length >= 3);
        for (const r of sungRows) {
            const piece = pieceOfRow(view, r)[0];
            compare(piece.kind, "sung");
            const segments = Walk.named(piece, "sungSegment");
            compare(segments.length, rows[r].segments.length);
            for (let s = 0; s < segments.length; ++s) {
                const chord = Walk.named(segments[s], "chord")[0];
                const words = Walk.named(segments[s], "words")[0];
                compare(chord.text, rows[r].segments[s].chord);
                compare(words.text, rows[r].segments[s].words);
                compare(chord.x, words.x);
                verify(chord.y + chord.height <= words.y);
            }
        }
        // the hyphen: a chord wider than its part of a split word
        const split = rowIndex(sheet, r => r.type === "sung" && r.segments.some(s => s.chord === "Am7(11)"));
        verify(split >= 0);
        verify(rows[split].segments[0].hyphen);
        const hyphens = Walk.named(pieceOfRow(view, split)[0], "hyphen");
        compare(hyphens.length, 1);
        verify(hyphens[0].width >= 2 && hyphens[0].height >= 2);
        const firstSegment = Walk.named(pieceOfRow(view, split)[0], "sungSegment")[0];
        const firstWords = Walk.named(firstSegment, "words")[0];
        verify(hyphens[0].x >= firstWords.x + firstWords.width);

        // words
        const wordsRow = rowIndex(sheet, r => r.type === "words");
        compare(texts(pieceOfRow(view, wordsRow)[0], "wordsLine"), [rows[wordsRow].text]);

        // notes: every paragraph
        const notes = rowIndex(sheet, r => r.type === "notes");
        verify(rows[notes].paragraphs.length >= 2);
        compare(texts(page, "notesParagraph"), rows[notes].paragraphs);

        // verbatim: its lines, whitespace kept, in the mono face
        const verbatim = rowIndex(sheet, r => r.type === "verbatim");
        compare(texts(page, "verbatimLine"), rows[verbatim].text.split("\n"));
        compare(texts(page, "verbatimLine").join("\n"), rows[verbatim].text);

        // gap: room, and no ink
        const gap = rowIndex(sheet, r => r.type === "gap");
        const gapPiece = pieceOfRow(view, gap)[0];
        compare(gapPiece.kind, "gap");
        verify(gapPiece.height > 0);
        compare(Walk.inked(gapPiece).length, 0);

        // empty: reading.emptySection's copy
        compare(texts(page, "emptyNote"), ["Nothing written here yet."]);

        // every row has its piece, and nothing else is drawn
        const drawnRows = pieces(view, 0).map(p => p.rowIndex);
        for (let i = 0; i < rows.length; ++i)
            verify(drawnRows.indexOf(i) >= 0, "row " + i + " (" + rows[i].type + ") is drawn");
    }

    // Chart.jsx RuleMarks, as drawn on bars: the open and close repeat signs
    // on their bars, and the count after the close.
    function test_repeatSignsAndCount() {
        const sheet = copy(EveryRow.sheet);
        const view = open(sheet);
        const row = rowIndex(sheet, r => r.type === "bars" && r.marks);
        const marks = sheet.rows[row].marks;
        const barItems = Walk.named(pieceOfRow(view, row)[0], "bar");
        compare(barItems.length, marks.length);
        for (let i = 0; i < marks.length; ++i) {
            compare(Walk.named(barItems[i], "repeatOpen").length, marks[i].open ? 1 : 0, "open on bar " + i);
            compare(Walk.named(barItems[i], "repeatClose").length, marks[i].close ? 1 : 0, "close on bar " + i);
            compare(texts(barItems[i], "repeatCount"), marks[i].count ? ["×" + marks[i].count] : []);
        }
        verify(marks[0].open);
        compare(marks[marks.length - 1].count, 2);
        // A sign is a 6 px line, a 3 px line and two 8 px dots.
        const close = Walk.named(barItems[marks.length - 1], "repeatClose")[0];
        const parts = Walk.inked(close).filter(x => x !== close);
        compare(parts.map(x => x.width).sort((a, b) => a - b), [3, 6, 8, 8]);
        // The count sits after the close.
        const count = Walk.named(barItems[marks.length - 1], "repeatCount")[0];
        verify(count.x >= close.x + close.width);
    }

    // every-row with its bars counted 1, 2, 3… (its sung lines leave them
    // uncounted, cifra.md §2.8, so the count is spliced in) and, with
    // `shown`, the sheet's barNumbers on.
    function counted(shown) {
        const sheet = copy(EveryRow.sheet);
        let n = 1;
        for (const r of sheet.rows) {
            if (r.type === "bars")
                r.numbers = r.cells.map(() => ({ number: n++, stated: false }));
        }
        sheet.barNumbers = shown;
        return sheet;
    }

    // songs.bar_numbers, as the web app draws them (Chart.jsx `barnum`): with
    // the sheet's barNumbers, each row of bars has its first bar's number in
    // a margin ahead of it, right-aligned, one bit; without, none and no
    // margin.
    function test_barNumbers() {
        const hidden = open(counted(false));
        compare(Walk.named(hidden.pageItem(0), "barNumber").length, 0);
        const shown = open(counted(true));
        const sheet = counted(true);
        const row = rowIndex(sheet, r => r.type === "bars");
        verify(row >= 0, "a row of bars");
        // Each row of four numbered by its first bar: the line's first bar,
        // then the bar after the row before.
        let drawn = 0;
        for (let r = 0; r < sheet.rows.length; ++r) {
            if (sheet.rows[r].type !== "bars")
                continue;
            let next = sheet.rows[r].numbers[0].number;
            for (const p of pieceOfRow(shown, r)) {
                compare(texts(p, "barNumber"), [String(next)], "row " + r);
                next += Walk.named(p, "bar").length;
                const number = Walk.named(p, "barNumber")[0];
                const bar = Walk.named(p, "bar")[0];
                verify(number.x >= 0, "the number inside the row");
                verify(number.x + number.width <= bar.x - M.barNumberGap, "the number ahead of the first bar line");
                compare(number.fontInfo.family, shown.faces.mono);
                compare(number.font.pixelSize, M.barNumberSize);
                drawn += 1;
            }
        }
        verify(drawn > 0);
        // Hidden, the bars start at the row's edge.
        compare(Walk.named(pieceOfRow(hidden, row)[0], "bar")[0].x, 0);
        compare(Walk.oneBitProblems(shown.pageItem(0)), []);
        for (const p of pieces(shown, 0))
            verify(Walk.integral(p), p.kind + " at " + [p.x, p.y, p.width, p.height]);
    }

    // Design §6: a type the frontend does not know draws nothing and leaves
    // the layout as it is without it.
    function test_unknownRowIgnored() {
        const plain = open(copy(EveryRow.sheet));
        const extra = open(withUnknown());
        compare(extra.pageCount, plain.pageCount);
        compare(extra.columns, plain.columns);
        compare(extra.pages.map(p => p.chords), plain.pages.map(p => p.chords));
        const describe = (view) => pieces(view, 0).map(p => {
            const at = p.mapToItem(view.pageItem(0), 0, 0);
            return [p.kind, at.x, at.y, p.width, p.height, Walk.inked(p).map(t => t.text || "").join("|")];
        });
        compare(describe(extra), describe(plain));
        compare(Walk.inked(extra.pageItem(0)).length, Walk.inked(plain.pageItem(0)).length);
        for (const t of Walk.inked(extra.pageItem(0)))
            verify(t.text === undefined || (t.text.indexOf("nothing to see") < 0 && t.text.indexOf("scrolling") < 0));
    }

    // Workflow 19 rule 6: every Rectangle and Text black or white, with no
    // antialiasing on Rectangles, in whole pixels, strokes of at least 2 px.
    function test_oneBit() {
        const view = open(withExtras());
        const page = view.pageItem(0);
        const inked = Walk.inked(page);
        verify(inked.length > 20);
        compare(Walk.oneBitProblems(page), []);
        // The pieces are placed in whole pixels too.
        for (const p of pieces(view, 0))
            verify(Walk.integral(p), p.kind + " at " + [p.x, p.y, p.width, p.height]);
    }

    // Workflow 19 §The screen, as amended: the chord face is Figtree, the
    // section names Atkinson Hyperlegible and verbatim Atkinson Hyperlegible
    // Mono — the reader's own files, not a fallback. (A variable face
    // registers under its default instance's name, so Figtree's family reads
    // "Figtree Light": the test asks for the Figtree the Faces loaded.)
    function test_facesLoaded() {
        const view = open(withExtras());
        const page = view.pageItem(0);
        const chords = Walk.named(page, "chord");
        verify(chords.length > 0);
        verify(view.faces.chart.indexOf("Figtree") === 0, view.faces.chart);
        for (const c of chords)
            compare(c.fontInfo.family, view.faces.chart);
        const words = Walk.named(page, "words");
        verify(words.length > 0);
        compare(words[0].fontInfo.family, view.faces.chart);
        const sections = Walk.named(page, "sectionName");
        verify(sections.length > 0);
        for (const s of sections) {
            compare(s.fontInfo.family, "Atkinson Hyperlegible");
            compare(s.fontInfo.weight, Font.Bold);
        }
        const verbatim = Walk.named(page, "verbatimLine");
        verify(verbatim.length > 0);
        verify(view.faces.mono.indexOf("Atkinson Hyperlegible Mono") === 0, view.faces.mono);
        for (const v of verbatim)
            compare(v.fontInfo.family, view.faces.mono);
        // Mono: every character the same advance.
        const mono = Walk.named(page, "verbatimLine")[0];
        verify(mono.fontInfo.fixedPitch || mono.font.family === view.faces.mono);
    }
}
