// behavior — the song screen (reader.song_screen): SongScreen over the
// backend's own sheets for the fixture songs (fixtures/songs/, generated by
// TestQMLFixtures), sending through the AppLoad stand-in. The bar, the chart
// turned, the strip and its paging, the key grid, hiding a voicing, Hide
// shapes, the shapes' notes, a pending shape, one bit in every state.
// Workflow 19 §A song, §The screen, the refresh budget; design §6.
import QtQuick
import QtTest
import net.asivery.AppLoad 1.0
import "../song"
import "../song/strip.js" as Strip
import "../chart/metrics.js" as M
import "fixtures/few-chords.js" as FewChords
import "fixtures/few-chords-up2.js" as FewChordsUp2
import "fixtures/few-chords-saved.js" as FewChordsSaved
import "fixtures/no-chords.js" as NoChords
import "fixtures/strip-17.js" as Strip17
import "fixtures/choro-long.js" as ChoroLong
import "fixtures/choro-long-hidden.js" as ChoroLongHidden
import "fixtures/choro-31.js" as Choro31
import "fixtures/found-shape.js" as FoundShape
import "walk.js" as Walk

TestCase {
    id: testCase
    name: "SongScreen"
    when: windowShown
    width: 1404
    height: 1872

    Component {
        id: endpointComponent
        AppLoad {
            applicationID: "estante"
        }
    }

    Component {
        id: screenComponent
        SongScreen {}
    }

    // A sheet as the backend would send it again: a new object.
    function clone(x) {
        return JSON.parse(JSON.stringify(x));
    }

    // The screen over a sheet, hosted in the window's root (which is shown).
    function open(sheet, props) {
        const endpoint = createTemporaryObject(endpointComponent, testCase);
        const screen = createTemporaryObject(screenComponent, testCase.parent,
                                             Object.assign({ endpoint: endpoint, sheet: clone(sheet) }, props || {}));
        verify(screen !== null);
        compare(screen.view.ready, true);
        return screen;
    }

    function sent(screen) {
        return screen.endpoint.sent;
    }

    function cells(screen) {
        const out = [];
        for (let i = 0; i < screen.strip.diagrams.count; ++i)
            out.push(screen.strip.diagrams.itemAt(i));
        return out;
    }

    function keyNamed(screen, name) {
        const keys = screen.strip.grid.keys;
        for (let i = 0; i < keys.count; ++i)
            if (keys.itemAt(i).text === name)
                return keys.itemAt(i);
        return null;
    }

    function shownOnPage(screen, p) {
        return Strip.pageShapes(screen.sheet, screen.view.pages[p].chords).shown;
    }

    // Workflow 19 §A song L186–188 (the bar), §The screen L84–90 (Back a word
    // with its arrow; the foot): few-chords on its first page.
    function test_barFootAndStripDrawn() {
        const screen = open(FewChords.sheet);
        const bar = screen.bar;
        compare(bar.back.text, "Back");
        compare(bar.back.arrow, "left");
        verify(Walk.named(bar.back, "chevronStep").length > 0);
        compare(bar.title.text, "The Kettle on the Window Sill");
        compare(bar.artist.text, "The Fixture Trio");
        verify(bar.keyButton.visible);
        compare(bar.keyButton.text, "G");
        // The regions, fixed in place: the bar, the chart, the strip, the foot.
        compare([bar.y, bar.height], [0, M.barHeight]);
        compare([screen.foot.y, screen.foot.height], [1772, M.footHeight]);
        compare(screen.strip.height, M.stripHeight("compact", 1));
        compare(screen.strip.y + screen.strip.height, 1772);
        compare(screen.chart.y, M.barHeight);
        compare(screen.chart.height, M.contentHeight - screen.strip.height);
        // The foot.
        compare(screen.foot.shapesButton.text, "Hide shapes");
        verify(screen.foot.shapesButton.visible);
        compare(screen.view.pageCount, 2);
        compare(screen.foot.pageLabel.text, "1 of 2");
        verify(screen.foot.previous.visible);
        verify(screen.foot.next.visible);
        // The strip: its head, and this page's diagrams in the order they
        // first appear.
        const shown = shownOnPage(screen, 0);
        compare(screen.strip.headText.text, "Shapes on this page · " + shown.length);
        compare(cells(screen).map(c => c.diagram.symbol), shown.map(s => s.symbol));
        for (const c of cells(screen)) {
            verify(c.diagram.drawn);
            compare(c.diagram.size, "compact");
        }
    }

    // Workflow 19 §A song L262–265, §The screen L86–87: the right third, a
    // swipe right to left and › go forward; the left third, a swipe left to
    // right and ‹ back; the middle third and the strip do nothing; at the last
    // page the foot says End and next does nothing.
    function test_turnByThirdsSwipeAndArrows() {
        const screen = open(ChoroLong.sheet);
        const view = screen.view;
        const chart = screen.chart;
        compare(view.pageCount, 3);
        const y = Math.floor(chart.height / 2);
        mouseClick(chart, 1200, y);
        compare(view.page, 1);
        mouseClick(chart, 200, y);
        compare(view.page, 0);
        mouseDrag(chart, 1000, y, -400, 0);
        compare(view.page, 1);
        mouseDrag(chart, 400, y, 400, 0);
        compare(view.page, 0);
        mouseClick(screen.foot.next);
        compare(view.page, 1);
        mouseClick(screen.foot.previous);
        compare(view.page, 0);
        // The middle third, and the strip, are not turn zones.
        mouseClick(chart, 702, y);
        compare(view.page, 0);
        mouseClick(screen.strip, 1300, Math.floor(screen.strip.height / 2));
        mouseClick(screen.strip, 100, Math.floor(screen.strip.height / 2));
        compare(view.page, 0);
        // A swipe is one turn, whatever its length.
        mouseDrag(chart, 1300, y, -1200, 0);
        compare(view.page, 1);
        mouseClick(screen.foot.next);
        compare(view.page, 2);
        compare(screen.foot.pageLabel.text, "3 of 3 · End");
        // Next does nothing on the last page.
        mouseClick(screen.foot.next);
        mouseClick(chart, 1200, y);
        mouseDrag(chart, 1000, y, -400, 0);
        compare(view.page, 2);
        compare(screen.foot.pageLabel.text, "3 of 3 · End");
        // Previous does nothing on the first.
        mouseClick(screen.foot.previous);
        mouseClick(screen.foot.previous);
        compare(view.page, 0);
        mouseClick(screen.foot.previous);
        mouseClick(chart, 200, y);
        compare(view.page, 0);
        compare(screen.foot.pageLabel.text, "1 of 3");
        compare(sent(screen).length, 0);
    }

    // Rule 9; §A song L209–213: a turn shows the page SheetView prepared,
    // building only the one after, and the strip shows that page's shapes.
    function test_turnShowsPreparedPage() {
        const screen = open(ChoroLong.sheet);
        const view = screen.view;
        compare(view.preparedPage, 1);
        const prepared = view.pageItem(1);
        verify(prepared !== null);
        verify(!prepared.visible);
        const built = view.pagesBuilt;
        mouseClick(screen.chart, 1200, 300);
        compare(view.page, 1);
        compare(view.pageItem(1), prepared);
        verify(prepared.visible);
        compare(view.pagesBuilt, built + 1);
        compare(view.preparedPage, 2);
        const shown = shownOnPage(screen, 1);
        compare(cells(screen).map(c => c.diagram.symbol), shown.slice(0, 16).map(s => s.symbol));
    }

    // §A song L267–289, rule 8: on page 2, the key button opens the grid with
    // the sheet's twelve names, G inverted, As written: G; A is one tap, one
    // message; the answer closes the grid and shows page 1 in A.
    function test_keyChosenInOneStep() {
        const screen = open(FewChords.sheet);
        mouseClick(screen.foot.next);
        compare(screen.view.page, 1);
        mouseClick(screen.bar.keyButton);
        compare(screen.strip.mode, "grid");
        verify(screen.strip.grid.visible);
        const keys = screen.strip.grid.keys;
        compare(keys.count, 12);
        const names = [];
        for (let i = 0; i < 12; ++i)
            names.push(keys.itemAt(i).text);
        compare(names, FewChords.sheet.key.choices.map(c => c.name));
        for (let i = 0; i < 12; ++i)
            compare(keys.itemAt(i).inverted, keys.itemAt(i).text === "G", keys.itemAt(i).text);
        compare(screen.strip.grid.asWrittenLabel.text, "As written: G");
        compare(screen.strip.grid.yourKeyLabel.visible, false);
        compare(sent(screen).length, 0);
        mouseClick(keyNamed(screen, "A"));
        compare(sent(screen).length, 1);
        compare(sent(screen)[0].type, 3);
        compare(sent(screen)[0].payload, { offset: 2 });
        // The answer: the song in A, from its first page, the grid closed.
        screen.sheet = clone(FewChordsUp2.sheet);
        compare(screen.strip.mode, "shapes");
        verify(!screen.strip.grid.visible);
        compare(screen.view.page, 0);
        compare(screen.bar.keyButton.text, "A (+2)");
        compare(sent(screen).length, 1);
    }

    // Design §6 as amended (Decision 7): with a saved key, Your key is named
    // and As written sends offset 0; without one, no Your key, and As written
    // sends null.
    function test_asWrittenAndYourKey() {
        const saved = open(FewChordsSaved.sheet);
        compare(saved.bar.keyButton.text, "A (+2)");
        mouseClick(saved.bar.keyButton);
        compare(saved.strip.grid.yourKeyLabel.text, "Your key: A");
        verify(saved.strip.grid.yourKeyLabel.visible);
        compare(saved.strip.grid.asWrittenLabel.text, "As written: G");
        verify(keyNamed(saved, "A").inverted);
        mouseClick(saved.strip.grid.asWrittenButton);
        compare(sent(saved).length, 1);
        compare(sent(saved)[0].type, 3);
        compare(sent(saved)[0].payload, { offset: 0 });

        const plain = open(FewChords.sheet);
        mouseClick(plain.bar.keyButton);
        compare(plain.strip.grid.yourKeyLabel.visible, false);
        mouseClick(plain.strip.grid.asWrittenButton);
        compare(sent(plain).length, 1);
        compare(sent(plain)[0].type, 3);
        compare(sent(plain)[0].payload, { offset: null });
    }

    // §A song L295–296: a song with no chords has no key button and no strip;
    // the chart has the whole content.
    function test_noChordsNoKeyNoStrip() {
        const screen = open(NoChords.sheet);
        compare(screen.bar.keyButton.visible, false);
        compare(screen.strip.height, 0);
        compare(screen.strip.mode, "none");
        compare(screen.strip.panel.visible, false);
        compare(screen.chart.height, M.contentHeight);
        compare(screen.view.height, M.contentHeight);
        compare(screen.foot.shapesButton.visible, false);
        compare(screen.bar.title.text, "A Song Told in Words Alone");
        verify(screen.view.pageCount >= 1);
        // The key button's place takes no tap.
        mouseClick(screen.bar, 1300, 70);
        compare(screen.strip.mode, "none");
    }

    // §A song L223–230: strip-17's first page says 1–16 of 17 with 1 of 2; ›
    // turns the strip to the seventeenth shape and leaves the chart where it
    // is.
    function test_stripPagedAtSeventeen() {
        const screen = open(Strip17.sheet);
        compare(screen.view.page, 0);
        compare(screen.strip.headText.text, "Shapes on this page · 1–16 of 17");
        compare(screen.strip.stripPageLabel.text, "1 of 2");
        verify(screen.strip.stripNext.visible);
        verify(screen.strip.stripPrevious.visible);
        compare(screen.strip.diagrams.count, 16);
        waitForRendering(screen);
        const chartBefore = grabImage(screen.chart);
        const chartRevision = screen.chart.revision;
        mouseClick(screen.strip.stripNext);
        compare(screen.strip.diagrams.count, 1);
        compare(screen.strip.stripPageLabel.text, "2 of 2");
        compare(screen.strip.headText.text, "Shapes on this page · 17–17 of 17");
        compare(cells(screen)[0].diagram.symbol, shownOnPage(screen, 0)[16].symbol);
        compare(screen.view.page, 0);
        compare(screen.chart.revision, chartRevision);
        waitForRendering(screen);
        verify(grabImage(screen.chart).equals(chartBefore));
        mouseClick(screen.strip.stripPrevious);
        compare(screen.strip.diagrams.count, 16);
        compare(sent(screen).length, 0);
    }

    // §A song L232–240; design §6: a tapped diagram inverts and asks; Cancel
    // puts the head back and sends nothing; Hide sends one hideShape matching
    // the sheet.
    function test_hideVoicingAsksThenSends() {
        const screen = open(FewChords.sheet);
        const shape = shownOnPage(screen, 0)[1];
        mouseClick(cells(screen)[1]);
        compare(screen.strip.mode, "question");
        verify(cells(screen)[1].diagram.inverted);
        verify(!cells(screen)[0].diagram.inverted);
        compare(screen.strip.questionText, shape.symbol + " · " + shape.frets + " — hide this shape in every song?");
        verify(!screen.strip.headText.visible);
        mouseClick(screen.strip.cancelButton);
        compare(screen.strip.mode, "shapes");
        verify(screen.strip.headText.visible);
        verify(!cells(screen)[1].diagram.inverted);
        compare(sent(screen).length, 0);
        mouseClick(cells(screen)[1]);
        mouseClick(screen.strip.hideButton);
        compare(sent(screen).length, 1);
        compare(sent(screen)[0].type, 7);
        compare(sent(screen)[0].payload, { tuningId: FewChords.sheet.tuningId, chord: shape.chord, frets: shape.frets });
    }

    // Workflow 19 §A song L245–247 as amended: the head counts the hidden
    // shape, Show hidden turns the strip to it, Hidden on this page · 1 with
    // Done, and a tap shows it again.
    function test_showHiddenAndShowShape() {
        const screen = open(ChoroLongHidden.sheet);
        const hidden = Strip.pageShapes(screen.sheet, screen.view.pages[0].chords).hidden;
        compare(hidden.length, 1);
        verify(screen.strip.headText.text.endsWith(" · 1 hidden"), screen.strip.headText.text);
        verify(screen.strip.showHiddenButton.visible);
        mouseClick(screen.strip.showHiddenButton);
        compare(screen.strip.mode, "hidden");
        compare(screen.strip.headText.text, "Hidden on this page · 1");
        verify(screen.strip.doneButton.visible);
        verify(!screen.strip.showHiddenButton.visible);
        compare(screen.strip.diagrams.count, 1);
        compare(cells(screen)[0].diagram.symbol, hidden[0].symbol);
        compare(sent(screen).length, 0);
        mouseClick(cells(screen)[0]);
        compare(sent(screen).length, 1);
        compare(sent(screen)[0].type, 8);
        compare(sent(screen)[0].payload, { tuningId: ChoroLongHidden.sheet.tuningId, chord: hidden[0].chord,
                                           frets: hidden[0].frets });
        // Until Done, the strip stays with the hidden shapes.
        compare(screen.strip.mode, "hidden");
        mouseClick(screen.strip.doneButton);
        compare(screen.strip.mode, "shapes");
        verify(screen.strip.headText.text.startsWith("Shapes on this page"));
    }

    // §A song L252–257: on page 2 Hide shapes sends shapesShown false; the
    // state's answer lays the song out with no strip at the page holding the
    // row that was at the top; Show shapes does the reverse.
    function test_hideShapesFromTheBarAtTheTop() {
        const screen = open(ChoroLong.sheet);
        mouseClick(screen.foot.next);
        compare(screen.view.page, 1);
        const top = screen.view.pages[1].firstRow;
        mouseClick(screen.foot.shapesButton);
        compare(sent(screen).length, 1);
        compare(sent(screen)[0].type, 10);
        compare(sent(screen)[0].payload, { shown: false });
        // Nothing laid out before the state answers (Decision 9).
        compare(screen.strip.height, M.stripHeight("compact", 2));
        screen.shapesShown = false;
        compare(screen.strip.height, 0);
        compare(screen.chart.height, M.contentHeight);
        compare(screen.view.height, M.contentHeight);
        compare(screen.view.page, screen.view.pageOfRow(top));
        compare(screen.foot.shapesButton.text, "Show shapes");
        const hiddenTop = screen.view.pages[screen.view.page].firstRow;
        mouseClick(screen.foot.shapesButton);
        compare(sent(screen).length, 2);
        compare(sent(screen)[1].payload, { shown: true });
        screen.shapesShown = true;
        compare(screen.strip.height, M.stripHeight("compact", 2));
        compare(screen.view.page, screen.view.pageOfRow(hiddenTop));
        compare(screen.foot.shapesButton.text, "Hide shapes");
    }

    // Workflow 19 §A song L216–219 as amended: the shapes' notes follow the
    // chart's last row, on its last page.
    function test_shapesNotesOnLastPage() {
        const notes = FewChords.sheet.notes;
        compare(notes.length, 1);
        const screen = open(FewChords.sheet);
        const view = screen.view;
        const rows = view.sheet.rows;
        compare(rows.length, FewChords.sheet.rows.length + 1);
        compare(rows[rows.length - 1].type, "notes");
        compare(rows[rows.length - 1].paragraphs, notes);
        const last = view.pageCount - 1;
        while (view.page < last)
            mouseClick(screen.foot.next);
        const drawn = Walk.named(view.pageItem(last), "notesParagraph").map(t => t.text);
        compare(drawn[drawn.length - 1], notes[0]);
        for (let p = 0; p < last; ++p)
            verify(view.pages[p].firstRow < rows.length - 1);
    }

    // Design §6, §4.1: a pending shape keeps its empty place, and a tap on it
    // does nothing.
    function test_pendingShapeKeepsPlace() {
        const screen = open(Choro31.sheet);
        const pending = Choro31.sheet.shapes.filter(s => s.model === null);
        verify(pending.length > 0);
        let cell = null;
        for (let n = 0; n < 2 && cell === null; ++n) {
            for (const c of cells(screen))
                if (c.shape.chord === pending[0].chord)
                    cell = c;
            if (cell === null)
                mouseClick(screen.strip.stripNext);
        }
        verify(cell !== null);
        compare(cell.diagram.drawn, false);
        compare(Walk.inked(cell.diagram).length, 0);
        verify(cell.width > 0 && cell.height > 0);
        const mode = screen.strip.mode;
        const revision = screen.strip.revision;
        mouseClick(cell);
        compare(screen.strip.mode, mode);
        compare(screen.strip.revision, revision);
        compare(sent(screen).length, 0);
    }

    // Design §4.1 "A chord the song voices is never a miss"
    // (reader.bundle_chosen_unbuildable_pending): choro-long's block chooses a
    // Gm6 no hand can make, so its 105 holds no place for it. Walked over every
    // chart page and every strip page, no cell is Gm6 and the cells drawn are
    // exactly the sheet's shapes — Gm6 left out from the first read, never an
    // empty place — and nothing is sent.
    function test_chosenUnbuildableLeftOut() {
        const screen = open(ChoroLong.sheet);
        const view = screen.view;
        const drawn = {};
        for (let p = 0; p < view.pageCount; ++p) {
            while (view.page < p)
                mouseClick(screen.foot.next);
            compare(view.page, p);
            for (;;) {
                for (const c of cells(screen)) {
                    verify(c.shape.chord !== "Gm6", "Gm6 drawn on page " + p);
                    drawn[c.shape.chord] = true;
                }
                if (screen.strip.page.page >= screen.strip.page.pages - 1)
                    break;
                mouseClick(screen.strip.stripNext);
            }
        }
        const want = ChoroLong.sheet.shapes.map(s => s.chord);
        verify(want.indexOf("Gm6") < 0);
        compare(Object.keys(drawn).sort(), want.slice().sort());
        compare(sent(screen).length, 0);
    }

    // Rule 6: one bit, whole pixels, in every state of the screen — the strip,
    // the grid, the question, the hidden shapes.
    function test_oneBitEveryState() {
        const screen = open(FewChords.sheet);
        compare(Walk.oneBitProblems(screen), []);
        mouseClick(screen.bar.keyButton);
        compare(screen.strip.mode, "grid");
        compare(Walk.oneBitProblems(screen), []);
        mouseClick(screen.strip.grid.closeButton);
        mouseClick(cells(screen)[0]);
        compare(screen.strip.mode, "question");
        compare(Walk.oneBitProblems(screen), []);
        const hidden = open(ChoroLongHidden.sheet);
        mouseClick(hidden.strip.showHiddenButton);
        compare(hidden.strip.mode, "hidden");
        compare(Walk.oneBitProblems(hidden), []);
    }

    // --- a shape found in the background (reader.missed_shapes; design §6
    // 108) ---

    function foundChord() {
        const empty = FoundShape.sheet.shapes.filter(s => s.model === null);
        compare(empty.length, 1);
        return empty[0].chord;
    }

    // The found chord's cell on the second page, the strip paged to it.
    function cellOnSecondPage(screen, chord) {
        mouseClick(screen.foot.next);
        compare(screen.view.page, 1);
        for (let n = 0; n < 4; ++n) {
            for (const c of cells(screen))
                if (c.shape.chord === chord)
                    return c;
            if (!screen.strip.stripNext.visible)
                break;
            mouseClick(screen.strip.stripNext);
        }
        return null;
    }

    // Design §6 108: one for another song, another key or another tuning is
    // ignored — the held sheet's place stays empty after a turn.
    function test_foundForAnotherSongIgnored() {
        const chord = foundChord();
        const others = [
            { path: "another.cifra.md" },
            { offset: FoundShape.shapes.offset + 1 },
            { bookId: "bk-another" },
            { tuningId: "38 45 50 55 59 64" }
        ];
        for (const other of others) {
            const screen = open(FoundShape.sheet);
            screen.found(Object.assign(clone(FoundShape.shapes), other));
            const cell = cellOnSecondPage(screen, chord);
            verify(cell !== null, JSON.stringify(other));
            compare(cell.diagram.drawn, false, JSON.stringify(other));
            compare(Walk.inked(cell.diagram).length, 0, JSON.stringify(other));
        }
    }

    // §4.1, Decision 6: a 108 in which the pending chord is absent (no shape
    // found) keeps its empty place, untappable, on the next page.
    function test_foundWithoutShapeKeepsPlace() {
        const chord = foundChord();
        const screen = open(FoundShape.sheet);
        const height = screen.strip.height;
        const without = clone(FoundShape.shapes);
        without.shapes = without.shapes.filter(s => s.chord !== chord);
        screen.found(without);
        const cell = cellOnSecondPage(screen, chord);
        verify(cell !== null);
        compare(cell.diagram.drawn, false);
        compare(Walk.inked(cell.diagram).length, 0);
        compare(screen.strip.height, height);
        const mode = screen.strip.mode;
        const revision = screen.strip.revision;
        mouseClick(cell);
        compare(screen.strip.mode, mode);
        compare(screen.strip.revision, revision);
        compare(sent(screen).length, 0);
    }
}
