// behavior — the chart in pages (reader.qml_chart): SheetView over the
// backend's own sheets for the fixture songs (fixtures/songs/, generated by
// TestQMLFixtures). One column or two; a song laid out into pages with no
// line split; a wide sung line wrapped between segments; an all-chord song on
// one page with the shapes hidden, and a long one on three; the page of a
// row; the next page built ahead; nothing before the faces. Workflow 19 §A
// song (as amended), §Shapes on every page, the refresh budget's rules 1 and 9.
import QtQuick
import QtTest
import "../chart"
import "../chart/metrics.js" as M
import "fixtures/two-columns.js" as TwoColumns
import "fixtures/one-column.js" as OneColumn
import "fixtures/choro-31.js" as Choro31
import "fixtures/choro-long.js" as ChoroLong
import "walk.js" as Walk

TestCase {
    id: testCase
    name: "ChartPages"
    when: windowShown
    width: 1404
    height: 1872

    Component {
        id: sheetView
        SheetView {}
    }

    Component {
        id: notReady
        SheetView {
            facesReady: false
        }
    }

    // The height a two-row compact strip leaves the chart (workflow 19 §Shapes
    // on every page; Song.dc.html).
    readonly property int underTwoRowStrip: M.contentHeight - M.compactStripHeight(2)

    function open(sheet, height) {
        // Hosted in the test window's root, which is shown (TestCase is not).
        const view = createTemporaryObject(sheetView, testCase.parent, {
            sheet: sheet, width: M.chartWidth, height: height || M.contentHeight
        });
        verify(view !== null);
        compare(view.facesReady, true);
        return view;
    }

    function pieces(view, p) {
        return Walk.named(view.pageItem(p), "piece");
    }

    // The rows each page draws, from the layout, in order.
    function rowsByPage(view) {
        return view.layout.map(cols => {
            const rows = [];
            for (const col of cols)
                for (const s of col)
                    if (!s.dropped)
                        for (const r of s.rows)
                            if (rows.indexOf(r) < 0)
                                rows.push(r);
            return rows;
        });
    }

    // Workflow 19 §A song, as amended: two columns when the longest sung line
    // and the widest row of four bars fit half the page, else one.
    function test_twoColumnsWhenLongestLineFitsHalf() {
        const two = open(TwoColumns.sheet);
        compare(two.columns, 2);
        compare(two.columnWidth, Math.floor((M.chartWidth - M.columnGap) / 2));
        // The second column starts 64 px past the first.
        const xs = pieces(two, 0).map(p => p.mapToItem(two.pageItem(0), 0, 0).x);
        compare(xs.filter((x, i) => xs.indexOf(x) === i).sort((a, b) => a - b),
                [0, two.columnWidth + M.columnGap]);
        const one = open(OneColumn.sheet);
        compare(one.columns, 1);
        compare(one.columnWidth, M.chartWidth);
        // choro-31's lines are all short, but its rows of four bars are not.
        const choro = open(Choro31.sheet);
        compare(choro.columns, 1);
    }

    // Workflow 19 §A song: a column filled to its foot before the next; a sung
    // line, and a section name with its first line, never split.
    function test_songPaginatedWithNoLineSplit() {
        for (const [sheet, height] of [[TwoColumns.sheet, M.contentHeight], [OneColumn.sheet, 900]]) {
            const view = open(sheet, height);
            verify(view.pageCount >= 2, sheet.title + ": " + view.pageCount + " pages");
            // Every row on exactly one page, in order.
            const byPage = rowsByPage(view);
            const all = [].concat(...byPage);
            compare(all, sheet.rows.map((r, i) => i), sheet.title);
            // No section name ends a column (but the song's last).
            const columns = [].concat(...view.layout);
            for (let c = 0; c < columns.length - 1; ++c) {
                const drawn = columns[c].filter(s => !s.dropped);
                verify(drawn[drawn.length - 1].kind !== "section", sheet.title + ": column " + c + " ends on a section");
            }
            // Drawn: every sung line whole inside its column, on one page.
            const seen = {};
            for (let p = 0; p < view.pageCount; ++p) {
                view.page = p;
                const page = view.pageItem(p);
                verify(page.visible);
                for (const piece of pieces(view, p)) {
                    const at = piece.mapToItem(page, 0, 0);
                    verify(at.y >= 0 && at.y + piece.height <= view.height,
                           sheet.title + ": row " + piece.rowIndex + " crosses the column's foot");
                    if (piece.kind !== "sung")
                        continue;
                    verify(!(piece.rowIndex in seen), "row " + piece.rowIndex + " on two pages");
                    seen[piece.rowIndex] = p;
                    for (const seg of Walk.named(piece, "sungSegment")) {
                        const s = seg.mapToItem(page, 0, 0);
                        verify(s.y + seg.height <= at.y + piece.height);
                        verify(s.x + seg.width <= at.x + view.columnWidth);
                    }
                }
            }
            const sung = sheet.rows.map((r, i) => r.type === "sung" ? i : -1).filter(i => i >= 0);
            compare(Object.keys(seen).length, sung.length);
        }
    }

    // Song-lyrics.dc.html L44–50: in one column, a sung line wider than the
    // page wraps onto a second line at a segment boundary, each chord still
    // over its words.
    function test_wideLineWrapsBetweenSegments() {
        const view = open(OneColumn.sheet);
        const sung = pieces(view, 0).filter(p => p.kind === "sung");
        const wrapped = sung.filter(p => p.lineCount > 1);
        compare(wrapped.length, 1);
        // The line wider than half the page, but not the page, is one line.
        const wide = sung.filter(p => p.naturalWidth > view.columnWidth / 2 && p.naturalWidth <= view.columnWidth);
        verify(wide.length >= 1);
        for (const p of wide)
            compare(p.lineCount, 1);
        const line = wrapped[0];
        verify(line.naturalWidth > view.columnWidth);
        const segments = Walk.named(line, "sungSegment");
        compare(segments.length, OneColumn.sheet.rows[line.rowIndex].segments.length);
        const ys = segments.map(s => s.y);
        verify(ys[ys.length - 1] > ys[0]);
        let previous = null;
        for (const seg of segments) {
            const chord = Walk.named(seg, "chord")[0];
            const words = Walk.named(seg, "words")[0];
            compare(chord.x, words.x);
            verify(chord.y < words.y);
            verify(seg.x + seg.width <= line.width);
            if (previous && seg.y > previous.y)
                compare(seg.x, 0);      // the new line starts with a whole segment
            previous = seg;
        }
    }

    // Workflow 19 §A song: an all-chord song of 31 bars fits one page with the
    // shapes hidden — rows of 4, 4, 4, 3, the 1st and 2nd ending rows, then
    // 4, 4, 4, 2.
    function test_choro31OnOnePageShapesHidden() {
        const view = open(Choro31.sheet, M.contentHeight);
        compare(view.pageCount, 1);
        compare(view.preparedPage, -1);
        const page = view.pageItem(0);
        compare(Walk.named(page, "bar").length, 31);
        const rows = pieces(view, 0).filter(p => p.kind === "bars");
        compare(rows.map(r => Walk.named(r, "bar").length), [4, 4, 4, 3, 1, 1, 4, 4, 4, 2]);
        compare(rows.map(r => Walk.named(r, "endingLabel").map(t => t.text).join("")),
                ["", "", "", "", "1st", "2nd", "", "", "", ""]);
        // Each row of bars is laid out a quarter of the column to a bar.
        const quarter = Math.floor(view.columnWidth / 4);
        for (const r of rows)
            for (const bar of Walk.named(r, "bar"))
                verify(bar.width >= quarter);
        compare(Walk.oneBitProblems(page), []);
    }

    // Workflow 19 §A song and §Shapes on every page: choro-long in the height
    // a two-row compact strip leaves runs to three pages; no block of bars is
    // split where it fits a column; each page's chords are its chord keys in
    // the order they first appear.
    function test_choroLongPages() {
        const view = open(ChoroLong.sheet, underTwoRowStrip);
        compare(view.pageCount, 3);
        // Each block of bars, whole, in one slice.
        const slices = [].concat(...[].concat(...view.layout)).filter(s => !s.dropped);
        const bars = slices.filter(s => s.kind === "bars");
        compare(bars.length, 3);
        for (const s of bars) {
            compare(s.from, 0);
            verify(s.height <= underTwoRowStrip);
        }
        const units = bars.map(s => s.unit);
        compare(units.filter((u, i) => units.indexOf(u) === i).length, 3);
        // Chords per page, worked out from the rows the page draws.
        const byPage = rowsByPage(view);
        for (let p = 0; p < 3; ++p) {
            const keys = [];
            for (const r of byPage[p]) {
                const row = ChoroLong.sheet.rows[r];
                const cells = row.type === "bars" ? [].concat(...row.cells) : [];
                for (const c of cells)
                    if (c.token && keys.indexOf(c.token.key) < 0)
                        keys.push(c.token.key);
            }
            verify(keys.length > 0);
            compare(view.pages[p].chords, keys, "page " + p);
            // Every key is a shape of the sheet but Gm6, the shape the song
            // chose that no hand can make: unvoiced, it has none (design §4.1).
            const shapes = ChoroLong.sheet.shapes.map(s => s.chord);
            for (const k of keys)
                compare(shapes.indexOf(k) >= 0, k !== "Gm6", k);
        }
        // Every page fits its height.
        for (let p = 0; p < 3; ++p) {
            view.page = p;
            for (const piece of pieces(view, p))
                verify(piece.mapToItem(view.pageItem(p), 0, 0).y + piece.height <= underTwoRowStrip);
        }
    }

    // Workflow 19 L248–256 (Hide shapes lays out again from the bar at the
    // top): the page of each page's first row is that page; a row in the
    // middle of page 2 is on page 2.
    function test_pageOfRow() {
        for (const [sheet, height] of [[ChoroLong.sheet, underTwoRowStrip], [TwoColumns.sheet, M.contentHeight]]) {
            const view = open(sheet, height);
            verify(view.pageCount >= 2);
            for (let p = 0; p < view.pageCount; ++p)
                compare(view.pageOfRow(view.pages[p].firstRow), p);
            const rows = rowsByPage(view)[1];
            compare(view.pages[1].firstRow, rows[0]);
            compare(view.pageOfRow(rows[Math.floor(rows.length / 2)]), 1);
            compare(view.pageOfRow(rows[rows.length - 1]), 1);
            compare(view.pageOfRow(0), 0);
        }
    }

    // Workflow 19 rule 9: the next page laid out ahead. On page 0 page 1 is
    // built, complete and invisible; turning shows those same items, builds
    // nothing for page 1 and prepares page 2; the last page prepares none.
    function test_nextPagePreparedAhead() {
        const view = open(ChoroLong.sheet, underTwoRowStrip);
        compare(view.pageCount, 3);
        compare(view.page, 0);
        compare(view.preparedPage, 1);
        const first = view.pageItem(0);
        const ahead = view.pageItem(1);
        verify(first.visible);
        verify(ahead !== null);
        verify(!ahead.visible);
        compare(view.pagesBuilt, 2);
        // Complete: every piece the layout gives page 1, and all its bars.
        const expected = [].concat(...view.layout[1]).filter(s => !s.dropped)
                           .reduce((n, s) => n + (s.to - s.from), 0);
        const built = Walk.named(ahead, "piece");
        compare(built.length, expected);
        const bars = Walk.named(ahead, "bar").length;
        verify(bars > 0);

        view.page = 1;
        compare(view.pageItem(1), ahead);
        verify(ahead.visible);
        verify(!first.visible);
        compare(Walk.named(ahead, "piece").length, expected);
        compare(Walk.named(ahead, "bar").length, bars);
        compare(view.pagesBuilt, 3);      // page 2 only
        compare(view.preparedPage, 2);
        verify(view.pageItem(2) !== null);
        verify(!view.pageItem(2).visible);

        view.page = 2;
        compare(view.preparedPage, -1);
        compare(view.pagesBuilt, 3);
        verify(view.pageItem(2).visible);
        // Only the shown page is visible.
        compare(Walk.named(view, "page").filter(p => p.visible).length, 1);
    }

    // reader.song_screen Decision 3: pagesFor(h) is the pages a SheetView laid
    // out at h gives, from the blocks already measured, building no page; a
    // height change paginates the same blocks again.
    function test_pagesForMatchesALayout() {
        for (const sheet of [ChoroLong.sheet, TwoColumns.sheet]) {
            for (const [h1, h2] of [[underTwoRowStrip, M.contentHeight], [M.contentHeight, 900]]) {
                const view = open(sheet, h1);
                const built = view.pagesBuilt;
                const pages = view.pages;
                compare(view.pagesFor(h1), pages, sheet.title + " at " + h1);
                const other = open(sheet, h2);
                compare(view.pagesFor(h2), other.pages, sheet.title + " at " + h2);
                compare(view.pagesBuilt, built);
                compare(view.pages, pages);
                compare(view.page, 0);
                // The view itself at h2: the same pages.
                view.height = h2;
                compare(view.pages, other.pages);
                compare(view.columns, other.columns);
            }
        }
    }

    // Workflow 19 rule 1: nothing drawn incomplete — with the faces not yet
    // loaded nothing is laid out or drawn; once they are, the song is.
    function test_nothingBeforeFaces() {
        const view = createTemporaryObject(notReady, testCase.parent, {
            sheet: TwoColumns.sheet, width: M.chartWidth, height: M.contentHeight
        });
        compare(view.pageCount, 0);
        compare(view.columns, 0);
        compare(view.pages, []);
        compare(view.preparedPage, -1);
        compare(view.pageItem(0), null);
        compare(Walk.named(view, "page").length, 0);
        compare(Walk.inked(view).length, 0);
        view.facesReady = true;
        compare(view.pageCount, 2);
        verify(Walk.inked(view.pageItem(0)).length > 0);
    }
}
