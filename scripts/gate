#!/usr/bin/env bash
# The quality gate: every deterministic check this project has, in one place.
#
# This script is the single source of truth for "is the tree green?". The
# orchestrator driver runs it after every implementation (orchestrator/
# driver.py), people run it before committing, and CI — once the
# `foundation.ci` task lands — runs it too, rather than a list of its own.
#
# It verifies both parts of the repository:
#
#   - estante-de-cifras: the WBS (tj3 and scripts/unblocked.py), the app
#     (`app/`), the service (`service/`), and the end-to-end levels against
#     the compose stack (`e2e/api/`, `e2e/web/`);
#   - cifra.md (`cifra.md/`, a git subtree published to github.com/ruoso/
#     cifra.md), where tasks whose .tji note starts with "cifra.md:" land: the
#     Python reference's tests, the corpus check, and the JavaScript (`js/`)
#     and Go (`go/`) implementations.
#
# Each check runs when what it checks exists and is skipped, saying so, when it
# does not yet: nothing is built in estante-de-cifras at first, and the first
# tasks create app/, service/, js/ and go/. A check that exists and fails
# fails the gate.
#
# The test levels (tasks/refinements/README.md) and where they run here:
#
#   unit, behavior  `npm test` in app/ and cifra.md's js/, `go test` in
#                   service/ and cifra.md's go/, pytest in the reference, and
#                   the corpus check (format work's conformance level);
#   e2e-api         e2e/api/ (Vitest, black-box: HTTP and real git clients);
#   e2e-web         e2e/web/ (Playwright: phone, tablet and computer, axe).
#
# The end-to-end levels run against the compose stack. When compose.yaml and
# an e2e harness (e2e/api/package.json or e2e/web/package.json) exist, the
# gate brings the stack up ONCE — built from the working tree, under an
# isolated project name, on free ports, waiting for every healthcheck — runs
# the service's Go tests against its Postgres (behavior level), then e2e-api,
# then e2e-web, and always tears it down (trap). The excuse rule is the same
# as everywhere: skipped, saying why, only while no harness exists. A harness
# that exists must run: if compose.yaml, Docker or Playwright's browsers are
# missing, the gate FAILS and says what to install.
#
# What the stack is given (compose.yaml reads these; tests read them too):
#   ESTANTE_HTTP_PORT, ESTANTE_PG_PORT, ESTANTE_MAIL_PORT   published ports
#   ESTANTE_PG_USER, ESTANTE_PG_PASSWORD, ESTANTE_PG_DB     Postgres credentials
#   ESTANTE_E2E_BASE_URL   the one origin (app and API), e.g. http://127.0.0.1:N
#   ESTANTE_E2E_MAIL_URL   the mail catcher's HTTP API
#   ESTANTE_TEST_DATABASE_URL  the stack's Postgres, for Go behavior tests
#   ESTANTE_COMPOSE_PROJECT    the stack's compose project name
#
# Usage: scripts/gate [estante|cifra.md]...   (default: both)
# Environment:
#   ESTANTE_E2E_WORKERS   end-to-end workers (default: nproc, at most 4)
#
# Parallelism is always bounded: Go is given `-p $(nproc)`, Vitest in e2e/api
# `--maxWorkers=N` and Playwright `--workers=N` with an explicit N; nothing
# here runs an unbounded `-j`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
ROOT="$PWD"

JOBS="$(nproc)"
E2E_WORKERS="${ESTANTE_E2E_WORKERS:-$(( JOBS < 4 ? JOBS : 4 ))}"
if ! [[ "$E2E_WORKERS" =~ ^[1-9][0-9]*$ ]]; then
  echo "gate: ESTANTE_E2E_WORKERS must be a positive integer, got '$E2E_WORKERS'" >&2
  exit 2
fi
CIFRA_MD_DIR="$ROOT/cifra.md"

want_estante=1
want_cifra=1
if [[ $# -gt 0 ]]; then
  want_estante=0
  want_cifra=0
  for arg in "$@"; do
    case "$arg" in
      estante|estante-de-cifras) want_estante=1 ;;
      cifra.md|cifra) want_cifra=1 ;;
      *) echo "gate: unknown repository '$arg' (expected estante or cifra.md)" >&2; exit 2 ;;
    esac
  done
fi

TMP="$(mktemp -d)"
STACK_PROJECT=""   # set while a compose stack of ours is up

step() { echo; echo "gate: $*"; }
skip() { echo "gate: SKIP $*"; }
fail() { echo "gate: FAIL $*" >&2; exit 1; }

# Tear down the compose stack this run brought up, if any: containers,
# volumes and the images built for it. Idempotent; also run by the trap.
stack_down() {
  if [[ -n "$STACK_PROJECT" ]]; then
    local project="$STACK_PROJECT"
    STACK_PROJECT=""
    step "estante e2e: tearing down the stack ($project)"
    docker compose -p "$project" -f "$ROOT/compose.yaml" \
      down --volumes --remove-orphans --rmi local >"$TMP/compose-down.log" 2>&1 \
      || { cat "$TMP/compose-down.log"; echo "gate: WARNING could not tear down compose project $project" >&2; }
  fi
}
cleanup() { stack_down; rm -rf "$TMP"; }
trap cleanup EXIT
trap 'exit 130' INT TERM

# True when package.json in the current directory defines the npm script $1,
# not counting the placeholder `npm init` writes for `test` (which exits 1 by
# design: "Error: no test specified").
has_npm_script() {
  node -e '
    const s = (require("./package.json").scripts || {})[process.argv[1]];
    const placeholder = /no test specified/.test(s || "");
    process.exit(s && !placeholder ? 0 : 1);
  ' "$1"
}

# True when the npm package in the current directory has at least one test
# file. A runner such as Vitest fails when it finds none, which is where every
# package starts, so `test` is excused until the first test exists.
has_js_tests() {
  find . -path ./node_modules -prune -o -type f \
    \( -name '*.test.*' -o -name '*.spec.*' -o -path '*/__tests__/*' \) \
    -print -quit | grep -q .
}

# Install an npm package's dependencies when they are missing or older than
# its lockfile. Reproducible (`npm ci`) when there is a lockfile.
npm_install_if_needed() {
  if [[ -f package-lock.json ]]; then
    if [[ ! -f node_modules/.package-lock.json || package-lock.json -nt node_modules/.package-lock.json ]]; then
      step "$1: npm ci"
      npm ci --no-audit --no-fund
    fi
  elif [[ ! -d node_modules ]]; then
    step "$1: npm install (no lockfile yet; none written)"
    npm install --no-audit --no-fund --no-package-lock
  fi
}

# Run lint, unit tests and build of the npm package in the current directory,
# each when its script exists. CI=true keeps Vitest and friends from watching.
npm_checks() {
  local label="$1"
  npm_install_if_needed "$label"
  local script
  for script in lint test build; do
    if ! has_npm_script "$script"; then
      skip "$label: no '$script' script in package.json"
    elif [[ "$script" == test ]] && ! has_js_tests; then
      skip "$label: no test files yet"
    else
      step "$label: npm run $script"
      CI=true npm run "$script"
    fi
  done
}

# go vet, go test and go build of the module in the current directory. A
# module that has no packages yet (just `go mod init`) makes all three fail
# with "matched no packages", so it is excused until its first package exists.
# Binaries go to a temporary directory, never into the tree.
go_checks() {
  local label="$1"
  if [[ -z "$(go list ./... 2>/dev/null)" ]]; then
    skip "$label: no Go packages yet"
    return
  fi
  step "$label: go vet"
  go vet ./...
  step "$label: go test"
  go test -p "$JOBS" ./...
  step "$label: go build"
  if [[ -n "$(go list -f '{{if eq .Name "main"}}{{.ImportPath}}{{end}}' ./...)" ]]; then
    mkdir -p "$TMP/bin"
    go build -p "$JOBS" -o "$TMP/bin/" ./...
  else
    # Libraries only: building several packages writes nothing.
    go build -p "$JOBS" ./...
  fi
}

# A free TCP port on the loopback interface (the kernel picks it).
free_port() {
  python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()'
}

# The browsers e2e/web's Playwright configuration uses: chromium always;
# webkit when it names webkit or a WebKit device (iPhone, iPad, Safari);
# firefox when it names firefox.
playwright_browsers() {
  local configs=(playwright.config.*)
  local browsers="chromium"
  if [[ -e "${configs[0]}" ]]; then
    grep -qiE 'webkit|iphone|ipad|safari' "${configs[@]}" && browsers+=" webkit"
    grep -qi 'firefox' "${configs[@]}" && browsers+=" firefox"
  fi
  echo "$browsers"
}

# Everything an existing e2e harness needs, checked before anything is
# built, so a missing tool is a clear FAIL rather than a failure halfway.
e2e_preflight() {
  step "estante e2e: preflight (compose.yaml, Docker, Playwright's browsers)"
  [[ -f compose.yaml ]] \
    || fail "estante e2e: an e2e harness exists but compose.yaml does not — the harness runs against the compose stack"
  command -v docker >/dev/null 2>&1 \
    || fail "estante e2e: an e2e harness exists but docker is not installed — install Docker with the compose plugin"
  docker compose version >/dev/null 2>&1 \
    || fail "estante e2e: an e2e harness exists but 'docker compose' is unavailable — install the Docker compose plugin"
  docker info >/dev/null 2>&1 \
    || fail "estante e2e: an e2e harness exists but the Docker daemon is not reachable — start it, or give this user access"
  if [[ -f e2e/web/package.json ]]; then
    (
      cd e2e/web
      npm_install_if_needed "estante e2e-web"
      local browsers
      browsers="$(playwright_browsers)"
      [[ -d node_modules/@playwright/test ]] \
        || fail "estante e2e-web: e2e/web exists but @playwright/test is not among its dependencies"
      local missing
      if ! missing="$(node -e '
        const pw = require("@playwright/test");
        const fs = require("fs");
        const missing = process.argv.slice(1).filter((name) => {
          try { return !fs.existsSync(pw[name].executablePath()); } catch { return true; }
        });
        console.log(missing.join(" "));
        process.exit(missing.length ? 1 : 0);
      ' $browsers)"; then
        fail "estante e2e-web: Playwright's browsers are missing ($missing) — run 'npx playwright install --with-deps $browsers' in e2e/web"
      fi
    )
  fi
}

# Bring the compose stack up once, built from the working tree, under a
# project name of its own and on free ports, and wait for every healthcheck.
stack_up() {
  export ESTANTE_HTTP_PORT ESTANTE_PG_PORT ESTANTE_MAIL_PORT
  ESTANTE_HTTP_PORT="$(free_port)"
  ESTANTE_PG_PORT="$(free_port)"
  ESTANTE_MAIL_PORT="$(free_port)"
  export ESTANTE_PG_USER=estante ESTANTE_PG_PASSWORD=estante ESTANTE_PG_DB=estante
  export ESTANTE_E2E_BASE_URL="http://localhost:$ESTANTE_HTTP_PORT"
  export ESTANTE_E2E_MAIL_URL="http://127.0.0.1:$ESTANTE_MAIL_PORT"
  export ESTANTE_TEST_DATABASE_URL="postgres://$ESTANTE_PG_USER:$ESTANTE_PG_PASSWORD@127.0.0.1:$ESTANTE_PG_PORT/$ESTANTE_PG_DB?sslmode=disable"
  # The emailed sign-in link's signing secret (service.email_links): a per-run,
  # throwaway value the service container reads to HMAC-sign link tokens. compose
  # builds the public link on ESTANTE_E2E_BASE_URL (already exported above), so
  # the e2e test reads a link pointing at the stack it drives.
  export ESTANTE_LINK_SECRET="gate-link-secret-$$-$(date +%s)"
  # The passkey state token's signing secret (service.passkeys): a per-run,
  # throwaway HMAC key the service container seals and opens begin→finish state
  # with. The relying-party ID is the stack's one-origin host, `localhost`, which
  # the RP origin (derived from ESTANTE_E2E_BASE_URL) also uses, so the software
  # authenticator's ceremony validates. The host must be a named one, not an IP
  # literal: a real browser throws SecurityError "This is an invalid domain." on
  # navigator.credentials.create() against an http://127.0.0.1 origin for every
  # rp.id. This is the one place the stack's origin host is authored — compose
  # and both lib/env.js read it from here.
  export ESTANTE_WEBAUTHN_STATE_SECRET="gate-webauthn-state-secret-$$-$(date +%s)"
  export ESTANTE_WEBAUTHN_RP_ID="localhost"
  export ESTANTE_COMPOSE_PROJECT="estante-gate-$$-$(date +%s)"

  step "estante e2e: building and starting the stack ($ESTANTE_COMPOSE_PROJECT, origin $ESTANTE_E2E_BASE_URL)"
  STACK_PROJECT="$ESTANTE_COMPOSE_PROJECT"
  if ! docker compose -p "$ESTANTE_COMPOSE_PROJECT" -f compose.yaml \
      up --build --detach --wait --wait-timeout 300 >"$TMP/compose-up.log" 2>&1; then
    cat "$TMP/compose-up.log"
    docker compose -p "$ESTANTE_COMPOSE_PROJECT" -f compose.yaml ps -a || true
    docker compose -p "$ESTANTE_COMPOSE_PROJECT" -f compose.yaml logs --no-color --tail=200 || true
    fail "estante e2e: the compose stack did not come up healthy"
  fi
}

# ---------------------------------------------------------------------------
# estante-de-cifras
# ---------------------------------------------------------------------------

if [[ $want_estante -eq 1 ]]; then
  echo "gate: estante-de-cifras ($ROOT)"

  step "estante: tj3 (the WBS schedules, no errors or warnings)"
  # --no-reports: check only, nothing written to report/.
  if ! tj3 --silent --no-reports project.tjp >"$TMP/tj3.log" 2>&1; then
    cat "$TMP/tj3.log"
    echo "gate: FAIL tj3" >&2
    exit 1
  fi
  if grep -qiE "error|warning" "$TMP/tj3.log"; then
    cat "$TMP/tj3.log"
    echo "gate: FAIL tj3 reported errors or warnings" >&2
    exit 1
  fi

  step "estante: scripts/unblocked.py"
  python3 scripts/unblocked.py

  if [[ -f app/package.json ]]; then
    (cd app; npm_checks "estante app")
  else
    skip "estante app: app/package.json does not exist yet"
  fi

  # The example book (app/example-book/) is a songbook that ships with the app
  # (design.example_book). It must only ever hold canonical cifra.md text, so
  # every file is checked canonical and diagnostic-free with the cifra.md
  # reference — the same reference this gate's cifra.md section runs. The step
  # is guarded by the book existing and by the cifra.md/ subtree being present;
  # check-example-book builds the reference venv itself if it is not there yet.
  if [[ -d app/example-book ]]; then
    if [[ -f "$CIFRA_MD_DIR/reference/pyproject.toml" ]]; then
      step "estante example-book: cifra.md reference check (canonical + no diagnostics)"
      scripts/check-example-book
    else
      skip "estante example-book: no cifra.md reference at $CIFRA_MD_DIR"
    fi
  else
    skip "estante example-book: app/example-book/ does not exist yet"
  fi

  # The API contract (api/) is self-contained: one OpenAPI document and a thin
  # validator in each language the API has (JS for the app, Go for the service),
  # which the app and the service later import but do not share with each other
  # (DIRECTION §3.6). Its unit tests are plain npm/go checks, no stack needed.
  if [[ -f api/package.json ]]; then
    (cd api; npm_checks "estante api")
  else
    skip "estante api: api/package.json does not exist yet"
  fi
  if [[ -f api/go.mod ]]; then
    (cd api; go_checks "estante api")
  else
    skip "estante api: api/go.mod does not exist yet"
  fi

  # The stack comes up before the service's Go tests, whose behavior level
  # runs against its Postgres, and stays up for e2e-api and e2e-web.
  has_e2e_api=0; [[ -f e2e/api/package.json ]] && has_e2e_api=1
  has_e2e_web=0; [[ -f e2e/web/package.json ]] && has_e2e_web=1
  if [[ $has_e2e_api -eq 1 || $has_e2e_web -eq 1 ]]; then
    e2e_preflight
    stack_up
  elif [[ -f compose.yaml ]]; then
    skip "estante e2e: compose.yaml exists but no e2e harness yet (e2e/api/package.json, e2e/web/package.json)"
  else
    skip "estante e2e: compose.yaml and the e2e harnesses do not exist yet"
  fi

  if [[ -f service/go.mod ]]; then
    (cd service; go_checks "estante service")
  else
    skip "estante service: service/go.mod does not exist yet"
  fi

  if [[ $has_e2e_api -eq 1 ]]; then
    (
      cd e2e/api
      npm_install_if_needed "estante e2e-api"
      if has_npm_script lint; then
        step "estante e2e-api: npm run lint"
        CI=true npm run lint
      fi
      has_npm_script test || fail "estante e2e-api: e2e/api/package.json has no 'test' script — a harness that exists must run"
      step "estante e2e-api: npm test against the stack ($ESTANTE_E2E_BASE_URL, $E2E_WORKERS workers)"
      CI=true npm test -- --maxWorkers="$E2E_WORKERS"
    )
  elif [[ $has_e2e_web -eq 1 ]]; then
    skip "estante e2e-api: e2e/api/package.json does not exist yet"
  fi

  if [[ $has_e2e_web -eq 1 ]]; then
    (
      cd e2e/web
      if has_npm_script lint; then
        step "estante e2e-web: npm run lint"
        CI=true npm run lint
      fi
      step "estante e2e-web: playwright test against the stack ($ESTANTE_E2E_BASE_URL, $E2E_WORKERS workers)"
      CI=true npx --no-install playwright test --workers="$E2E_WORKERS"
    )
  elif [[ $has_e2e_api -eq 1 ]]; then
    skip "estante e2e-web: e2e/web/package.json does not exist yet"
  fi

  stack_down
fi

# ---------------------------------------------------------------------------
# cifra.md
# ---------------------------------------------------------------------------

if [[ $want_cifra -eq 1 ]]; then
  if [[ ! -d "$CIFRA_MD_DIR" ]]; then
    skip "cifra.md: no cifra.md/ subtree at $CIFRA_MD_DIR"
  else
    echo
    echo "gate: cifra.md ($CIFRA_MD_DIR)"

    if [[ -f "$CIFRA_MD_DIR/reference/pyproject.toml" ]]; then
      (
        cd "$CIFRA_MD_DIR/reference"
        if [[ ! -x .venv/bin/python ]]; then
          step "cifra.md reference: creating .venv"
          python3 -m venv .venv
          .venv/bin/pip install --quiet -e ".[test]"
        fi
        step "cifra.md reference: pytest"
        .venv/bin/python -m pytest -q
        step "cifra.md reference: corpus check"
        .venv/bin/python -m tools.corpus --check
      )
    else
      skip "cifra.md reference: reference/pyproject.toml does not exist"
    fi

    if [[ -f "$CIFRA_MD_DIR/js/package.json" ]]; then
      (cd "$CIFRA_MD_DIR/js"; npm_checks "cifra.md js")
    else
      skip "cifra.md js: js/package.json does not exist yet"
    fi

    if [[ -f "$CIFRA_MD_DIR/go/go.mod" ]]; then
      (cd "$CIFRA_MD_DIR/go"; go_checks "cifra.md go")
    else
      skip "cifra.md go: go/go.mod does not exist yet"
    fi

    # The random-document cross-check (DIRECTION §3.6): on top of the corpus,
    # the same seeded documents run through the Python, JavaScript and Go
    # implementations and their bytes are compared. Guarded on all three being
    # present (it drives node and go), at the tool's fixed default seed and
    # count so the run is deterministic and reproducible.
    if [[ -x "$CIFRA_MD_DIR/reference/.venv/bin/python" \
          && -f "$CIFRA_MD_DIR/js/package.json" \
          && -f "$CIFRA_MD_DIR/go/go.mod" ]]; then
      step "cifra.md cross-check: tools.crosscheck (python, js, go)"
      (cd "$CIFRA_MD_DIR/reference"; .venv/bin/python -m tools.crosscheck)
    else
      skip "cifra.md cross-check: needs the reference venv, js/ and go/ all present"
    fi
  fi
fi

echo
echo "gate: OK"
