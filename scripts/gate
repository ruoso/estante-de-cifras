#!/usr/bin/env bash
# The quality gate: every deterministic check this project has, in one place.
#
# This script is the single source of truth for "is the tree green?". The
# orchestrator driver runs it after every implementation (orchestrator/
# driver.py), people run it before committing, and CI — once the
# `foundation.ci` task lands — runs it too, rather than a list of its own.
#
# It verifies BOTH repositories the project works in:
#
#   - this one, estante-de-cifras: the WBS (tj3 and scripts/unblocked.py), the
#     app (`app/`) and the service (`service/`);
#   - the sibling cifra.md repository, where tasks whose .tji note starts with
#     "cifra.md:" land: the Python reference's tests, the corpus check, and the
#     JavaScript (`js/`) and Go (`go/`) implementations.
#
# Each check runs when what it checks exists and is skipped, saying so, when it
# does not yet: nothing is built in estante-de-cifras at first, and the first
# tasks create app/, service/, js/ and go/. A check that exists and fails
# fails the gate.
#
# Usage: scripts/gate [estante|cifra.md]...   (default: both)
# Environment:
#   ESTANTE_CIFRA_MD_DIR  the cifra.md checkout (default: ../cifra.md beside
#                         this repository; relative paths resolve from here)
#
# Parallelism is always bounded: Go is given `-p $(nproc)`; nothing here runs
# an unbounded `-j`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
ROOT="$PWD"

JOBS="$(nproc)"
CIFRA_MD_DIR="${ESTANTE_CIFRA_MD_DIR:-../cifra.md}"
case "$CIFRA_MD_DIR" in
  /*) ;;
  *) CIFRA_MD_DIR="$ROOT/$CIFRA_MD_DIR" ;;
esac
if [[ -d "$CIFRA_MD_DIR" ]]; then
  CIFRA_MD_DIR="$(cd "$CIFRA_MD_DIR" && pwd)"
fi

want_estante=1
want_cifra=1
if [[ $# -gt 0 ]]; then
  want_estante=0
  want_cifra=0
  for arg in "$@"; do
    case "$arg" in
      estante|estante-de-cifras) want_estante=1 ;;
      cifra.md|cifra) want_cifra=1 ;;
      *) echo "gate: unknown repository '$arg' (expected estante or cifra.md)" >&2; exit 2 ;;
    esac
  done
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

step() { echo; echo "gate: $*"; }
skip() { echo "gate: SKIP $*"; }

# True when package.json in the current directory defines the npm script $1.
has_npm_script() {
  node -e 'const s = require("./package.json").scripts || {}; process.exit(s[process.argv[1]] ? 0 : 1)' "$1"
}

# Install an npm package's dependencies when they are missing or older than
# its lockfile. Reproducible (`npm ci`) when there is a lockfile.
npm_install_if_needed() {
  if [[ -f package-lock.json ]]; then
    if [[ ! -f node_modules/.package-lock.json || package-lock.json -nt node_modules/.package-lock.json ]]; then
      step "$1: npm ci"
      npm ci --no-audit --no-fund
    fi
  elif [[ ! -d node_modules ]]; then
    step "$1: npm install (no lockfile yet; none written)"
    npm install --no-audit --no-fund --no-package-lock
  fi
}

# Run lint, unit tests and build of the npm package in the current directory,
# each when its script exists. CI=true keeps Vitest and friends from watching.
npm_checks() {
  local label="$1"
  npm_install_if_needed "$label"
  local script
  for script in lint test build; do
    if has_npm_script "$script"; then
      step "$label: npm run $script"
      CI=true npm run "$script"
    else
      skip "$label: no '$script' script in package.json"
    fi
  done
}

# go vet, go test and go build of the module in the current directory.
go_checks() {
  local label="$1"
  step "$label: go vet"
  go vet ./...
  step "$label: go test"
  go test -p "$JOBS" ./...
  step "$label: go build"
  mkdir -p "$TMP/bin"
  go build -p "$JOBS" -o "$TMP/bin/" ./...
}

# ---------------------------------------------------------------------------
# estante-de-cifras
# ---------------------------------------------------------------------------

if [[ $want_estante -eq 1 ]]; then
  echo "gate: estante-de-cifras ($ROOT)"

  step "estante: tj3 (the WBS schedules, no errors or warnings)"
  # --no-reports: check only, nothing written to report/.
  if ! tj3 --silent --no-reports project.tjp >"$TMP/tj3.log" 2>&1; then
    cat "$TMP/tj3.log"
    echo "gate: FAIL tj3" >&2
    exit 1
  fi
  if grep -qiE "error|warning" "$TMP/tj3.log"; then
    cat "$TMP/tj3.log"
    echo "gate: FAIL tj3 reported errors or warnings" >&2
    exit 1
  fi

  step "estante: scripts/unblocked.py"
  python3 scripts/unblocked.py

  if [[ -f app/package.json ]]; then
    (cd app; npm_checks "estante app")
  else
    skip "estante app: app/package.json does not exist yet"
  fi

  if [[ -f service/go.mod ]]; then
    (cd service; go_checks "estante service")
  else
    skip "estante service: service/go.mod does not exist yet"
  fi
fi

# ---------------------------------------------------------------------------
# cifra.md
# ---------------------------------------------------------------------------

if [[ $want_cifra -eq 1 ]]; then
  if [[ ! -d "$CIFRA_MD_DIR/.git" ]]; then
    skip "cifra.md: no checkout at $CIFRA_MD_DIR (set ESTANTE_CIFRA_MD_DIR)"
  else
    echo
    echo "gate: cifra.md ($CIFRA_MD_DIR)"

    if [[ -f "$CIFRA_MD_DIR/reference/pyproject.toml" ]]; then
      (
        cd "$CIFRA_MD_DIR/reference"
        if [[ ! -x .venv/bin/python ]]; then
          step "cifra.md reference: creating .venv"
          python3 -m venv .venv
          .venv/bin/pip install --quiet -e ".[test]"
        fi
        step "cifra.md reference: pytest"
        .venv/bin/python -m pytest -q
        step "cifra.md reference: corpus check"
        .venv/bin/python -m tools.corpus --check
      )
    else
      skip "cifra.md reference: reference/pyproject.toml does not exist"
    fi

    if [[ -f "$CIFRA_MD_DIR/js/package.json" ]]; then
      (cd "$CIFRA_MD_DIR/js"; npm_checks "cifra.md js")
    else
      skip "cifra.md js: js/package.json does not exist yet"
    fi

    if [[ -f "$CIFRA_MD_DIR/go/go.mod" ]]; then
      (cd "$CIFRA_MD_DIR/go"; go_checks "cifra.md go")
    else
      skip "cifra.md go: go/go.mod does not exist yet"
    fi
  fi
fi

echo
echo "gate: OK"
