# 45 — Sync and merging on the device
#
# Fetch, merge, push; conflicts; uploads. Workflows 7, 8, 9, 11.

task sync "Sync" {
  depends storage.working_copy, cifra_js.merge, foundation.e2e_api

  task engine "Sync engine" {
    effort 3d
    allocate team
    complete 100
    depends service.change_check, storage.home_book, storage.preferences_surface, storage.shelf_surface
    note "When it runs (open, foreground, network back, after save, every five minutes), the change check first, fetch, cifra-aware merge, push, retried three times on a lost race. Workflow 8. Tests: unit (when it runs, the retry policy); behavior (fetch, cifra-aware merge and push against a local git remote with a second clone racing it, retried three times); e2e-api (two isomorphic-git devices against the stack: both edit, the change check, a clean merge pushed and fetched back — the two-device journey's sync half). Refinement: tasks/refinements/sync/engine.md"
  }
  task unsaved "Merging under unsaved changes" {
    effort 2d
    allocate team
    complete 100
    depends !engine
    note "Base, theirs and the working text merged; the edits stay unsaved on top. DIRECTION §3.1, workflow 4. Tests: behavior (base, theirs and the working text merged against a local remote; the edits still unsaved on top; a merge that conflicts with unsaved text — DIRECTION §3.1, workflow 4). Refinement: tasks/refinements/sync/unsaved.md"
  }
  task states "States on the shelf" {
    effort 1d
    allocate team
    complete 100
    depends !engine, foundation.e2e_web
    note "Syncing, saves waiting, offline since, needs you, no longer shared with you; the one quiet mark; sync now. Workflow 8. Tests: unit (deriving each state); behavior (the shelf's marks rendered with Testing Library and axe, each carried by a word); e2e-web (offline then back on the stack: offline since, saves waiting, then synced; sync now). Refinement: tasks/refinements/sync/states.md"
  }
  task states_e2e_hosted "Hosted-book sync state e2e journey" {
    effort 1d
    allocate team
    depends !states, books.online
    note "A correction owed by sync.states, which landed without its hosted-book e2e journey — not new work. Put a local book online (books.online), take the device offline and back on the compose stack, and assert offline since …, N saves waiting, the header mark, then cleared after sync; axe on each state on all three viewports. Needs only books.online: one device's own book, no invitation. Source of debt: tasks/refinements/sync/states.md (sync.states). Tests: e2e-web (hosted book offline→online state transitions, axe on phone/tablet/computer)."
  }
  task conflicts "Conflicts" {
    effort 4d
    allocate team
    complete 100
    depends !engine, foundation.e2e_web, books.add_by_link
    note "The book paused while a merge waits; the conflict model shown in musical terms; keep mine, take theirs, edit with markers; deleted against edited; abandon the merge. Workflow 9. Tests: unit (the conflict model in musical terms); behavior (the conflict screens with Testing Library and axe; keyboard paths through keep mine, take theirs, edit with markers, abandon); e2e-web (two devices — two browser contexts on the stack — edit the same bar, the conflict settled each way on phone, tablet and computer, axe on every conflict screen). Refinement: tasks/refinements/sync/conflicts.md"
  }
  task keep_both "Keep-both conflict resolution" {
    effort 2d
    allocate team
    complete 100
    depends !conflicts
    note "Keep-both resolution: theirs into a new variation for a voicing, a <name>-other.cifra.md sibling for a song; workflow 9 §Later. Source of debt: tasks/refinements/sync/conflicts.md (sync.conflicts). Tests: behavior (each keep-both against a local remote; axe); e2e-web (keep both a voicing on the three viewports; axe). Refinement: tasks/refinements/sync/keep_both.md"
  }
  task lost_access "Losing access" {
    effort 1d
    allocate team
    complete 100
    depends !engine, service.sharing, foundation.e2e_web, books.add_by_link
    note "Refused for not being a member: no longer shared with you, readable, never synced; unsaved saves kept, fork or download offered. Workflow 8. Tests: behavior (a refusal for not being a member marks the book, keeps unsaved saves, stops syncing); e2e-web (the owner removes a member on the stack; the member's device shows no longer shared with you, the song still readable, fork and download offered; axe). Refinement: tasks/refinements/sync/lost_access.md"
  }
  task upload "Upload a zip" {
    effort 4d
    allocate team
    complete 100
    depends !engine, books.online
    note "Read as a remote to pull from; the preview; edits never committed as a commit; no history; unrelated history; marked files left out; committed markers offer the latest version without history; history rewritten to canonical. Workflow 7. Tests: unit (reading a zip as a remote); behavior (each workflow-7 case against a local repository: no history, unrelated history, marked files left out, committed markers, history rewritten to canonical; edits never committed as a commit). Refinement: tasks/refinements/sync/upload.md"
  }
  task fork_follow "Following an original" {
    effort 2d
    allocate team
    depends !engine, service.books
    note "The original's new saves counted; bring them in through the preview; the original going away. Workflow 11. Tests: behavior (the original's new saves counted, brought in through the preview, the original gone — against local remotes); e2e-api (fork on the stack, push to the original, the fork's device counts and brings in the new save)."
  }
  task read_in_place "A song open while sync changes it" {
    effort 1.5d
    allocate team
    complete 100
    depends songs.reading, !states, books.online
    note "Unfinished work for this task is on the branch wip/sync-read-in-place (in-place update, notice, full-screen defer, unit and behavior tests passing): restore it into the working tree first (git cherry-pick --no-commit wip/sync-read-in-place), then write the missing e2e-web scenarios. Its e2e needs a hosted book on the device's shelf: put a local book online (books.online), and play the second device with the git CLI pushing to it as the same user. When a sync brings a new version of the open song, it updates in place keeping the place on the page, with a notice — updated by {name}: see what changed — that opens its history. Read full screen, the update waits until the reader leaves. Source of debt: tasks/refinements/songs/reading.md (songs.reading). Workflow 8 §A song open while it changes (L50-54). Tests: behavior (the in-place update keeps the place, the notice opens history, full screen defers until exit; axe); e2e-web (a song open while a sync from the stack brings a new version updates in place on the three viewports, full screen defers; axe). Refinement: tasks/refinements/sync/read_in_place.md"
  }
}
