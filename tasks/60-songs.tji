# 60 — Songs
#
# Finding, reading, writing, editing, arranging and the history of a song.

task songs "Songs" {
  depends shell.layout, shell.chart, foundation.e2e_web

  task search "Search" {
    effort 3d
    allocate team
    complete 100
    depends storage.index
    note "One box across every book; recents (kept on the device); books as sections; the explorer as a result when the text is a chord; badges; scope that resets each session. Workflow 2. Tests: unit (the query: a chord recognised, scope); behavior (results by book, recents, badges, scope reset, Testing Library and axe); e2e-web (search across books on the three viewports, a chord offering the explorer, search after an offline reload; axe). Refinement: tasks/refinements/songs/search.md"
  }
  task reading "Reading a song" {
    effort 3d
    allocate team
    complete 100
    depends music.fallback, music.transpose
    note "The chart and the shapes, variation picker, full screen, print, add to setlist, share; updated in place by sync. Workflows 2, 8. Tests: behavior (variation picker, full screen, print styles, add to setlist, share; Testing Library and axe); e2e-web (open and read a song on the three viewports, transpose and reopen, updated in place by a sync from the stack; offline: after a reload with the network cut, the song, its shapes and the explorer; axe). Refinement: tasks/refinements/songs/reading.md"
  }
  task first_song "Playing on guitar — change?" {
    effort 0.5d
    allocate team
    complete 100
    depends !reading, music.instruments
    note "The one-time prompt the first time a song is opened. Workflow 1. Tests: behavior (the prompt once, axe); e2e-web (the first song opened asks, the second does not). Refinement: tasks/refinements/songs/first_song.md"
  }
  task editor "The source editor" {
    effort 4d
    allocate team
    complete 100
    depends storage.working_copy
    note "CodeMirror 6 on the cifra.md text: syntax colour, the template, add section, preview beside or a tap away, pasting a cifra into a fence with undo, a voicing line it cannot read stopping the save. Workflows 3, 4. Tests: unit (syntax colouring, paste into a fence); behavior (CodeMirror with Testing Library: the template, add section, paste with undo, an unreadable voicing line stopping the save; axe); e2e-web (editing a song by keyboard and touch on the three viewports; axe). Refinement: tasks/refinements/songs/editor.md"
  }
  task new_song "Writing a new song" {
    effort 2d
    allocate team
    complete 100
    depends !editor, !search, books.shelf, account.first_run
    note "From search, the empty shelf, a book, the file view; which book; named once at the first save; My songs created when first written to. Workflow 3. Tests: unit (deriveSongFilename); behavior (which book, the name at first save, My songs created; axe); e2e-web (write a new song from search, the empty shelf, a book and the file view, offline; axe). Refinement: tasks/refinements/songs/new_song.md"
  }
  task save_sheet "Save, discard, and the save sheet" {
    effort 2d
    allocate team
    complete 100
    depends !editor, cifra_js.diff
    note "What changed in musical terms, a note prefilled from it, save pushes; discard showing what would be lost; save all; the first save asking for a name. Workflow 4. Tests: unit (renderChange, buildSaveNote); behavior (the sheet's musical summary, the prefilled note, discard showing what would be lost, save all; axe); e2e-web (edit, save, discard, save all on the three viewports; a save made offline waits and pushes when the network returns; axe). Refinement: tasks/refinements/songs/save_sheet.md"
  }
  task editor_section_after_voicings "Place Add section in the song body, not after the voicings appendix" {
    effort 0.5d
    allocate team
    complete 100
    depends !editor
    note "The editor's Add section button inserts at document end; on a song with a voicings appendix (--- / ## Voicings:) the new section lands after the separator and is silently dropped by canonicalise at save — the user loses the edit without warning. Fix: insert the new section above the first --- that opens the appendix. Source of debt: tasks/refinements/songs/save_sheet.md (songs.save_sheet). Tests: unit (insert above the appendix separator); behavior (Add section in a song with voicings: the section lands in the body and a save round-trips it). Refinement: tasks/refinements/songs/editor_section_after_voicings.md"
  }
  task arrange "Arrange mode and the picker" {
    effort 4d
    allocate team
    complete 100
    depends !reading, cifra_js.editing, music.explorer
    note "Tappable chords, every Cm or only here, choose these for every unchosen chord, enter a shape by hand, variations. Workflow 5. Tests: behavior (tappable chords, every Cm or only here, a shape by hand; a keyboard path through the picker; axe); e2e-web (arrange a song for guitar on the three viewports, keyboard only on the computer, a new variation; axe). Refinement: tasks/refinements/songs/arrange.md"
  }
  task wizard_ui "The wizard in a song" {
    effort 1d
    allocate team
    complete 100
    depends !arrange, music.wizard
    note "Into a new variation first, over this one second. Workflow 5. Tests: behavior (into a new variation first, over this one second; axe); e2e-web (the wizard run in a song and its variation read back; axe). Refinement: tasks/refinements/songs/wizard_ui.md"
  }
  task history "History of a song" {
    effort 3d
    allocate team
    complete 100
    depends storage.history, cifra_js.diff
    note "The list with unsaved changes first, a version read as it was, compare with now, show the text, restore. Workflow 6. Tests: behavior (unsaved changes first, a version read as it was, compare, show the text, restore; axe); e2e-web (a song's history on the three viewports, offline, a version restored and saved; axe). Refinement: tasks/refinements/songs/history.md"
  }
  task restore_part "Restore part of a version" {
    effort 1.5d
    allocate team
    complete 100
    depends !history, cifra_js.editing
    note "Restore a single block of a version into the working copy, not the whole song; chosen from the per-version musical diff. Workflow 6 §Later. Source of debt: tasks/refinements/songs/history.md. Tests: behavior (one block restored, the rest untouched; axe); e2e-web (a block restored and saved on the three viewports; axe). Refinement: tasks/refinements/songs/restore_part.md"
  }
  task edit_in_place "An editor open while sync merges under it" {
    effort 1.5d
    allocate team
    complete 100
    depends !editor, sync.unsaved, books.online
    note "When a sync merges a new version under an open editor's unsaved changes, the editor updates to the merged working text — keeping the edit position — and shows a notice naming what came in (workflow 8 §A song open while it changes L55-56), the editor-view mirror of sync.read_in_place's reading-view update. Source of debt: tasks/refinements/sync/unsaved.md (sync.unsaved). Tests: behavior (the editor shows the merged working text and a notice naming the author, keeping the edit position; Testing Library and axe); e2e-web (a song open in the editor with unsaved changes while a sync from the stack merges a new version under it — put a local book online via books.online, a second device pushing as the same user — on phone, tablet and computer; axe). Refinement: tasks/refinements/songs/edit_in_place.md"
  }
  task save_gate_dropped_section "Block a save that would drop a section after the rule" {
    effort 0.5d
    allocate team
    depends !save_sheet, !editor_section_after_voicings
    complete 100
    note "A hand-typed `---` above a section, or a `## Section` typed below the voicings rule, is reported by the reader (bad-block-heading; spec/7-voicings.md §7.2) but canonicalise drops it silently on save. Add the diagnostic(s) for content below the rule that the writer drops to SAVE_BLOCKERS (app/src/editor/SongEditor.jsx), so the save sheet blocks with the reader's message (move the rule below it) instead of losing the lines. Source: tasks/parking-lot.md 2026-10-14 (Extend the save gate). Tests: unit (which diagnostics block); behavior (a section typed after the rule blocks the save with the message; moving the rule unblocks and the save round-trips it; axe). Refinement: tasks/refinements/songs/save_gate_dropped_section.md"
  }
  task save_empty_message "A save with no musical summary commits instead of hanging" {
    effort 0.5d
    allocate team
    depends !save_sheet, books.file_view
    complete 100
    note "Saving a non-song file (README.md, .gitattributes), an unchanged song, or a song whose note the user cleared sends an empty message — the note is prefilled from the musical diff summary (app/src/songs/save-note.js:20), which is empty there — and isomorphic-git's commit throws (app/src/worker/working-copy.js:168, :236 nameAndSave). The Worker answers a generic ERROR the save sheet does not listen for, so the sheet stays open with no feedback. Reproduced on all three viewports by a raw edit of README.md in the file view and by restoring README.md from history. Fix: a non-empty default message in the Worker save path (e.g. naming the paths), and the save sheet surfaces a command failure instead of staying silently open. Source: tasks/parking-lot.md 2026-10-14 (Non-song/no-change file restore+save). Tests: unit (the default message); behavior (a blank note commits; a failed save shows its error; axe); e2e-web (README.md edited in the file view and saved, the sheet closes, on the three viewports; axe). Refinement: tasks/refinements/songs/save_empty_message.md"
  }
  task reading_chrome "The reading view chrome as drawn" {
    effort 1d
    allocate team
    complete 100
    depends !reading, !edit_in_place
    note "The W01, W02 and W12 boards put the instrument chip, Transpose and a ... menu in the reading header, with the shapes in a bordered SHAPES · <instrument> card; the app puts Edit, History, Add to setlist and Print in the header and the chip and Transpose in the body, and the shapes panel has no card or subtitle. Follow the boards (the menu holds Edit, History, Add to setlist, Print, Share), keeping every action keyboard-reachable. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: behavior (each action reachable from the menu, axe); e2e-web (reading on the three viewports, mockup W01#3, W02#2-4, W12#3). Refinement: tasks/refinements/songs/reading_chrome.md"
  }
  task arrange_polish "Arrange and the wizard as drawn" {
    effort 2d
    allocate team
    complete 100
    depends !arrange, !wizard_ui
    note "Arrange shows a generic instrument word in its mode chip and no instrument chip (workflow 15: the chip in the header everywhere; the locale string Arranging · {instrument} is not filled, app/src/i18n/locales/en.js:1200). Enter a shape is a modal over arrange, where the W05 board draws it inline, and its note list lacks chord-tone roles; its help text differs from the board. On a computer the wizard takes the whole screen where the board sits it beside the arrange chart; its back control reads Other ways where the board says Back. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: behavior (the chip names the instrument; enter a shape inline with chord-tone roles; axe); e2e-web (arrange and the wizard on the three viewports, mockup W05#1-4). Refinement: tasks/refinements/songs/arrange_polish.md"
  }
  task history_phone_actions "A version's actions in reach on a phone" {
    effort 0.5d
    allocate team
    complete 100
    depends !history
    note "On a phone the version view runs past the fold and its Compare with now / Restore this version bar is not visible (workflow 6 A version, Restoring; the W06 board pins it at the bottom). Pin the bar, and keep the title readable. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: behavior (the bar outside the scrolling content); e2e-web (a version on a phone: both actions visible without scrolling, mockup W06#2). Refinement: tasks/refinements/songs/history_phone_actions.md"
  }
  task show_the_file "Show the file from the reading view" {
    effort 1d
    allocate team
    complete 100
    depends !reading, books.file_view
    note "Workflow 14 (14.8 in the e2e coverage audit) opens a song's file in the file view from its reading view; no task built the entry and the UI has none. Source: e2e coverage audit 2026-10-14 (audit/e2e-coverage.md P3). Tests: behavior (the action opens the file view on the song's file, axe); e2e-web (search → song → Show the file → the file view with the file open, three viewports). Refinement: tasks/refinements/songs/show_the_file.md"
  }
  task discard_summary "Discard says what would be lost" {
    effort 0.5d
    allocate team
    complete 100
    depends !save_sheet, !edit_in_place
    note "The discard confirm reads This would be lost: and then lists nothing (W04 tablet), where workflow 4 §Discarding shows the same musical summary as the save sheet (the save sheet for the same edit does list it). Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (the confirm lists the changes from the preview; axe); e2e-web (edit, Discard: the change is listed; mockup W04#3). Refinement: tasks/refinements/songs/discard_summary.md"
  }
  task transpose_chrome "Transposed reading names the key, once" {
    effort 0.5d
    allocate team
    complete 100
    depends !reading, music.transpose
    note "On a computer the transposed state is drawn twice: a Transposed (+1) chip with Back to the written key, and a second row whose Back to the written key overlaps the chart's first line (W02 desktop). The board names the key (Transposed to A (+2), Back to G). One control row, naming the key in the song's notation. Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (one transposed row naming the key); e2e-web (transpose on the three viewports, nothing overlapping the chart; mockup W02#4). Refinement: tasks/refinements/songs/transpose_chrome.md"
  }
  task editor_chrome "The editor host as drawn" {
    effort 2d
    allocate team
    complete 100
    depends !editor, !new_song, !save_sheet
    note "From the W03 and W04 boards: on a phone the editor header truncates the title to a letter and carries Discard changes, where the board has the title and Save; the header keeps Untitled song after the first heading already names the song; the unsaved strip (unsaved changes · Kept on this device) is missing; on a computer the editor is one column without the board's unsaved list and save panel, and the first-save sheet is a bottom sheet where the board centres a dialog; the no-match search state lacks the paste hint (workflow 3 Ways in). Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (the title follows the heading; the unsaved strip; axe); e2e-web (writing and editing on the three viewports, mockup W03#1-4, W04#1-4). Refinement: tasks/refinements/songs/editor_chrome.md"
  }
  task first_save_fields "The first-save dialog names the book and the file" {
    effort 0.5d
    allocate team
    complete 100
    depends !editor_chrome
    note "W03#4 draws Book and a read-only File name (Named once, from the title. Changing the title later edits its heading, not the file.) in the first-save dialog; SAVE_PREVIEW for a new song must carry the filename NAME_AND_SAVE would take (deriveSongFilename with the folder's collision suffix), and the dialog shows it with the book. Source-of-debt: tasks/refinements/songs/editor_chrome.md (Decision 9; workflow 3 The first save; W03 board frame 4). Tests: unit (the Worker's preview filename, with a collision); behavior (the dialog shows Book and File name, the name follows the title); e2e-web (W03#4 with the fields). Refinement: tasks/refinements/songs/first_save_fields.md"
  }
  task song_notation_views "Every view reads a song in its own notation" {
    effort 0.5d
    allocate team
    complete 100
    depends music.voicings_song_dialect, !editor, music.wizard, books.play
    note "SetlistPlay, SongEditor (with editor/cifra-syntax.js) and SongWizard still pass the user's notation preference as cifra-md's dialect override; they take songDialect(model) as SongReading and SongArrange now do (the preference kept for what spells for the user). Source-of-debt: tasks/refinements/music/voicings_song_dialect.md (Decision 6; cifra.md section 5.6). Tests: behavior (SetlistPlay: an american song's C7+ played at a setlist key a tone up shows the sharp-fifth chord transposed; SongWizard: an american song's C7+ is offered the sharp-fifth shapes); unit (cifra-syntax: an american song's ambiguity diagnostics report the american reading under a brazilian preference). Refinement: tasks/refinements/songs/song_notation_views.md"
  }
  task save_feedback "Saving says what it is doing and why it cannot" {
    effort 1.5d
    allocate team
    complete 100
    depends !save_sheet
    note "H2: a blank Your name leaves Save disabled with nothing saying why (app/src/songs/SaveSheet.jsx:125-127, 169-173, 241, 253; a RAC TextField isRequired with no FieldError) — keep Save pressable and on a blank name show an inline error and focus the field; and offer the account name the help text promises (en.js:1081; needsName checks only preferences.authorName, SaveSheet.jsx:104-105). M3: the save waits on the push (worker/working-copy.js:185-200; SAVED posted after it, logic.js:1749-1758) with no pending state, so it takes seconds and Save can be pressed twice — post SAVED once the local commit lands and push in the background, as workflow 4 says (at once with a network, at the next sync without), and show Saving… with Save disabled meanwhile. M5: a blank artist gives the note artist added: ; — cifra.md/js/src/diff.js:136-138 emits an added entry for an empty value; treat empty as absent there (a cifra.md/ subtree change, its own tests). Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: unit (diffProperties with an empty value); behavior (the name error and focus, the pending state, no double save, the account name offered; axe); e2e-web (save with a blank name shows the error; a save with the remote unreachable closes at once and is pushed at the next sync; axe). Refinement: tasks/refinements/songs/save_feedback.md"
  }
  task unsaved_after_discard "Discarding or saving clears the unsaved badge where one returns" {
    effort 0.5d
    allocate team
    complete 100
    depends !save_sheet
    note "L3: an unsaved badge persisted after discarding. Worker commands run concurrently (worker/attach-worker.js:18); DISCARD posts DISCARDED before re-indexing (logic.js:1948 vs 1952-1964) and never posts INDEX_STATUS after, so the screen returned to browses the stale unsaved flag and nothing re-browses; SAVE has the same order (1749 vs 1762-1775). WRITE already posts INDEX_STATUS for exactly this hazard (logic.js:1684-1691) — do the same after DISCARD and SAVE re-index. Recents are never pruned (worker/recents.js), so a discarded draft row lingers: drop recents for paths that no longer exist. Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: unit (recents pruning); behavior (discard then back to search: no badge; save likewise); e2e-web (a draft discarded and the search screen shows no unsaved badge on the three viewports). Refinement: tasks/refinements/songs/unsaved_after_discard.md"
  }
  task no_raw_ids "No raw book ids and no file-name titles in lists" {
    effort 1d
    allocate team
    complete 100
    note "L2: raw ids like local-6467d4de-… appeared in the sidebar, the Books list and the song header meta. Every label resolver falls back to the id when this device shelf entry has no title: titleFor (books/book-display.js:31-33), bookLabelFor (songs/first-run.js:39-45, used by SearchScreen, SongReading.jsx:327, NewSongHost), SongHistory.jsx:258, unsaved-list.js:34. Never show the id: fall back to a localized Untitled book, and backfill a missing shelf.local entry from the README level-1 heading on OPEN; find why the entry was missing (device-namespace mismatch, home book attached without this device entries). L1: rows show the placeholder file name untitled-2 for a song with no title (search-query.js:79-83, SearchScreen.jsx:203,249, unsaved-list.js:53,71), but workflow 3 L37-41 says only the file view shows it: show the localized Untitled song instead. Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: unit (each resolver never returns an id); behavior (a book missing its shelf entry is labelled; an untitled song row; axe); e2e-web (a new untitled song and a book without a shelf label, on the three viewports). Refinement: tasks/refinements/songs/no_raw_ids.md"
  }
  task history_24h "Song history tells the time as the rest of the app does" {
    effort 0.25d
    allocate team
    complete 100
    note "M6: song history showed 16:59 PM. history-view.js:54-63 formats with currentLocale() (bare en) and no hourCycle, while book-display.js:208, BookHistory.jsx:41, people.js:22 and shape-readout.js:105 map en to en-GB (24-hour), so the app shows two clock styles; the PM was not reproduced. Use the same mapping. Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: unit (the history time in each locale, no AM/PM in en). Refinement: tasks/refinements/songs/history_24h.md"
  }
  task render_notes "Notes and verbatim blocks shown in the preview and the reading view" {
    effort 1d
    allocate team
    complete 100
    note "M1, in part: text outside a fence is a notes part (cifra.md/spec/1-document.md:244-246), which the spec says is free text for whoever reads the sheet (:339), and a verbatim fence is shown in a monospaced face (:353-355); but the editor preview renders only Chart (editor/SongEditor.jsx:560) and chart/layout.js:197,209 skips every non-music part, so a song written as bracket chords on plain lines previews blank and reads blank. Render notes and verbatim parts in the preview and the reading view, in document order. Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: behavior (notes and verbatim drawn in order, read by a screen reader; axe); e2e-web (a song with notes and a verbatim block read on the three viewports; axe). Refinement: tasks/refinements/songs/render_notes.md"
  }
  task unknown_tokens_loud "Text that is not a chord is flagged loudly before a save" {
    effort 1d
    allocate team
    complete 100
    depends !save_gate_dropped_section
    note "M2, decided 2026-10-19: saves are canonical (songs.save_gate_dropped_section), so bad syntax must be refused loudly, not discovered later. Typing [Am]Teste [G]linha inside a fence gives a section named Am with unknown tokens Teste and [G]linha and no diagnostic — conformant, since spec/2-chart.md §2.9 says a reader MUST NOT raise a diagnostic for an unknown token, but MUST keep it and SHOULD list the distinct ones. That is the reader; the app may refuse: mark every unknown token in the editor, and make the save sheet list them and require an explicit Save anyway — not an outright block, since §2.9 names annotations the format does not define (fine, rit., (solo)) as legitimate unknown tokens. Also flag a bracket heading whose name parses as a chord symbol ([Am] read as a section) as almost certainly a chord written in another format, pointing to the format help (songs.format_help). Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: unit (which inputs are flagged); behavior (the editor marks, the save sheet lists and asks, a bracket-chord heading flagged; axe); e2e-web (bracket chords typed into a new song are flagged and the save asks first, on the three viewports; axe). Refinement: tasks/refinements/songs/unknown_tokens_loud.md"
  }
  task format_help "The song format explained in the editor" {
    effort 1d
    allocate team
    complete 100
    depends design.format_help, !render_notes
    note "As design.format_help decides: a format help popup reachable from the song editor, in plain words with copyable examples, and the hint from the editor when what was typed looks like another format. Decided 2026-10-19 (the editor has no instructions about the format; usability review M1). Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: behavior (the popup opens from the editor and returns focus, examples insert or copy, the hint on bracket chords; axe); e2e-web (the help opened while writing a new song on the three viewports; axe). Refinement: tasks/refinements/songs/format_help.md"
  }
  task search_book_head_narrow "A book section heading in search fits a phone" {
    effort 0.5d
    allocate team
    complete 100
    depends design.review_polish
    note "M13: on a phone the search screen book section header puts the bordered row, the 44px plus, Save all and the 44px filter side by side (SearchScreen.jsx:308-350; search.css:128-201), crowding the card edge; W02 draws the row alone. As design.review_polish draws it. Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: behavior (the actions reachable at narrow width; axe); e2e-web (a book section with unsaved songs at 390px, nothing clipped; axe, mockup W02). Refinement: tasks/refinements/songs/search_book_head_narrow.md"
  }
  task empty_states "An empty song or section says so and offers Edit" {
    effort 0.5d
    allocate team
    complete 100
    depends design.review_polish, !render_notes
    note "L6: the reading view has no empty state (SongReading.jsx), so a song saved from the template reads as a blank section; only the arrange chart has one (en.js Nothing written yet.). As design.review_polish decides. Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: behavior (an empty song and an empty section, Edit reachable; axe); e2e-web (a song saved untouched reads its empty state on the three viewports; axe). Refinement: tasks/refinements/songs/empty_states.md"
  }
  task menu_grouping "The song menu grouped" {
    effort 0.25d
    allocate team
    complete 100
    depends design.review_polish
    note "L7: the song ⋯ menu is eight flat items (SongReading.jsx:580-587). Its duplicating the toolbar stays as decided (tasks/refinements/songs/reading_chrome.md). Group it with RAC Section and Separator as design.review_polish draws it. Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: behavior (groups named for a screen reader, keyboard order; axe). Refinement: tasks/refinements/songs/menu_grouping.md"
  }
  task trailing_chord_gap "A chord after the last lyric keeps its distance" {
    effort 0.5d
    allocate team
    complete 100
    note "A chord written past the end of its sung line is drawn glued to the last word: mais cheia de graçaCmaj7, in the editor preview and the reading view. The parser keeps the chord column beyond the lyric (cifra.md/js parse: the item has a column past the words), and app/src/chart/layout.js places it with no gap. Keep at least a space between the last word and a chord after it, at every density, in both layouts the chart draws. Source: persona exploration 2026-10-19 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified against screenshots and code). Tests: unit (layout of a chord past the lyric end); behavior (the reading view and the preview draw the gap; axe); e2e-web (that song read on the three viewports). Refinement: tasks/refinements/songs/trailing_chord_gap.md"
  }
  task shape_words "The shape words a teacher understands" {
    effort 0.5d
    allocate team
    complete 100
    depends design.review_polish
    note "Item 6 of design.review_polish: the reading view's shapes caption, its no-voicings notice and the first-open instrument prompt in the words the refinement pins (reading.shapesCaption, reading.noVoicings, reading.instrumentPrompt and its two buttons), in the four locales; the per-diagram marks unchanged. Workflows 1, 2. Source: persona exploration 2026-10-19. Tests: unit (the locales carry every key); behavior (SongReading: the caption with a default and a chosen shape, the notice on a song with no voicings, the prompt and its two answers; axe). Refinement: tasks/refinements/design/review_polish.md. Refinement: tasks/refinements/songs/shape_words.md"
  }
  task editor_split_width "The editor splits text and preview only when wide enough" {
    effort 0.5d
    allocate team
    complete 100
    depends design.review_polish
    note "Item 10 of design.review_polish: the song editor puts text and preview side by side only when its own width is at least 640px, else Text | Preview with Help beside it, whatever the shell's layout. Workflow 3 section The editor. Source: persona exploration 2026-10-19. Tests: behavior (SongEditor: below and above 640px of editor width, the toggle and the split, focus kept on switching; axe); e2e-web (the editor on phone, tablet and computer, and on the phone at 844x390, never side by side under 640px; axe). Refinement: tasks/refinements/design/review_polish.md. Refinement: tasks/refinements/songs/editor_split_width.md"
  }
  task search_scope_follows "Search after a save shows where the song went" {
    effort 1d
    allocate team
    depends !save_sheet, !search, books.row_opens_songs
    note "Design and build in one task. Signed in with Roda de Choro, a teacher made a song in My songs and saved it: Search came back still scoped to Roda de Choro, listing My songs below it with 0 songs (a count within the scope), and only clearing the chip showed 1 song; a first-time teacher, scoped to a new book, read My songs 0 songs beside a song search still finding hers and could not tell which to believe. And a book section expanded in Search collapses whenever she switches tabs and comes back. Decide in workflow 2 (docs/workflows/02-find-and-play.md) and draw on W02: after a save, Search shows the book the song was saved to (the scope follows the save, or clears, never stays on another book); while a scope is set, a book outside it is not listed with a count from inside it (left out, or with its own count, said in words); a book section’s expanded state is kept for the session. Source: persona exploration 2026-10-20 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified live and against the code). Tests: behavior (SearchScreen: the scope after a save to another book, the counts of books outside a scope, the expanded state across a tab switch; axe); e2e-web (scoped to one book, a new song saved to another, Search shows it and no 0 songs for the book it is in, on the three viewports; axe, mockup W02)."
  }
  task editor_errors_in_words "A line the editor marks red says why" {
    effort 1d
    allocate team
    depends !unknown_tokens_loud, !format_help
    note "Design and build in one task. A teacher overwrote the new-song template and lost its chord fence; his bar line | Am7 | D7 | Gm7 | C7 | turned red with nothing saying why, and only Help told him about the fence. The red is a reader diagnostic drawn as a line colour alone (editor/cifra-syntax.js:73, the est-err class, editor.css:158) — status by colour, against DIRECTION’s accessibility rule. Decide in workflow 4 §Editing (docs/workflows/04-edit-and-save.md) and draw on the editor board: a marked line says in words what is wrong where the person is looking (beside the line or as the cursor reaches it, and to a screen reader), and a chord or bar line outside a chord block offers to put it in one, as pasting already does (with an Undo). Source: persona exploration 2026-10-20 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified live and against the code). Tests: behavior (SongEditor: a diagnostic line carries its message in words and to assistive technology, the offer wraps a bar line outside a fence and Undo reverts it; axe); e2e-web (the template overwritten with a bare bar line, the message read and the offer taken, on the three viewports; axe)."
  }
}
