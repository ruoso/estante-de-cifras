# 60 — Songs
#
# Finding, reading, writing, editing, arranging and the history of a song.

task songs "Songs" {
  depends shell.layout, shell.chart, foundation.e2e_web

  task search "Search" {
    effort 3d
    allocate team
    complete 100
    depends storage.index
    note "One box across every book; recents (kept on the device); books as sections; the explorer as a result when the text is a chord; badges; scope that resets each session. Workflow 2. Tests: unit (the query: a chord recognised, scope); behavior (results by book, recents, badges, scope reset, Testing Library and axe); e2e-web (search across books on the three viewports, a chord offering the explorer, search after an offline reload; axe). Refinement: tasks/refinements/songs/search.md"
  }
  task reading "Reading a song" {
    effort 3d
    allocate team
    complete 100
    depends music.fallback, music.transpose
    note "The chart and the shapes, variation picker, full screen, print, add to setlist, share; updated in place by sync. Workflows 2, 8. Tests: behavior (variation picker, full screen, print styles, add to setlist, share; Testing Library and axe); e2e-web (open and read a song on the three viewports, transpose and reopen, updated in place by a sync from the stack; offline: after a reload with the network cut, the song, its shapes and the explorer; axe). Refinement: tasks/refinements/songs/reading.md"
  }
  task first_song "Playing on guitar — change?" {
    effort 0.5d
    allocate team
    complete 100
    depends !reading, music.instruments
    note "The one-time prompt the first time a song is opened. Workflow 1. Tests: behavior (the prompt once, axe); e2e-web (the first song opened asks, the second does not). Refinement: tasks/refinements/songs/first_song.md"
  }
  task editor "The source editor" {
    effort 4d
    allocate team
    complete 100
    depends storage.working_copy
    note "CodeMirror 6 on the cifra.md text: syntax colour, the template, add section, preview beside or a tap away, pasting a cifra into a fence with undo, a voicing line it cannot read stopping the save. Workflows 3, 4. Tests: unit (syntax colouring, paste into a fence); behavior (CodeMirror with Testing Library: the template, add section, paste with undo, an unreadable voicing line stopping the save; axe); e2e-web (editing a song by keyboard and touch on the three viewports; axe). Refinement: tasks/refinements/songs/editor.md"
  }
  task new_song "Writing a new song" {
    effort 2d
    allocate team
    complete 100
    depends !editor, !search, books.shelf, account.first_run
    note "From search, the empty shelf, a book, the file view; which book; named once at the first save; My songs created when first written to. Workflow 3. Tests: unit (deriveSongFilename); behavior (which book, the name at first save, My songs created; axe); e2e-web (write a new song from search, the empty shelf, a book and the file view, offline; axe). Refinement: tasks/refinements/songs/new_song.md"
  }
  task save_sheet "Save, discard, and the save sheet" {
    effort 2d
    allocate team
    complete 100
    depends !editor, cifra_js.diff
    note "What changed in musical terms, a note prefilled from it, save pushes; discard showing what would be lost; save all; the first save asking for a name. Workflow 4. Tests: unit (renderChange, buildSaveNote); behavior (the sheet's musical summary, the prefilled note, discard showing what would be lost, save all; axe); e2e-web (edit, save, discard, save all on the three viewports; a save made offline waits and pushes when the network returns; axe). Refinement: tasks/refinements/songs/save_sheet.md"
  }
  task editor_section_after_voicings "Place Add section in the song body, not after the voicings appendix" {
    effort 0.5d
    allocate team
    complete 100
    depends !editor
    note "The editor's Add section button inserts at document end; on a song with a voicings appendix (--- / ## Voicings:) the new section lands after the separator and is silently dropped by canonicalise at save — the user loses the edit without warning. Fix: insert the new section above the first --- that opens the appendix. Source of debt: tasks/refinements/songs/save_sheet.md (songs.save_sheet). Tests: unit (insert above the appendix separator); behavior (Add section in a song with voicings: the section lands in the body and a save round-trips it). Refinement: tasks/refinements/songs/editor_section_after_voicings.md"
  }
  task arrange "Arrange mode and the picker" {
    effort 4d
    allocate team
    complete 100
    depends !reading, cifra_js.editing, music.explorer
    note "Tappable chords, every Cm or only here, choose these for every unchosen chord, enter a shape by hand, variations. Workflow 5. Tests: behavior (tappable chords, every Cm or only here, a shape by hand; a keyboard path through the picker; axe); e2e-web (arrange a song for guitar on the three viewports, keyboard only on the computer, a new variation; axe). Refinement: tasks/refinements/songs/arrange.md"
  }
  task wizard_ui "The wizard in a song" {
    effort 1d
    allocate team
    complete 100
    depends !arrange, music.wizard
    note "Into a new variation first, over this one second. Workflow 5. Tests: behavior (into a new variation first, over this one second; axe); e2e-web (the wizard run in a song and its variation read back; axe). Refinement: tasks/refinements/songs/wizard_ui.md"
  }
  task history "History of a song" {
    effort 3d
    allocate team
    complete 100
    depends storage.history, cifra_js.diff
    note "The list with unsaved changes first, a version read as it was, compare with now, show the text, restore. Workflow 6. Tests: behavior (unsaved changes first, a version read as it was, compare, show the text, restore; axe); e2e-web (a song's history on the three viewports, offline, a version restored and saved; axe). Refinement: tasks/refinements/songs/history.md"
  }
  task restore_part "Restore part of a version" {
    effort 1.5d
    allocate team
    complete 100
    depends !history, cifra_js.editing
    note "Restore a single block of a version into the working copy, not the whole song; chosen from the per-version musical diff. Workflow 6 §Later. Source of debt: tasks/refinements/songs/history.md. Tests: behavior (one block restored, the rest untouched; axe); e2e-web (a block restored and saved on the three viewports; axe). Refinement: tasks/refinements/songs/restore_part.md"
  }
  task edit_in_place "An editor open while sync merges under it" {
    effort 1.5d
    allocate team
    complete 100
    depends !editor, sync.unsaved, books.online
    note "When a sync merges a new version under an open editor's unsaved changes, the editor updates to the merged working text — keeping the edit position — and shows a notice naming what came in (workflow 8 §A song open while it changes L55-56), the editor-view mirror of sync.read_in_place's reading-view update. Source of debt: tasks/refinements/sync/unsaved.md (sync.unsaved). Tests: behavior (the editor shows the merged working text and a notice naming the author, keeping the edit position; Testing Library and axe); e2e-web (a song open in the editor with unsaved changes while a sync from the stack merges a new version under it — put a local book online via books.online, a second device pushing as the same user — on phone, tablet and computer; axe). Refinement: tasks/refinements/songs/edit_in_place.md"
  }
  task save_gate_dropped_section "Block a save that would drop a section after the rule" {
    effort 0.5d
    allocate team
    depends !save_sheet, !editor_section_after_voicings
    complete 100
    note "A hand-typed `---` above a section, or a `## Section` typed below the voicings rule, is reported by the reader (bad-block-heading; spec/7-voicings.md §7.2) but canonicalise drops it silently on save. Add the diagnostic(s) for content below the rule that the writer drops to SAVE_BLOCKERS (app/src/editor/SongEditor.jsx), so the save sheet blocks with the reader's message (move the rule below it) instead of losing the lines. Source: tasks/parking-lot.md 2026-10-14 (Extend the save gate). Tests: unit (which diagnostics block); behavior (a section typed after the rule blocks the save with the message; moving the rule unblocks and the save round-trips it; axe). Refinement: tasks/refinements/songs/save_gate_dropped_section.md"
  }
  task save_empty_message "A save with no musical summary commits instead of hanging" {
    effort 0.5d
    allocate team
    depends !save_sheet, books.file_view
    complete 100
    note "Saving a non-song file (README.md, .gitattributes), an unchanged song, or a song whose note the user cleared sends an empty message — the note is prefilled from the musical diff summary (app/src/songs/save-note.js:20), which is empty there — and isomorphic-git's commit throws (app/src/worker/working-copy.js:168, :236 nameAndSave). The Worker answers a generic ERROR the save sheet does not listen for, so the sheet stays open with no feedback. Reproduced on all three viewports by a raw edit of README.md in the file view and by restoring README.md from history. Fix: a non-empty default message in the Worker save path (e.g. naming the paths), and the save sheet surfaces a command failure instead of staying silently open. Source: tasks/parking-lot.md 2026-10-14 (Non-song/no-change file restore+save). Tests: unit (the default message); behavior (a blank note commits; a failed save shows its error; axe); e2e-web (README.md edited in the file view and saved, the sheet closes, on the three viewports; axe). Refinement: tasks/refinements/songs/save_empty_message.md"
  }
  task reading_chrome "The reading view chrome as drawn" {
    effort 1d
    allocate team
    complete 100
    depends !reading, !edit_in_place
    note "The W01, W02 and W12 boards put the instrument chip, Transpose and a ... menu in the reading header, with the shapes in a bordered SHAPES · <instrument> card; the app puts Edit, History, Add to setlist and Print in the header and the chip and Transpose in the body, and the shapes panel has no card or subtitle. Follow the boards (the menu holds Edit, History, Add to setlist, Print, Share), keeping every action keyboard-reachable. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: behavior (each action reachable from the menu, axe); e2e-web (reading on the three viewports, mockup W01#3, W02#2-4, W12#3). Refinement: tasks/refinements/songs/reading_chrome.md"
  }
  task arrange_polish "Arrange and the wizard as drawn" {
    effort 2d
    allocate team
    depends !arrange, !wizard_ui
    note "Arrange shows a generic instrument word in its mode chip and no instrument chip (workflow 15: the chip in the header everywhere; the locale string Arranging · {instrument} is not filled, app/src/i18n/locales/en.js:1200). Enter a shape is a modal over arrange, where the W05 board draws it inline, and its note list lacks chord-tone roles; its help text differs from the board. On a computer the wizard takes the whole screen where the board sits it beside the arrange chart; its back control reads Other ways where the board says Back. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: behavior (the chip names the instrument; enter a shape inline with chord-tone roles; axe); e2e-web (arrange and the wizard on the three viewports, mockup W05#1-4)."
  }
  task history_phone_actions "A version's actions in reach on a phone" {
    effort 0.5d
    allocate team
    depends !history
    note "On a phone the version view runs past the fold and its Compare with now / Restore this version bar is not visible (workflow 6 A version, Restoring; the W06 board pins it at the bottom). Pin the bar, and keep the title readable. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: behavior (the bar outside the scrolling content); e2e-web (a version on a phone: both actions visible without scrolling, mockup W06#2)."
  }
  task show_the_file "Show the file from the reading view" {
    effort 1d
    allocate team
    depends !reading, books.file_view
    note "Workflow 14 (14.8 in the e2e coverage audit) opens a song's file in the file view from its reading view; no task built the entry and the UI has none. Source: e2e coverage audit 2026-10-14 (audit/e2e-coverage.md P3). Tests: behavior (the action opens the file view on the song's file, axe); e2e-web (search → song → Show the file → the file view with the file open, three viewports)."
  }
  task discard_summary "Discard says what would be lost" {
    effort 0.5d
    allocate team
    depends !save_sheet, !edit_in_place
    note "The discard confirm reads This would be lost: and then lists nothing (W04 tablet), where workflow 4 §Discarding shows the same musical summary as the save sheet (the save sheet for the same edit does list it). Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (the confirm lists the changes from the preview; axe); e2e-web (edit, Discard: the change is listed; mockup W04#3)."
  }
  task transpose_chrome "Transposed reading names the key, once" {
    effort 0.5d
    allocate team
    depends !reading, music.transpose
    note "On a computer the transposed state is drawn twice: a Transposed (+1) chip with Back to the written key, and a second row whose Back to the written key overlaps the chart's first line (W02 desktop). The board names the key (Transposed to A (+2), Back to G). One control row, naming the key in the song's notation. Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (one transposed row naming the key); e2e-web (transpose on the three viewports, nothing overlapping the chart; mockup W02#4)."
  }
  task editor_chrome "The editor host as drawn" {
    effort 2d
    allocate team
    depends !editor, !new_song, !save_sheet
    note "From the W03 and W04 boards: on a phone the editor header truncates the title to a letter and carries Discard changes, where the board has the title and Save; the header keeps Untitled song after the first heading already names the song; the unsaved strip (unsaved changes · Kept on this device) is missing; on a computer the editor is one column without the board's unsaved list and save panel, and the first-save sheet is a bottom sheet where the board centres a dialog; the no-match search state lacks the paste hint (workflow 3 Ways in). Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (the title follows the heading; the unsaved strip; axe); e2e-web (writing and editing on the three viewports, mockup W03#1-4, W04#1-4)."
  }
}
