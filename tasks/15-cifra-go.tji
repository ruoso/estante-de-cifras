# 15 — cifra.md for Go (cifra.md/go/)
#
# The hook's implementation of the format, and git-merge-cifra for computers.
# A second, independent implementation, held to the same corpus.

task cifra_go "cifra.md for Go" {
  depends format.canonical_form

  task module "Module and corpus harness" {
    effort 1d
    allocate team
    complete 100
    note "cifra.md: go/ module, a test harness over every corpus entry. Tests: unit (go test: the harness finds every corpus entry and fails on a planted mismatch); corpus (every entry enumerated, the checks that need the reader wired as expected failures by name, flipped as they pass). Refinement: tasks/refinements/cifra_go/module.md"
  }
  task reader "Reader" {
    effort 8d
    allocate team
    complete 100
    depends !module
    note "cifra.md: text layer, chord symbols, chart, sung lines with layout convergence, tunings, voicings. Tests: unit (text layer, chord symbols, chart, sung lines with convergence, tunings, voicings, diagnostics); corpus (input to model for every entry). Refinement: tasks/refinements/cifra_go/reader.md"
  }
  task writer "Canonical writer and check" {
    effort 4d
    allocate team
    complete 100
    depends !reader
    note "cifra.md: §8 serializer, invariants, `is canonical` as the hook needs it, marker lines. Tests: unit (the invariants; `is canonical` true and false on corpus texts and their non-canonical inputs; marker lines refused); corpus (canonical text byte for byte, every entry). Refinement: tasks/refinements/cifra_go/writer.md"
  }
  task setlists "Setlists" {
    effort 2d
    allocate team
    complete 100
    depends !module, format.setlist_corpus
    note "cifra.md: chapter 10 reader and canonical writer. Tests: unit (chapter 10 reader and writer); corpus (the setlist entries). Refinement: tasks/refinements/cifra_go/setlists.md"
  }
  task versions "Two canonical-form versions side by side" {
    effort 1d
    allocate team
    complete 100
    depends !writer, !setlists
    note "The hook accepts the current and the previous form for a while; the module exposes both. DIRECTION §3.6 Versions, workflow 14. Tests: unit (a text canonical only under the previous form passes the previous check and fails the current one, and the reverse; the module reports which form a text is in). Refinement: tasks/refinements/cifra_go/versions.md"
  }
  task merge "Merge, and git-merge-cifra" {
    effort 8d
    allocate team
    complete 100
    depends !writer, !setlists, format.merge
    note "cifra.md: chapter 11, and the git merge driver as one static binary (§11.14). Not needed by the hook; for a clone on a computer. Tests: unit (chapter 11 section by section); corpus (every corpus/merge/ entry); behavior (git-merge-cifra configured as a merge driver in a throwaway repository, merging two branches through the git CLI, clean and conflicted). Refinement: tasks/refinements/cifra_go/merge.md"
  }
  task conformance "Conformance" {
    effort 2d
    allocate team
    complete 100
    depends !writer, !setlists
    note "cifra.md: every canonical-corpus entry passes byte for byte. Tests: corpus (TestCanonicalCorpusHasNoExpectedFailure — reading-entry ids must not appear in the ledger; TestCorpusConformance — every reading check passes byte for byte; TestLedgerNamesNoCheckThatDoesNotExist — merge ids stay honest). Refinement: tasks/refinements/cifra_go/conformance.md"
  }
}
