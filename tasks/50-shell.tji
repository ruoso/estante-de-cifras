# 50 — The app's shell and visual language
#
# Navigation across phone, tablet and computer, the themes, languages, and the
# two drawings everything else uses: the chart and the chord diagram.

task shell "Shell" {
  depends foundation.app_tooling, foundation.e2e_web

  task tokens "Themes and tokens" {
    effort 2d
    allocate team
    complete 100
    note "docs/mockups/theme.css as the app's stylesheet: Estante, Caderno, Palco, densities; automatic theme by the device's light or dark mode; the chosen theme from the home book. Workflow 1. Tests: unit (the theme chosen by the device's mode and by the home book); behavior (each theme and density rendered on a sample surface, axe contrast at AA); e2e-web (the shell in Estante light and Palco dark on the three viewports, axe). Refinement: tasks/refinements/shell/tokens.md"
  }
  task layout "Navigation and layouts" {
    effort 3d
    allocate team
    complete 100
    depends !tokens
    note "Phone tab bar (Search, Books, Setlists), tablet and computer splits; React Aria for every interactive part. Tests: behavior (tab bar and splits with Testing Library; keyboard navigation; axe); e2e-web (Search, Books and Setlists reached on phone, tablet and computer, axe on each). Refinement: tasks/refinements/shell/layout.md"
  }
  task i18n "Languages" {
    effort 2d
    allocate team
    complete 100
    depends !layout
    note "English, Brazilian Portuguese, Latin American Spanish, Italian; the browser's until one is chosen; carried over from Explore Chords. Tests: unit (every catalogue complete in the four languages); behavior (switching language re-renders and sets lang); e2e-web (the browser's language chosen on a first load; axe in each language's layout). Refinement: tasks/refinements/shell/i18n.md"
  }
  task chart "The chart" {
    effort 4d
    allocate team
    complete 100
    depends !tokens, cifra_js.reader
    note "Proportional: sung lines as chords stacked over the syllables they belong to, a centred hyphen where a chord opens room in a word, measures between bar rules, sections; marking for defaults, conflicts, arrange mode. docs/mockups/README.md. Tests: unit (sung-line layout: chords over syllables, the centred hyphen, measures between bar rules, sections); behavior (corpus songs rendered with Testing Library, defaults, conflicts and arrange-mode marking, axe); e2e-web (a chart on the three viewports without horizontal overflow, axe). Refinement: tasks/refinements/shell/chart.md"
  }
  task diagram "The chord diagram" {
    effort 1d
    allocate team
    complete 100
    depends !tokens, foundation.music_core_import
    note "Song's shape in ink, my shape in the chord colour, default hollow; the starting fret as a plain number right-aligned beside the first fret. docs/mockups/ChordBox.dc.html. Tests: unit (the starting fret, the marks for the song's shape, my shape and the default); behavior (rendered with an accessible name, axe). Refinement: tasks/refinements/shell/diagram.md"
  }
  task pwa "Installable and offline" {
    effort 2d
    allocate team
    complete 100
    depends !layout, storage.migrations
    note "Manifest, icons, the service worker precaching everything, the update taken on the next launch. Tests: behavior (the manifest and icons; an update held until the next launch); e2e-web (offline: loaded on the stack, the network cut, reloaded — the app opens from the precache; an update taken on the next launch). Refinement: tasks/refinements/shell/pwa.md"
  }
  task a11y_chart "A sung line for a screen reader" {
    effort 1d
    allocate team
    complete 100
    depends !chart, design.screen_reader
    note "The decided reading order, implemented and checked. Tests: unit (the reading-order text of a sung line, a chart, a diagram and a conflict); behavior (accessible names as design.screen_reader decided, Testing Library and axe); e2e-web (a chart read through the accessibility tree and by keyboard on the three viewports). Refinement: tasks/refinements/shell/a11y_chart.md"
  }
  task portal_provider "Portal-scope provider at ThemeRoot" {
    effort 0.5d
    allocate team
    complete 100
    depends !layout, books.shelf
    note "React Aria Components portals overlays to document.body by default, outside ThemeRoot's .est element where all design tokens live. Add react-aria as a direct dependency and wrap ThemeRoot with UNSTABLE_PortalProvider so every future overlay inherits the token scope without per-screen UNSTABLE_portalContainer workarounds. Discovered in books.shelf fixer-2 (tasks/refinements/books/shelf.md). Tests: behavior (a RAC overlay rendered through the portal inherits design tokens, axe); e2e-web (the rename dialog and any sheet on the three viewports shows correct tokens and passes axe). Refinement: tasks/refinements/shell/portal_provider.md"
  }
  task routing "The URL follows where you are" {
    effort 2d
    allocate team
    depends !layout, books.add_by_link
    note "Sync the active destination and deep screens (a book, a song, a setlist) to the URL so browser and Android back work and a place can be bookmarked or reloaded; book invitation links (books.add_by_link) keep working through it. Opening a URL for something not on this device lands on a clear not-here state, never a crash. Source: tasks/parking-lot.md 2026-10-14 (Shell URL / deep-link routing). Tests: unit (URL ↔ location both ways); behavior (navigating updates the URL, back returns, a deep URL opens its screen; axe); e2e-web (a song opened, reloaded and still open; back from a song to its book on the three viewports; axe)."
  }
  task fonts "Self-host the designed typefaces" {
    effort 1d
    allocate team
    depends !tokens, !pwa
    note "Commit woff2 subsets of Figtree, Fraunces, Source Sans 3, JetBrains Mono, IBM Plex Mono and Atkinson Hyperlegible (+ Mono) with each family's license file beside it (SIL OFL 1.1; confirm each — Atkinson Hyperlegible's original release has its own Braille Institute license — and stop if any forbids redistribution); @font-face in theme.css with the current system stacks as fallbacks and font-display: swap; the PWA precache extended so the fonts work offline. Source: tasks/parking-lot.md 2026-10-14 (Font licensing). Tests: behavior (the theme resolves each family to its @font-face); e2e-web (fonts load from the origin and, offline after a reload, from the precache; axe)."
  }
  task display_preferences "Density and chord-diagram display" {
    effort 2d
    allocate team
    depends !tokens, !diagram, design.display_preferences, storage.preferences_surface, account.account_screen
    note "As design.display_preferences decides: density and the diagram's left-handed mirror and horizontal neck as home-book preferences, chosen on the account screen, applied by ThemeRoot (density class) and ChordBox (mirror, orientation) in the explorer and the picker. Source: tasks/parking-lot.md 2026-10-14. Tests: unit (ChordBox geometry mirrored and rotated; preference defaults); behavior (choosing each re-renders; axe in each density and orientation); e2e-web (a preference chosen, kept across a reload, on the three viewports; axe)."
  }
  task full_height "Full-screen surfaces scroll inside, not the page" {
    effort 1d
    allocate team
    complete 100
    depends !layout
    note "The themed root .est has min-height: 100dvh (app/src/shell/shell.css:23), an indefinite height, so the height: 100% / flex: 1; min-height: 0 chains beneath it resolve to auto and inner scrollers grow with their content — the page scrolls instead. A phone-viewport probe found it on the shell's search, books and setlists tabs, the account screen, arrange, the wizard, song history, the file view (tree, history, open file), the new-song editor, the chord explorer and the upload preview; only reading and the setlist view cap themselves (reading.css:19, setlist.css:23). Cap at the shell (height or max-height 100dvh), give the surfaces that rely on the theme's bare .scroll (overflow: hidden, theme.css:130 — file-view tree and history, song history) an overflow-y: auto scroller, and re-check the tab screens and the upload preview. Source: tasks/parking-lot.md 2026-10-14 (Shell .est min-height). Tests: e2e-web (on each listed surface a long content scrolls its own container and the document does not overflow, on the three viewports; axe). Refinement: tasks/refinements/shell/full_height.md"
  }
  task dev_mount_open "Every app mount brings the Worker up" {
    effort 0.5d
    allocate team
    complete 100
    depends !layout
    note "The Worker's OPEN command — which surfaces preferences, theme and instruments — is sent only from AppShell's mount effect (app/src/shell/AppShell.jsx:403-405). A cold boot or reload straight into a #dev/* mount (App.jsx ~176-192) never mounts AppShell, so preferences stay empty and, e.g., the save sheet asks 'Your name' again although authorName is durably in the home book. Users always boot through AppShell, and e2e specs may not use dev mounts (e2e/web/eslint.config.js), so it bites only a developer on a dev route — where it looks like a durability failure of the name. Move the open effect up into App (ensureOpen is memoised, the store a singleton). Source: tasks/parking-lot.md 2026-10-14 (SET_IDENTITY_NAME author-name durability). Tests: behavior (App mounting a dev route sends OPEN once); e2e-web (name set, the app reloaded, Save does not ask for the name — the durability the parking-lot entry asked about, through the real UI). Refinement: tasks/refinements/shell/dev_mount_open.md"
  }
  task header_chrome "The header as drawn: wordmark and a short instrument chip" {
    effort 1d
    allocate team
    depends !layout, music.instruments
    note "The instrument chip shows the full tuning (Guitar (6-string) · E2 A2 D3 G3 B3 E4) and is clipped by the account button on a phone; the boards and workflow 1 (The instrument) draw a short chip (Guitar), and its copy varies between screens (W16). The phone shelf is titled Search where the boards put the Estante wordmark, and the computer search rail lacks the wordmark and the chip (W02 desktop). One chip label everywhere, the full tuning as its accessible description. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: unit (the chip label for each instrument); behavior (the chip and wordmark on each destination, axe); e2e-web (the header on the three viewports with no clipping, mockup W01#1, W02#1, W02#4)."
  }
  task narrow_fit "Nothing clipped, overflowing or wrapped word by word at phone and tablet widths" {
    effort 2d
    allocate team
    depends !layout
    note "Fit defects the UI audit found: the search field breaks onto two lines (typed text, then the clear control) on phone and computer (W01, W02); the reading view notice wraps one word per line on a phone (W02); two first-run row descriptions end in an ellipsis (W01); the explorer title truncates and the chip clips at tablet width (W16); the raw editor toolbar overflows with Save clipped on a phone (W14); the version view title truncates (W06); the reading toolbar clips Print on a tablet (W12); the raw Markdown pane clips long lines with no horizontal scroll (W12). Fix each at its component, and add an e2e check that no visible control overflows the viewport on each surface. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: e2e-web (each listed surface on the three viewports: no element wider than the viewport, controls fully visible; axe). Also (pairwise audit): the Leaving Estante region overflows the right edge on a phone (W17)."
  }
  task palco_contrast "Palco everywhere: no light rows, every label readable" {
    effort 1d
    allocate team
    depends !tokens
    note "In Palco the file view tree rows, its history cards, the Add to setlist list and the setlist point-at results keep a light fill with light text, so titles are near invisible (W14, W12; the amber New setlist row is low contrast on it). Those components set a surface colour outside the theme tokens. The e2e axe checks run in the automatic theme on a light device, i.e. Estante only, which is why none caught it: make the axe fixture also check under Palco (emulateMedia dark) on every screen it visits. Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (the listed rows take the theme surface; axe in Palco); e2e-web (axe under both themes on every visited screen, three viewports)."
  }
}
