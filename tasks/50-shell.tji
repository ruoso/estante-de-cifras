# 50 — The app's shell and visual language
#
# Navigation across phone, tablet and computer, the themes, languages, and the
# two drawings everything else uses: the chart and the chord diagram.

task shell "Shell" {
  depends foundation.app_tooling

  task tokens "Themes and tokens" {
    effort 2d
    allocate team
    note "docs/mockups/theme.css as the app's stylesheet: Estante, Caderno, Palco, densities; automatic theme by the device's light or dark mode; the chosen theme from the home book. Workflow 1."
  }
  task layout "Navigation and layouts" {
    effort 3d
    allocate team
    depends !tokens
    note "Phone tab bar (Search, Books, Setlists), tablet and computer splits; React Aria for every interactive part."
  }
  task i18n "Languages" {
    effort 2d
    allocate team
    depends !layout
    note "English, Brazilian Portuguese, Latin American Spanish, Italian; the browser's until one is chosen; carried over from Explore Chords."
  }
  task chart "The chart" {
    effort 4d
    allocate team
    depends !tokens, cifra_js.reader
    note "Proportional: sung lines as chords stacked over the syllables they belong to, a centred hyphen where a chord opens room in a word, measures between bar rules, sections; marking for defaults, conflicts, arrange mode. docs/mockups/README.md."
  }
  task diagram "The chord diagram" {
    effort 1d
    allocate team
    depends !tokens, foundation.music_core_import
    note "Song's shape in ink, my shape in the chord colour, default hollow; the starting fret as a plain number right-aligned beside the first fret. docs/mockups/ChordBox.dc.html."
  }
  task pwa "Installable and offline" {
    effort 2d
    allocate team
    depends !layout, storage.migrations
    note "Manifest, icons, the service worker precaching everything, the update taken on the next launch."
  }
  task a11y_chart "A sung line for a screen reader" {
    effort 1d
    allocate team
    depends !chart, design.screen_reader
    note "The decided reading order, implemented and checked."
  }
}
