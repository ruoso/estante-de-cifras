# 55 — Music
#
# Instruments, the explorer, shapes and their fallbacks, transposition, the
# wizard — the music core from Explore Chords put to work.

task music "Music" {
  depends foundation.music_core_import

  task instruments "Instruments and voicing rules" {
    effort 4d
    allocate team
    complete 100
    depends design.instruments, storage.home_book, shell.layout, foundation.e2e_web
    note "Workflow 15 built: tunings, instruments in the home book, the header chip, presets and the expert panel. Tests: unit (voicing-rule presets and the expert panel's rules); behavior (the instrument screens with Testing Library and axe, stored in the home book); e2e-web (workflow 15 on the three viewports: a tuning, a second instrument, switching from the header chip; axe). Refinement: tasks/refinements/music/instruments.md"
  }
  task explorer "The chord explorer" {
    effort 3d
    allocate team
    complete 100
    depends design.explorer, shell.diagram, !instruments, foundation.e2e_web, songs.search
    note "Workflow 16 built: search's chord row opens it; fingerings ranked, grouped by position; starring a shape as my shape. Tests: unit (ranking and grouping by position); behavior (the explorer with Testing Library and axe, a keyboard path through fingerings, starring); e2e-web (search's chord row opens it, a shape starred as my shape, used offline too; axe). Refinement: tasks/refinements/music/explorer.md"
  }
  task explorer_standard_shapes "Star a shape on the standard-guitar fallback" {
    effort 1d
    allocate team
    complete 100
    depends !explorer, !instruments
    note "Starring a shape when the in-use instrument is the synthesized standard-guitar fallback (id: null) cannot persist because shapes.json is keyed by instrument id (home-book §4.4) and standardEntry.shapes is always empty. Materialize the standard as a real instrument with a reserved shapes id on first star, so the write path works identically to any named instrument. Source-of-debt: tasks/refinements/music/explorer.md (tech-debt note), home-book-format.md §4.4. Tests: behavior (star a shape on the standard fallback, confirm the leaf persists in shapes.json and is read back by the explorer). Refinement: tasks/refinements/music/explorer_standard_shapes.md"
  }
  task fallback "Where a chord's shape comes from" {
    effort 1d
    allocate team
    complete 100
    depends !instruments, cifra_js.reader
    note "The song's choice, then my shape, then the app's default; each marked for what it is. Workflow 2. Tests: unit (the song's choice, then my shape, then the default, each marked for what it is). Refinement: tasks/refinements/music/fallback.md"
  }
  task transpose "Transposing for reading" {
    effort 2d
    allocate team
    complete 100
    depends !fallback, shell.chart
    note "View only, never the song; no chosen shapes while transposed; spelling by the key property or fewest accidentals; remembered per song in the home book. Workflow 2. Tests: unit (spelling by the key property or fewest accidentals; no chosen shapes while transposed; remembered per song); behavior (a transposed chart rendered, the song untouched). The reading journey is songs.reading's. Refinement: tasks/refinements/music/transpose.md"
  }
  task wizard "The voicing wizard" {
    effort 2d
    allocate team
    complete 100
    depends !fallback, cifra_js.editing
    note "Explore Chords' planners; the plan into a new variation first. Workflow 5. Tests: unit (Explore Chords' planners' tests carried over; the plan written into a new variation, canonical). Refinement: tasks/refinements/music/wizard.md"
  }
  task explorer_flip_copy "The explorer reads an augmented fifth as the workflow writes it" {
    effort 0.5d
    allocate team
    complete 100
    depends !explorer
    note "Workflow 16 (Viewing by notation) offers to read C7+ as C7#5; the app asks Read as C7(5+) instead?. Use the notation the workflow names for the flip, in every language. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: unit (the flip label for C7+ and its siblings); e2e-web (the explorer on C7+, mockup W16#3). Also (pairwise audit): the difficulty words read Easy/Medium/Hard where the W16 board writes them lowercase. Refinement: tasks/refinements/music/explorer_flip_copy.md"
  }
  task fourth_with_seventh_spelling "A fourth on a seventh is spelled in each dialect's own notation" {
    effort 0.5d
    allocate team
    complete 100
    depends !explorer_flip_copy
    note "Source: music.explorer_flip_copy (tasks/refinements/music/explorer_flip_copy.md); workflow 16 (Viewing by notation). The Brazilian and Real Book formatters write a fourth on a seventh as C47/Csus47; spell them in each dialect's own notation. Tests: unit (the Brazilian and Real Book formatters on C7 with a fourth, round-tripped through parseChord). Refinement: tasks/refinements/music/fourth_with_seventh_spelling.md"
  }
  task voicings_song_dialect "A song's chords are voiced in the song's own notation" {
    effort 0.5d
    allocate team
    complete 100
    depends !fourth_with_seventh_spelling
    note "resolveSongVoicings (app/src/core/voicings.js) parses every chart symbol in the default (Brazilian) dialect, not the song's notation property (cifra.md section 5.6), so an american or realbook song that writes C7(4) is voiced as a C7sus4 and a C7+ as a major seventh. Thread the song's dialect (the one transpose is given) into resolveSongVoicings and unvoiceableKeys. Source-of-debt: tasks/refinements/music/fourth_with_seventh_spelling.md. Tests: unit (voicings.test.js: an american song's C7(4) and C7+ resolve the added-fourth and sharp-fifth default voicings; a brazilian one the suspension and the major seventh; my shape still matched by chord across dialects). Refinement: tasks/refinements/music/voicings_song_dialect.md"
  }
  task instruments_roster_default "The roster lists the instrument in use from the first run" {
    effort 0.5d
    allocate team
    complete 100
    depends !instruments
    note "On a fresh device the Instruments roster shows only Add instrument, while the header chip already says Guitar: the built-in standard guitar the app plays by default is not listed or marked in use (workflow 15; W15 phone). Also the remove confirm says Its 0 saved shapes when there are none. Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: unit (the roster with no stored instrument lists the default, in use); behavior (axe); e2e-web (first run → Instruments lists Guitar in use; mockup W15#1). Refinement: tasks/refinements/music/instruments_roster_default.md"
  }
  task instruments_layout "Instruments and voicing rules as drawn" {
    effort 1.5d
    allocate team
    complete 100
    depends !instruments
    note "The W15 board opens the voicing rules full screen in two columns and, on a computer, the instruments with a rail; the app opens both as sheets over the shell, and the add-instrument sheet carries a Cancel and a back arrow the board does not draw. Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (axe); e2e-web (instruments and rules on the three viewports, mockup W15#1-4). Refinement: tasks/refinements/music/instruments_layout.md"
  }
}
