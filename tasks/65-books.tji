# 65 — Books, sharing, setlists and the file view
#
# Everything about books as books: the shelf, putting online, sharing,
# forking, setlists and the file view.

task books "Books" {
  depends shell.layout, foundation.e2e_web

  task shelf "The book-management screen" {
    effort 2d
    allocate team
    complete 100
    depends storage.home_book, storage.shelf_surface
    note "Title or label, where it lives, can save, sync state; new book; rename on my shelf. Workflow 7. Tests: behavior (title or label, where it lives, can save, sync state; new book; rename; axe); e2e-web (a new book made and renamed on the three viewports; axe). Refinement: tasks/refinements/books/shelf.md"
  }
  task online "Put online, remove, delete" {
    effort 2d
    allocate team
    complete 100
    depends !shelf, service.books, sync.engine
    note "Put online private; remove from my shelf with what would be lost; delete the book (owner, type the name); download. Workflow 7. Tests: behavior (the confirmations: what would be lost, typing the name; axe); e2e-web (on the stack: put a book online, remove it from the shelf, delete it as owner, download it; axe). Refinement: tasks/refinements/books/online.md"
  }
  task online_reindex "Reindex on put-online and on remove/delete" {
    effort 1d
    allocate team
    complete 100
    depends !online
    note "When put-online adopts the service id, drop the localId docs/locations from the search index and re-index the serviceId dir; drop stale index entries for a removed or deleted book. App work, Worker only. Source of debt: tasks/refinements/books/online.md (books.online). Governing: DIRECTION §3.7; storage.index. Tests: behavior (put-online then search finds the book by serviceId, not localId; remove then search finds no entries for that book). Refinement: tasks/refinements/books/online_reindex.md"
  }
  task add_by_link "Add by invitation and mine on Estante" {
    effort 2d
    allocate team
    complete 100
    depends !online, service.sharing
    note "An invitation always asks for an account first, then clones as reader or editor; a dead or full link telling nothing about whose book; the user's books not yet on this shelf. Workflows 1, 7. Tests: behavior (the account-first prompt, a dead or full link that says nothing of whose book; axe); e2e-web (a second account opens an invitation from the stack, signs in, clones as reader and as editor; a withdrawn and a full link; axe). Refinement: tasks/refinements/books/add_by_link.md"
  }
  task share "Sharing" {
    effort 3d
    allocate team
    complete 100
    depends !online, service.sharing, !add_by_link
    note "People 37 of 50, invitations with role, expiry and uses, who joined, withdraw, remove, a full book; share from a song; the member's view. Workflow 10. Tests: behavior (people n of 50, invitations with role, expiry and uses, who joined, withdraw, remove, a full book, the member's view; axe); e2e-web (the two-device journey on the stack: the owner invites, a second person joins in another browser context, both edit and sync to a clean merge; withdraw and remove; axe). Refinement: tasks/refinements/books/share.md"
  }
  task fork "Make it my own" {
    effort 2d
    allocate team
    depends !online, sync.fork_follow, sync.lost_access, service.books
    note "Offered by saving where one cannot, losing access, or deliberately; replaces the original on the shelf; from Ana's Choros beneath it. Workflow 11. Tests: behavior (the three ways in, replacing the original on the shelf, from the original beneath; axe); e2e-web (make it my own after losing access and deliberately, then a new save of the original counted; axe)."
  }
  task upload_ui "Upload preview" {
    effort 2d
    allocate team
    complete 100
    depends sync.upload, !shelf
    note "Import as a new book or merge into one; song by song; left out and canonicalised; marked files; history that cannot be rewritten. Workflow 7. Tests: behavior (new book or merge, song by song, left out and canonicalised, marked files, history that cannot be rewritten; axe); e2e-web (a zip uploaded as a new book and merged into one on the three viewports; axe). Refinement: tasks/refinements/books/upload_ui.md"
  }
  task setlists "Setlists" {
    effort 4d
    allocate team
    complete 100
    depends cifra_js.setlists, songs.reading
    note "Open, build (add to setlist, copying from another book), reorder, key and note, missing items pointed at a song; links kept when songs move. Workflow 12. Tests: unit (keeping links when songs move); behavior (open, build, reorder by drag and by keyboard, key and note, a missing item; axe); e2e-web (build and reorder a setlist on the three viewports, by keyboard on the computer, copying from another book; axe). Refinement: tasks/refinements/books/setlists.md"
  }
  task setlist_search "Surface setlists in song search" {
    effort 1d
    allocate team
    depends !setlists
    note "Index setlist titles and surface setlists in the one song search marked as setlists (workflow 12 §The file L33-34), reconciled on save/sync like song index entries. Source of debt: tasks/refinements/books/setlists.md (books.setlists). Governing: workflow 12 §The file; DIRECTION §4. Tests: behavior (a setlist found by search, marked as a setlist, opens; axe); e2e-web (search surfaces a setlist and opens it, phone, tablet, computer; axe)."
  }
  task play "Playing through" {
    effort 2d
    allocate team
    depends !setlists, music.transpose
    note "Full screen in the setlist's key, swipe, edge tap or pedal keys, screen kept awake, next song's title, sync waiting. Workflow 12. Tests: behavior (swipe, edge tap and pedal keys; the setlist's key; the next title; axe); e2e-web (play a setlist through on the three viewports, the screen kept awake asked for, sync waiting until the end; axe)."
  }
  task file_view "The file view" {
    effort 4d
    allocate team
    complete 100
    depends storage.history, songs.editor, songs.new_song, cifra_js.setlists
    note "The tree with statuses as words, only the allowed kinds, rename keeping its kind and updating setlist links, delete, raw editor, save several files, the book's log with line diffs and per-file restore. Workflow 14. Tests: behavior (the tree with statuses as words, rename keeping its kind and updating setlist links, delete, raw editor, save several, the log with line diffs, per-file restore; axe); e2e-web (the file view on the three viewports: a rename, a raw edit saved with another file, a restore from the log; axe). Refinement: tasks/refinements/books/file_view.md"
  }

  task file_view_spec_narrow_comment "Fix stale narrow comment in the file-view e2e spec" {
    effort 0.5d
    allocate team
    complete 100
    depends !file_view
    note "e2e/web/tests/file-view.spec.js line ~50 calls the tablet viewport narrow. The tablet is 712px (wide, > 600px threshold); backToTree() no-ops in wide — the comment is inaccurate. Fix the comment for accuracy. Source of debt: books.file_view (tasks/refinements/books/file_view.md, iter-0116). Governing: workflow 14; foundation.e2e_web. Tests: no new tests; the fix is in the e2e spec itself (comment-only change). Refinement: tasks/refinements/books/file_view_spec_narrow_comment.md"
  }
  task notice_surface "Show the take-down reason in BookDetail" {
    effort 2d
    allocate team
    complete 100
    depends sync.lost_access, service.admin
    note "Sync engine maps the git `403 taken_down` to a distinct halted state carrying the reason; BookDetail.jsx renders the operator's reason (role=status notice) beside the existing Download card. Source of debt: tasks/refinements/service/admin.md (service.admin). Governing: workflow 10 §A copyright notice; DIRECTION §3.6. Tests: behavior (BookDetail renders the taken-down notice with the reason, axe clean; sync engine `403 taken_down` classification in access-refused.js); e2e-web (a taken-down book shows its reason on phone, tablet and computer; axe). Refinement: tasks/refinements/books/notice_surface.md"
  }
}
