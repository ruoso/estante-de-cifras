# 65 — Books, sharing, setlists and the file view
#
# Everything about books as books: the shelf, putting online, sharing,
# forking, setlists and the file view.

task books "Books" {
  depends shell.layout, foundation.e2e_web

  task shelf "The book-management screen" {
    effort 2d
    allocate team
    complete 100
    depends storage.home_book, storage.shelf_surface
    note "Title or label, where it lives, can save, sync state; new book; rename on my shelf. Workflow 7. Tests: behavior (title or label, where it lives, can save, sync state; new book; rename; axe); e2e-web (a new book made and renamed on the three viewports; axe). Refinement: tasks/refinements/books/shelf.md"
  }
  task online "Put online, remove, delete" {
    effort 2d
    allocate team
    complete 100
    depends !shelf, service.books, sync.engine
    note "Put online private; remove from my shelf with what would be lost; delete the book (owner, type the name); download. Workflow 7. Tests: behavior (the confirmations: what would be lost, typing the name; axe); e2e-web (on the stack: put a book online, remove it from the shelf, delete it as owner, download it; axe). Refinement: tasks/refinements/books/online.md"
  }
  task online_reindex "Reindex on put-online and on remove/delete" {
    effort 1d
    allocate team
    complete 100
    depends !online
    note "When put-online adopts the service id, drop the localId docs/locations from the search index and re-index the serviceId dir; drop stale index entries for a removed or deleted book. App work, Worker only. Source of debt: tasks/refinements/books/online.md (books.online). Governing: DIRECTION §3.7; storage.index. Tests: behavior (put-online then search finds the book by serviceId, not localId; remove then search finds no entries for that book). Refinement: tasks/refinements/books/online_reindex.md"
  }
  task add_by_link "Add by invitation and mine on Estante" {
    effort 2d
    allocate team
    complete 100
    depends !online, service.sharing
    note "An invitation always asks for an account first, then clones as reader or editor; a dead or full link telling nothing about whose book; the user's books not yet on this shelf. Workflows 1, 7. Tests: behavior (the account-first prompt, a dead or full link that says nothing of whose book; axe); e2e-web (a second account opens an invitation from the stack, signs in, clones as reader and as editor; a withdrawn and a full link; axe). Refinement: tasks/refinements/books/add_by_link.md"
  }
  task share "Sharing" {
    effort 3d
    allocate team
    complete 100
    depends !online, service.sharing, !add_by_link
    note "People 37 of 50, invitations with role, expiry and uses, who joined, withdraw, remove, a full book; share from a song; the member's view. Workflow 10. Tests: behavior (people n of 50, invitations with role, expiry and uses, who joined, withdraw, remove, a full book, the member's view; axe); e2e-web (the two-device journey on the stack: the owner invites, a second person joins in another browser context, both edit and sync to a clean merge; withdraw and remove; axe). Refinement: tasks/refinements/books/share.md"
  }
  task fork "Make it my own" {
    effort 2d
    allocate team
    complete 100
    depends !online, sync.fork_follow, sync.lost_access, service.books
    note "Offered by saving where one cannot, losing access, or deliberately; replaces the original on the shelf; from Ana's Choros beneath it. Workflow 11. Tests: behavior (the three ways in, replacing the original on the shelf, from the original beneath; axe); e2e-web (make it my own after losing access and deliberately, then a new save of the original counted; axe). Open question the refinement must answer (tasks/parking-lot.md 2026-10-14, Editor lowered to reader with unpushed saves): an editor lowered to reader with saves not yet pushed gets a 403 on every push and the engine keeps the book on saves_waiting, retrying forever; workflow 10 L83-85 says they are told those saves can no longer go and offered a fork or the download. Decide whether that is this task's saving-where-one-cannot entry or a distinct engine change detecting the permanent 403. Refinement: tasks/refinements/books/fork.md"
  }
  task bring_in "Bring them in, as drawn" {
    effort 2d
    allocate team
    complete 100
    depends !fork, sync.fork_follow, !upload_ui
    note "The Bring in Ana's saves screen (W11 board :102-135): N new saves since you last brought them in, the preview rows reusing the upload preview's, the prefilled note, the conflict notice, Not now / Bring them in, consuming PREVIEW_BRING_IN / BRING_IN / CANCEL_BRING_IN; the original is no longer shared with you notice on the book with its last brought-in date (:169), and the offline reply said plainly. Source of debt: tasks/refinements/sync/fork_follow.md (sync.fork_follow). Workflow 11. Tests: behavior (the preview screen and the notice with Testing Library and axe, keyboard paths through Not now and Bring them in, stale and unreachable replies); e2e-web (Ana's account pushes a new save to a book Bia forked, Bia brings it in on phone, tablet and computer; Bia removed from the original sees the notice; axe, mockup W11#2-3). Refinement: tasks/refinements/books/bring_in.md"
  }
  task upload_ui "Upload preview" {
    effort 2d
    allocate team
    complete 100
    depends sync.upload, !shelf
    note "Import as a new book or merge into one; song by song; left out and canonicalised; marked files; history that cannot be rewritten. Workflow 7. Tests: behavior (new book or merge, song by song, left out and canonicalised, marked files, history that cannot be rewritten; axe); e2e-web (a zip uploaded as a new book and merged into one on the three viewports; axe). Refinement: tasks/refinements/books/upload_ui.md"
  }
  task setlists "Setlists" {
    effort 4d
    allocate team
    complete 100
    depends cifra_js.setlists, songs.reading
    note "Open, build (add to setlist, copying from another book), reorder, key and note, missing items pointed at a song; links kept when songs move. Workflow 12. Tests: unit (keeping links when songs move); behavior (open, build, reorder by drag and by keyboard, key and note, a missing item; axe); e2e-web (build and reorder a setlist on the three viewports, by keyboard on the computer, copying from another book; axe). Refinement: tasks/refinements/books/setlists.md"
  }
  task setlist_search "Surface setlists in song search" {
    effort 1d
    allocate team
    complete 100
    depends !setlists
    note "Index setlist titles and surface setlists in the one song search marked as setlists (workflow 12 §The file L33-34), reconciled on save/sync like song index entries. Source of debt: tasks/refinements/books/setlists.md (books.setlists). Governing: workflow 12 §The file; DIRECTION §4. Tests: behavior (a setlist found by search, marked as a setlist, opens; axe); e2e-web (search surfaces a setlist and opens it, phone, tablet, computer; axe). Refinement: tasks/refinements/books/setlist_search.md"
  }
  task play "Playing through" {
    effort 2d
    allocate team
    complete 100
    depends !setlists, music.transpose
    note "Full screen in the setlist's key, swipe, edge tap or pedal keys, screen kept awake, next song's title, sync waiting. Workflow 12. Tests: behavior (swipe, edge tap and pedal keys; the setlist's key; the next title; axe); e2e-web (play a setlist through on the three viewports, the screen kept awake asked for, sync waiting until the end; axe). Refinement: tasks/refinements/books/play.md"
  }
  task file_view "The file view" {
    effort 4d
    allocate team
    complete 100
    depends storage.history, songs.editor, songs.new_song, cifra_js.setlists
    note "The tree with statuses as words, only the allowed kinds, rename keeping its kind and updating setlist links, delete, raw editor, save several files, the book's log with line diffs and per-file restore. Workflow 14. Tests: behavior (the tree with statuses as words, rename keeping its kind and updating setlist links, delete, raw editor, save several, the log with line diffs, per-file restore; axe); e2e-web (the file view on the three viewports: a rename, a raw edit saved with another file, a restore from the log; axe). Refinement: tasks/refinements/books/file_view.md"
  }

  task file_view_spec_narrow_comment "Fix stale narrow comment in the file-view e2e spec" {
    effort 0.5d
    allocate team
    complete 100
    depends !file_view
    note "e2e/web/tests/file-view.spec.js line ~50 calls the tablet viewport narrow. The tablet is 712px (wide, > 600px threshold); backToTree() no-ops in wide — the comment is inaccurate. Fix the comment for accuracy. Source of debt: books.file_view (tasks/refinements/books/file_view.md, iter-0116). Governing: workflow 14; foundation.e2e_web. Tests: no new tests; the fix is in the e2e spec itself (comment-only change). Refinement: tasks/refinements/books/file_view_spec_narrow_comment.md"
  }
  task notice_surface "Show the take-down reason in BookDetail" {
    effort 2d
    allocate team
    complete 100
    depends sync.lost_access, service.admin
    note "Sync engine maps the git `403 taken_down` to a distinct halted state carrying the reason; BookDetail.jsx renders the operator's reason (role=status notice) beside the existing Download card. Source of debt: tasks/refinements/service/admin.md (service.admin). Governing: workflow 10 §A copyright notice; DIRECTION §3.6. Tests: behavior (BookDetail renders the taken-down notice with the reason, axe clean; sync engine `403 taken_down` classification in access-refused.js); e2e-web (a taken-down book shows its reason on phone, tablet and computer; axe). Refinement: tasks/refinements/books/notice_surface.md"
  }
  task leave "Leave this book" {
    effort 1d
    allocate team
    complete 100
    depends !online, service.leave_book, design.leave_book
    note "As design.leave_book decides: the Leave verb in book management for a member, its confirmation with unsaved changes and unpushed saves counted, then the book removed from this device and Mine on Estante no longer offering it. Source: tasks/parking-lot.md 2026-10-14. Tests: behavior (the verb shown to members and not owners; the confirmation; axe); e2e-web (a member leaves on the stack and the book is gone from the shelf and from Mine on Estante; axe). Refinement: tasks/refinements/books/leave.md"
  }
  task remove_counts_unsaved "Remove from my shelf counts unsaved songs" {
    effort 0.5d
    allocate team
    complete 100
    depends !online, design.w07_remove_board
    note "Remove from my shelf counts the songs with unsaved changes beside the saves waiting to go up, read from SURVEY_SIGN_OUT, and shows N songs with unsaved changes will be lost with their titles, as the Remove-from-shelf board draws it. Source of debt: tasks/refinements/design/w07_remove_board.md (design.w07_remove_board). Governing: workflow 7 Removing a book; workflow 10 Leaving a book. Tests: behavior (BookDetail.behavior.test.jsx: the Remove confirmation counts unsaved songs and names them, axe); e2e-web (online.spec.js: unsaved songs are counted and named in the Remove confirmation on phone, tablet and computer; axe). Refinement: tasks/refinements/books/remove_counts_unsaved.md"
  }
  task owner_name "The owner's name on a shared book" {
    effort 1d
    allocate team
    complete 100
    depends !leave
    note "The Book in listBooks carries the owner's display name (api/openapi.yaml first, then the service's GET /api/books); the Worker keeps it in the shelf register; BookDetail's role chip reads On Estante · shared by {owner} and the Leave confirmation names the owner ({owner} can invite you again), as the Leave-book board and workflow 10 Leaving a book draw it. Source: tasks/refinements/books/leave.md Decision 5 (commit of books.leave). Tests: unit (the contract shape); behavior (the service lists the owner's name, Go httptest; BookDetail's chip and the Leave confirmation name the owner; axe); e2e-api (a member's listBooks carries the owner's name); e2e-web (a joiner sees shared by {owner} and the named confirmation; axe). Refinement: tasks/refinements/books/owner_name.md"
  }
  task invited_presentation "The invited screen and refusals as drawn" {
    effort 0.5d
    allocate team
    complete 100
    depends !add_by_link
    note "The invited screen centres its content a third of the way down where the W01 board top-aligns it under a book mark; its heading shows a dark focus box on arrival (the programmatic focus needs the theme focus treatment, or a focus target that is not outlined); and the dead-link and full-book refusals are standalone screens where the board draws them as dialogs over the empty shelf. Copy is unchanged (workflow 1 Invited L49-66 names no book). Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: behavior (refusals as dialogs, focus lands on the heading without the outline, axe); e2e-web (a dead link and a full book on the three viewports, mockup W01#2 and W01#4). Refinement: tasks/refinements/books/invited_presentation.md"
  }
  task file_view_create_menu "Create a song, a setlist, a folder or a README in the file view" {
    effort 2d
    allocate team
    complete 100
    depends !file_view
    note "Workflow 14 (What can be done to a file, first bullet) lets the file view create a song, a setlist, a folder or a README; the app offers only New song. Add the create menu the W14 board draws, and on a phone the board top bar (icon actions, the title not collapsed) and the open file header with a ... menu holding Rename and Delete. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: unit (the new file names and their templates); behavior (each create kind, axe); e2e-web (Books → Files → create each kind, then it appears in the tree and opens; mockup W14#1-2). Refinement: tasks/refinements/books/file_view_create_menu.md"
  }
  task setlist_chrome "The setlist view keeps the tab bar on a phone" {
    effort 0.5d
    allocate team
    complete 100
    depends !setlists
    note "The W12 board keeps Search, Books and Setlists visible under an open setlist on a phone; the app hides the tab bar there. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: behavior (the tab bar under an open setlist on narrow); e2e-web (a setlist opened from the Setlists tab on a phone, the tab bar reaches Search; mockup W12#1-2). Refinement: tasks/refinements/books/setlist_chrome.md"
  }
  task share_people "Sharing names people, and reads as drawn" {
    effort 2d
    allocate team
    complete 100
    depends !share, service.sharing
    note "The Share sheet lists a member, and who joined through an invitation, by raw account id (1813458e-...) where the W10 board names them (workflow 10: members listed). Name people by their display name (the service's members/invitations responses carry it, or the contract gains it). Also from W10: the new invitation lacks the room-left callout, invitations lack Copy link, the owner's people screen and a song's share are sheets where the board draws a screen and a side panel. Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (names, not ids; Copy link; axe); e2e-api (members and invitations carry names); e2e-web (two people, the owner sees the other by name; mockup W10#1-6). Refinement: tasks/refinements/books/share_people.md"
  }
  task add_book_chooser "Add a book as a four-way chooser" {
    effort 1d
    allocate team
    complete 100
    depends !add_by_link, !upload_ui
    note "The W07 board opens Add a book as a chooser of four ways in (new, by link, mine on Estante, upload); the app shows four inline forms. The upload preview is a side pane whose mode switch wraps. Under Mine on Estante the board offers No passkey here? Email me a link, which needs a recovery email to exist (account.recovery_email). Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (each way in from the chooser; axe); e2e-web (each way on the three viewports, mockup W07#1-4). Refinement: tasks/refinements/books/add_book_chooser.md"
  }
  task setlist_play_chrome "Playing a setlist shows its key" {
    effort 0.5d
    allocate team
    complete 100
    depends !play
    note "The W12 board's player carries the song's key chip (In A) and the setlist's key line; the app's player has neither. The Add to setlist dialog is cramped (list, title and buttons with no gaps). Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (the key chip and line; axe); e2e-web (play a setlist with a key on the three viewports, mockup W12#2-3). Refinement: tasks/refinements/books/setlist_play_chrome.md"
  }
  task file_view_history_polish "The file view's history and rename as drawn" {
    effort 1d
    allocate team
    complete 100
    depends !file_view
    note "From W14: the rename dialog does not list the links it will update (workflow 14 rename keeps setlists pointing at the song); the computer history detail has no commit heading or message line. Source: UI pairwise audit 2026-10-14 (e2e mockup() screenshots vs rendered boards, audit/out). Tests: behavior (rename lists the setlists it updates; the commit heading; axe); e2e-web (mockup W14#3-4). Refinement: tasks/refinements/books/file_view_history_polish.md"
  }
  task save_readme_verbatim "Save README.md and .gitattributes as written" {
    effort 0.5d
    allocate team
    complete 100
    depends songs.save_gate_dropped_section
    note "The Worker's save writes README.md and .gitattributes through the song writer (app/src/worker/canonicalise.js:30,76-79 treats every non-setlist path as a song), so a README with a `---` above a `## Heading` loses the lines under it and runs of blank lines are collapsed, but the hook holds README.md only to the text rules (hook.canonical). Save README.md and .gitattributes as written (UTF-8 checked, marker lines refused), and narrow the editor's after-rule save gate (app/src/editor/save-blockers.js) to `*.cifra.md` paths and new songs. Source: tasks/refinements/songs/save_gate_dropped_section.md (songs.save_gate_dropped_section). Governing: docs/workflows/04-edit-and-save.md Normalising. Tests: unit (canonicaliseFile keeps a README with a rule and headings byte for byte; refuses a marker line); behavior (a README saved through working-copy.js save commits its bytes unchanged; the raw editor saves a README with `---` / `## Usage` without the after-rule stop; axe). Refinement: tasks/refinements/books/save_readme_verbatim.md"
  }
  task row_opens_songs "A book on the shelf opens on its songs" {
    effort 1d
    allocate team
    complete 100
    depends !shelf, !file_view, design.book_row_songs
    note "As design.book_row_songs decides: the book row's press opens the book's songs (search scoped to it at …/b/<book>), the row has no other action — the management detail is reached from an entry on the book's songs view, and Files moves from the row into that detail; a book that needs you opens as the design says. Source: launch smoke test 2026-10-19 (the Books tab's only visible way into a book was Files). Tests: behavior (the row opens the scoped search, its detail entry opens the detail, Files reached from the detail, keyboard paths; axe); e2e-web (a book's songs opened from the Books tab and a song played from there, the detail reached from the book's songs and Files from the detail, on the three viewports; axe, mockup W07 and W14). Refinement: tasks/refinements/books/row_opens_songs.md"
  }
  task setlists_resilient "Setlists never stuck loading; a half-cloned book never reads as empty" {
    effort 1d
    allocate team
    complete 100
    depends !setlists
    note "H1: the Setlists destination showed Loading setlists… forever. LIST_SETLISTS (app/src/worker/logic.js:2117-2148) walks every /books directory and calls book-tree statusMatrix with no per-book catch; one directory without a readable .git/HEAD (removeTree is not atomic, online.js:98-116; an interrupted clone) throws NotFoundError, the generic catch posts ERROR, and SetlistsScreen (app/src/books/SetlistsScreen.jsx:19-38) ignores ERROR, so the slice stays null. The index sweep already tolerates such a directory (search-index.js:93-110, 380-402). Skip a book that cannot be read, never wait on a lock a clone holds, and end Loading on ERROR with a plain message. M8: a book read 0 songs and later 9 — buildIndexes indexes a directory with HEAD but no main as ready and empty (logic.js:978-984, 1353-1362) until the shelf fill re-clones it; do not index or list a book without commits, and show its fill state in Search instead of 0 songs. Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: unit (LIST_SETLISTS over a HEAD-less directory, a book with no main); behavior (the Setlists screen leaves Loading on ERROR; Search shows the fill state, not 0 songs; axe); e2e-web (a damaged local book directory beside a good one: Setlists lists the good one's setlists on the three viewports). Refinement: tasks/refinements/books/setlists_resilient.md"
  }
  task owner_can_save "A book one owns can be saved to everywhere" {
    effort 1d
    allocate team
    complete 100
    depends !setlists, !online
    note "H3: Add to setlist listed only New setlist…: AddToSetlist.jsx:69-83 keeps setlists from books where canSaveFor is true, and canSaveFor (app/src/books/book-display.js:57-63) knows only editor and reader, while put-online and fork write role owner (logic.js:2581, 2697; docs/home-book-format.md lists owner). So a signed-in person own hosted books read as unknown in AddToSetlist, WhichBook (WhichBook.jsx:54), UploadPreview (:72), Search Save all (SearchScreen.jsx:111) and the Books role chip (BooksScreen.jsx:190). H4: the New setlist… name Input (AddToSetlist.jsx:273) is not focused on open, so typing is lost; and the dialog closes unconditionally on Create (:265-266) even when createNew has no target book (:114-116), so nothing happens and nothing says why; the My songs lookup by title (:87-91) is fragile. Owner counts as can-save; focus the name field; close only once there is a target, else say why; find My songs by id, not title. Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: unit (canSaveFor owner); behavior (every role-gated surface with an owner-role hosted book; the name field focused on open; no silent close; axe); e2e-web (a book put online, then a song added to a new setlist in it from the song view, on the three viewports). Refinement: tasks/refinements/books/owner_can_save.md"
  }
  task detail_as_drawn "The book detail in the board order, Delete set apart" {
    effort 0.5d
    allocate team
    complete 100
    depends !row_opens_songs, design.review_polish
    note "M11: BookDetail stacks Download, Fork, Remove, Leave, a Share card, then the red Delete (BookDetail.jsx:465-548), so Delete sits under Share with no separation; W07 (docs/mockups/W07-add-a-book.dc.html:202-226) has Share in the app bar. As design.review_polish draws it: Share where the board puts it, Delete set apart at the end. Source: usability review 2026-10-19 (Claude in Chrome on the deployed app, findings verified against the code). Tests: behavior (the order and the separation, Share reachable, keyboard path; axe); e2e-web (the book detail on the three viewports; axe, mockup W07). Refinement: tasks/refinements/books/detail_as_drawn.md"
  }
  task share_needs_online "Share on a book only on this device leads to putting it online" {
    effort 0.5d
    allocate team
    complete 100
    depends !share_people, !online
    note "A first-time teacher pressed Share on a song in My songs (local, signed out) and got Something went wrong. Try again., on a phone and a computer, and Try again failed the same way: Share is offered on every song (app/src/songs/SongReading.jsx:582, :753) and the panel and sheet (SongSharePanel.jsx, useSharing) ask the service about a book it has never seen. Workflow 10 shares only books on Estante. On a book only on this device, Share says so in words — this book is only on this device; put it online to invite people — and offers Put online, signing in first when signed out (account.sign_in_two_doors). Source: persona exploration 2026-10-19 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified against screenshots and code). Tests: behavior (Share on a local book, signed in and out: the explanation and the way on, no service call; axe); e2e-web (a song written in My songs, Share leads to putting the book online and then inviting, on the three viewports; axe). Refinement: tasks/refinements/books/share_needs_online.md"
  }
  task setlist_picker_fixes "The setlist song picker and the invitation Done" {
    effort 0.5d
    allocate team
    complete 100
    depends !setlists, !share_people
    note "Add song in a setlist being edited offers a song already in it as addable (Corcovado listed while first in the setlist): mark the songs already there, or leave them out. And Done on the invitation link screen, reached from a book detail Share, lands on the Setlists destination (/setlists) instead of back on the book. Source: persona exploration 2026-10-19 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified against screenshots and code). Tests: behavior (the picker with a song already in the setlist; Done returns to where Share was opened; axe); e2e-web (a setlist edited on a phone, and an invitation made from a book, each on the three viewports; axe). Refinement: tasks/refinements/books/setlist_picker_fixes.md"
  }
  task setlist_invitation "An invitation that opens on a setlist" {
    effort 1d
    allocate team
    complete 100
    depends !setlists, !share_people, !setlist_picker_fixes
    note "Decided 2026-10-19: a teacher wanted students to see this week’s lesson, a setlist, but sharing is per book, so the only way was to put the whole book online and invite people to all of it. Share on a setlist makes the book’s ordinary invitation and opens on that setlist once accepted, exactly as Share on a song opens on the song: the setlist path appended to the /i/<token> link as a client-only fragment (tasks/refinements/books/share.md Decision 2; the …/b/<book>/<path> address already opens setlists, workflow 7 L52-54). For someone already a member the link is just the setlist address. Students still join the whole book; workflow 10’s there is no sharing one song apart from its book holds for a setlist too, and the Share surface says so in a line. A Share action on the setlist view, phone sheet and wider panel as Share on a song; on a book only on this device it behaves as books.share_needs_online. Record it in workflow 10 (Sharing a song, now a song or a setlist) and workflow 12, and draw Share on the W12 board. Source: persona exploration 2026-10-19 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified against screenshots and code). Tests: behavior (Share on a setlist: the invitation link carries the setlist path, the member link is the setlist address; axe); e2e-web (a teacher shares a setlist, a second account accepts and lands on the setlist, on the three viewports; axe). Refinement: tasks/refinements/books/setlist_invitation.md"
  }
  task put_online_confirm "Put online asks first and says up to 50 people" {
    effort 0.5d
    allocate team
    complete 100
    depends !detail_as_drawn, design.review_polish
    note "Items 7 and 8 of design.review_polish: Put online on the book detail opens a confirmation (Put {book} online?, what private means, up to 50 people; Cancel focused; focus back on the card's button), the local book's card says nobody else can see it yet, and every screen says up to 50 people (books.putOnlineBody, the successor of books.shareBody, the sharing screen's hint), in the four locales; the share panel's Put it online stays one press. Workflows 7, 10. Source: persona exploration 2026-10-19. Tests: behavior (BookDetail: Cancel sends nothing, Put online sends PUT_ONLINE, offline the failure line; axe); e2e-web (a local book put online through the dialog on phone, tablet and computer, then Share in the app bar; axe; the existing put-online journey in e2e/web/lib updated to pass the dialog). Refinement: tasks/refinements/design/review_polish.md; tasks/refinements/books/put_online_confirm.md"
  }
  task setlist_done "A new setlist says not saved yet, and editing has Done" {
    effort 0.5d
    allocate team
    complete 100
    depends design.review_polish
    note "Item 9 of design.review_polish: a setlist never saved reads not saved yet (badge, setlist list, editor bar) instead of unsaved changes, and the setlist editor's icon-only Back becomes Done, leaving editing with every change kept; four locales. Workflow 12. Source: persona exploration 2026-10-19. Tests: behavior (SetlistView: a new setlist's badge, an edited saved one's, Done keeps the change and returns focus to Edit; axe); e2e-web (a setlist made from Add to setlist, opened, edited, Done, then saved, on phone, tablet and computer; axe). Refinement: tasks/refinements/design/review_polish.md; tasks/refinements/books/setlist_done.md"
  }
  task put_online_no_ghosts "Putting a book online leaves no ghost behind" {
    effort 0.5d
    allocate team
    complete 100
    depends !online, songs.no_raw_ids
    note "After Put online on My songs, Search listed an Untitled book with 0 songs that the Books tab did not, and Recent showed Untitled song · Untitled book, which opened a dead /b/local-my-songs/… address. Two bugs: PUT_ONLINE emits INDEX_STATUS with state null for the old local id (worker/logic.js:2671) and the reducer stores the null instead of dropping the entry (worker/reducer.js:409), while SearchScreen lists every key of the index (songs/SearchScreen.jsx:571) — the same null is emitted when a book leaves the shelf (logic.js:1183, 2788, 2882, 3026, 3077); and PUT_ONLINE (logic.js:2596-2681) never moves the device’s recents to the book’s new id, so the old entry finds nothing and survives a reload. A book that changes id moves its recents; one that leaves drops them; a null status removes the book from the index. Source: persona exploration 2026-10-20 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified live and against the code). Tests: unit (reducer: a null INDEX_STATUS removes the entry); behavior (worker: PUT_ONLINE moves recents to the service id, removing a book drops its recents and index entry); e2e-web (a song saved and opened in a local book, Put online, Search lists no Untitled book, Recent opens the song at its new address, after a reload too, on the three viewports; axe). Refinement: tasks/refinements/books/put_online_no_ghosts.md"
  }
  task new_book_counted "A new book reads 0 songs at once" {
    effort 0.25d
    allocate team
    complete 100
    depends !shelf
    note "A new empty book read On this device · can save · still loading for more than 50 seconds, and 0 songs only after a reload: CREATE_BOOK (worker/logic.js:2479-2514) never indexes the book, so no INDEX_STATUS ready with a count arrives and book-display.js:90 says still loading whenever the count is not a number; the startup sweep indexes it on reload. CREATE_BOOK indexes the book it made, as every other path that adds a book does. Source: persona exploration 2026-10-20 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified live and against the code). Tests: behavior (worker: CREATE_BOOK posts INDEX_STATUS ready with songs 0); e2e-web (Add a book, New book, the row reads 0 songs without a reload, on the three viewports; axe). Refinement: tasks/refinements/books/new_book_counted.md"
  }
  task setlist_row_opens "A song in a setlist opens from its row" {
    effort 1d
    allocate team
    depends !setlists, !play, !setlist_done
    note "Design and build in one task. A teacher tapped Samba de Verao in his setlist to look at it and nothing happened: in reading mode a setlist’s rows are plain divs with no action (books/SetlistView.jsx:302-316), though they look like the pressable rows everywhere else, and workflow 12 says only that opening a setlist lists its songs. Decide in workflow 12 (docs/workflows/12-setlists.md) and draw on W12: decided with the human 2026-10-21: pressing a song in a setlist opens Play at that song, with the setlist’s key and note, and next and previous through the rest; Back returns to the setlist; keyboard and screen reader included. Source: persona exploration 2026-10-20 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified live and against the code). Tests: behavior (SetlistView: a row is a button, pressing it opens the song as decided with the setlist’s key, Back returns to the setlist; axe); e2e-web (a setlist of two songs, the second opened from its row, on the three viewports; axe, mockup W12)."
  }
  task setlist_making "A setlist made from the Setlists tab, and said when made" {
    effort 1d
    allocate team
    depends !setlists, !setlist_picker_fixes
    note "Design and build in one task. The Setlists tab has no way to make a setlist — its empty state says No setlists yet. Add a song to a setlist from search or the reading view. — so a teacher planning a lesson had to leave it; and making one from Add to setlist, New setlist…, a name, Create closed both dialogs with nothing saying the song went in. Decide in workflow 12 and draw on W12: the Setlists tab offers New setlist (naming it and choosing its book when more than one can be saved to, then adding songs to it), and making a setlist from Add to setlist ends by saying the song is in it, with a way to open it. Source: persona exploration 2026-10-20 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified live and against the code). Tests: behavior (SetlistsScreen: New setlist from the tab, with one and with two books that can be saved to; Add to setlist with a new setlist announces it; axe); e2e-web (a setlist made from the tab and songs added, and one made from Add to setlist, on the three viewports; axe, mockup W12)."
  }
  task invite_send "Sending an invitation from the phone" {
    effort 0.5d
    allocate team
    depends !share_people, !setlist_invitation
    note "Design and build in one task. The made link says Here is the link. Send it however you like, but offers only Copy, so a teacher on his phone had to copy and switch apps; and the panel after Put online leads with For people already in the book and Members open … at its address, which a teacher with no students in it yet did not read as how to reach them. Decide in workflow 10 (docs/workflows/10-share.md) and draw on W10: where the device can share (the Web Share API), the made link offers Send beside Copy; a book with no members yet leads with inviting people. Source: persona exploration 2026-10-20 (Haiku agents as guitar teachers driving the app with playwright-cli on a local stack; findings verified live and against the code). Tests: behavior (the made link offers Send when navigator.share exists and not when it does not, Send passes the link; a book with no members leads with the invitation; axe); e2e-web (an invitation made with navigator.share stubbed, Send called with the link, on the three viewports; axe, mockup W10)."
  }
}
