# 30 — The service (Go)
#
# Sign-in, the registry, sharing, the change check, git over HTTP, and serving
# the app — one binary, one origin. DIRECTION §3.3, §3.6.

task service "The service" {
  depends foundation.service_skeleton, foundation.api_contract, foundation.e2e_api

  task schema "Postgres schema and migrations" {
    effort 2d
    allocate team
    complete 100
    note "Accounts, sessions, passkeys, devices, books, members and roles, invitations with expiry and uses, quotas. pgx; versioned migrations. Tests: behavior (every migration applied from empty to the latest against Postgres from compose; the constraints later tasks rely on — one membership per person per book, invitation uses never below zero). Refinement: tasks/refinements/service/schema.md"
  }
  task passkeys "Passkeys" {
    effort 3d
    allocate team
    complete 100
    depends !schema
    note "go-webauthn: register and sign in, the browser's own cross-device QR flow, several passkeys per account. Workflow 13. Tests: unit (the go-webauthn wiring with a software authenticator); behavior (register, sign in, a second passkey, an unknown credential refused — httptest against Postgres); e2e-api (register and sign in over HTTP against the stack with a software authenticator). Refinement: tasks/refinements/service/passkeys.md"
  }
  task email_links "Emailed sign-in links" {
    effort 2d
    allocate team
    complete 100
    depends !schema
    note "Signed, short-lived, single-use links through the email provider; the fallback and account recovery. Workflow 13. Tests: unit (signing, expiry, single use); behavior (request and redeem through httptest; an expired and a reused link refused); e2e-api (request a link, read it from the mail catcher, redeem it into a session — workflow 13). Refinement: tasks/refinements/service/email_links.md"
  }
  task sessions "Sessions and devices" {
    effort 2d
    allocate team
    depends !passkeys
    note "HttpOnly session cookie on the one origin; signed-in devices with last use; sign out any of them. Workflow 13. Tests: behavior (the cookie HttpOnly, Secure, SameSite; devices with last use; signing out another device ends its session); e2e-api (a session carried across calls; a signed-out device refused)."
  }
  task books "Books: create, list, delete, fork" {
    effort 3d
    allocate team
    depends !sessions
    note "Bare repositories on the volume at /data/books/<id>.git, random ids, owner-only delete (type the name), fork as a copy on the volume, per-account limits (100 books, 200 MB). Workflows 7, 11, 14. Tests: behavior (create, list, delete with the typed name by the owner only, fork as a copy — httptest against Postgres and real git on a temporary volume; the 100-book and 200 MB limits refused); e2e-api (create, list, fork and delete against the stack; a non-owner's delete and an over-quota create refused)."
  }
  task git_http "Git over HTTP" {
    effort 4d
    allocate team
    depends !books
    note "git upload-pack / receive-pack --stateless-rpc framed by the service: service header, Git-Protocol to GIT_PROTOCOL, gzip bodies, size cap, deadline, kill on disconnect, refusals before git starts, ESTANTE_* environment for the hook. DIRECTION §3.6 Git over HTTP. Tests: unit (the service header as a pkt-line, Git-Protocol to GIT_PROTOCOL, the gzip reader, the ESTANTE_* environment); behavior (httptest with real git: clone, fetch and push; a gzip body; a protocol v2 fetch; a client disconnecting mid-push kills git and leaves no lock; the size cap and the deadline; no access, over quota and a deleted book refused before git starts); e2e-api (the git CLI and isomorphic-git clone, fetch and push against the stack; a protocol v2 fetch from the CLI; a non-member refused)."
  }
  task change_check "The shelf change check" {
    effort 1d
    allocate team
    depends !git_http
    note "One request for a whole shelf, each book with the head the device has, answered with the books that moved; one ref read per book. Workflow 8. Tests: behavior (a shelf with moved and unmoved books answered with one ref read each; a book the user lost access to); e2e-api (a push from one client, then the change check from another sees that book move and no other)."
  }
  task sharing "Members and invitations" {
    effort 3d
    allocate team
    depends !books
    note "Invitations with role, expiry, limit on uses, who joined; accept; withdraw; members' roles; remove; at most fifty people per book, a full book refusing joins and telling the owner; who sees whom. Workflow 10. Tests: unit (role, expiry and use rules); behavior (invite, accept, withdraw, change a role, remove; the fiftieth person joins, the fifty-first is refused and the owner told; who sees whom); e2e-api (an invitation accepted by a second account, which can then clone and, as editor, push; a full book refusing a join)."
  }
  task serve_app "Serve the app" {
    effort 1d
    allocate team
    complete 100
    note "The built PWA at the root of the origin, its API beneath; cache headers for the service worker; noindex on everything. DIRECTION §3.3. Tests: behavior (httptest: the built app at the root, the API beneath, cache headers for the service worker, noindex on every response); e2e-api (against the stack: the app at /, an API route beside it, X-Robots-Tag on both). Refinement: tasks/refinements/service/serve_app.md"
  }
  task admin "Admin actions for a notice" {
    effort 1d
    allocate team
    depends !sharing
    note "Withdraw a book's invitations, remove its members, or take it down, with the owner told why. Workflow 10. Tests: behavior (each action against Postgres and git, the owner's notice recorded); e2e-api (a taken-down book refuses clone and push with its reason; withdrawn invitations no longer accepted)."
  }
  task rate_limits "Rate limits" {
    effort 1d
    allocate team
    depends !sessions
    note "Sign-in attempts, emailed links, book creation, invitations accepted. Tests: unit (the limiter's windows); behavior (each limit trips at its threshold through httptest and recovers); e2e-api (repeated sign-in attempts limited against the stack)."
  }
}
