# 99 — Milestones
#
# Zero-duration milestones marking when major capability is in place; each
# depends on the work that has to exist first. There are no test tasks to
# gate on: every task lands with its own tests (its note says which), so a
# milestone's tasks being complete means their tests exist and pass.

task milestones "Milestones" {
  task m0_design "M0: Design" {
    milestone
    complete 100
    depends bootstrap.mockups, bootstrap.architecture, format.merge
    note "Direction, fourteen workflows, mockups and visual language, the architecture, and the format specified through its merge."
  }

  task m1_format "M1: The format in JavaScript" {
    milestone
    complete 100
    depends cifra_js.conformance, cifra_js.editing, cifra_js.diff, format.setlist_corpus
    note "cifra.md for JavaScript passes the canonical and merge corpora; what the app needs from the format exists."
  }

  task m2_local "M2: A songbook on one device" {
    milestone
    complete 100
    depends milestones.m1_format, songs.search, songs.reading, songs.first_song, songs.new_song, songs.save_sheet, songs.editor_section_after_voicings, songs.arrange, songs.wizard_ui, songs.history, music.explorer, music.explorer_standard_shapes, books.shelf, books.file_view, books.file_view_spec_narrow_comment, shell.i18n, shell.pwa, shell.portal_provider, account.first_run, storage.preferences_surface, storage.progression_search, storage.shelf_surface, storage.recents_reconcile, storage.fs_flush, storage.shelf_flush, storage.index_dirty_reconcile
    note "Local books only, no account: find, read, write, edit, arrange, history, the explorer, the file view — installed and offline."
  }

  task m3_service "M3: Estante online" {
    milestone
    complete 100
    depends milestones.m2_local, hook.messages, hook.home_book, account.sign_in, books.online, books.online_reindex, sync.states, sync.states_e2e_hosted, sync.read_in_place, sync.unsaved, songs.edit_in_place, launch.deploy, launch.email, foundation.cifra_md_in_image, foundation.gate_localhost_origin, account.sign_in_two_doors, books.row_opens_songs, books.setlists_resilient, books.owner_can_save, shell.popover_surface, songs.save_feedback, songs.unsaved_after_discard, songs.no_raw_ids, songs.history_24h, songs.render_notes, songs.unknown_tokens_loud, songs.format_help, account.author_name, books.share_needs_online, books.setlist_picker_fixes, books.setlist_invitation, shell.surface_restore_focus, shell.surface_restore_focus_song, songs.trailing_chord_gap, shell.narrow_fixes, account.no_passkey_hint
    note "Sign in, put a book online, every push checked, sync across one person's devices — running at www.estantedecifras.app."
  }

  task m4_together "M4: Together" {
    milestone
    depends milestones.m3_service, books.add_by_link, books.share, books.fork, books.bring_in, sync.conflicts, sync.keep_both, sync.lost_access, service.admin, books.notice_surface
    note "Invitations, fifty per book, forks following their original, merges and conflicts between people."
  }

  task m5_complete "M5: The first pass, complete" {
    milestone
    depends milestones.m4_together, books.setlists, books.setlist_search, books.play, books.upload_ui, account.new_device, account.commit_author, account.sign_out, account.leaving, shell.a11y_chart, service.rate_limits, service.signin_link_path_redaction, songs.restore_part, shell.routing, shell.routing_rename_across_reload, shell.routing_reload_scope_step, shell.fonts, shell.display_preferences, songs.save_gate_dropped_section, books.save_readme_verbatim, books.leave, books.owner_name, account.recovery_email, design.w07_remove_board, books.remove_counts_unsaved, shell.header_chrome, shell.narrow_fit, account.preferences_layout, books.invited_presentation, books.file_view_create_menu, books.setlist_chrome, songs.reading_chrome, songs.arrange_polish, songs.history_phone_actions, songs.show_the_file, music.explorer_flip_copy, music.fourth_with_seventh_spelling, music.voicings_song_dialect, songs.song_notation_views, sync.conflicts_polish, sync.conflicts_row_summary, format.resolve_marked_unterminated, design.boards_refresh, shell.palco_contrast, songs.discard_summary, songs.transpose_chrome, songs.editor_chrome, songs.first_save_fields, music.instruments_roster_default, music.instruments_layout, books.share_people, books.add_book_chooser, books.setlist_play_chrome, books.file_view_history_polish, sync.in_place_notices, sync.conflicts_editing, songs.save_empty_message, shell.full_height, shell.dev_mount_open, books.detail_as_drawn, shell.plain_language, songs.search_book_head_narrow, songs.empty_states, songs.menu_grouping
    note "Setlists and playing through, upload and download, a new device, leaving, and a sung line read aloud as decided."
  }

  task m6_format_go "M6: The format in Go, everywhere" {
    milestone
    complete 100
    depends cifra_go.conformance, cifra_go.merge, format.cross_check, format.conflicts_schema, format.setlist_schema, format.render_hyphen
    note "The second implementation complete with git-merge-cifra, and three implementations compared in CI."
  }
}
