# 70 — First run and the account
#
# Arriving, signing in on another device, and leaving.

task account "First run and the account" {
  depends shell.layout, foundation.e2e_web

  task first_run "First run" {
    effort 2d
    allocate team
    complete 100
    depends songs.search, design.example_book, books.shelf
    note "The empty shelf and its four ways in; the example book shipped with the app; My songs. Workflow 1. Tests: unit (the example book's songs read without diagnostics and are canonical under cifra.md for JavaScript); behavior (the empty shelf's four ways in, My songs; axe); e2e-web (a first visit on the three viewports, the example book opened, offline after a reload; axe). Refinement: tasks/refinements/account/first_run.md"
  }
  task sign_in "Signing in" {
    effort 3d
    allocate team
    complete 100
    depends service.passkeys, service.email_links, service.sessions
    note "A passkey, the browser's cross-device flow, the emailed link; offering a passkey on a new device. Workflows 7, 13. Tests: behavior (passkey, cross-device and emailed-link screens; axe); e2e-web (on the stack: a passkey with a virtual authenticator, an emailed link read from the mail catcher, a passkey offered on a new device; axe). Refinement: tasks/refinements/account/sign_in.md"
  }
  task new_device "A new device" {
    effort 3d
    allocate team
    complete 100
    depends !sign_in, storage.home_book, sync.engine, books.online, service.home_book
    note "Attach the home book to its service remote (service.home_book) on sign-in, pushing what this device has. The home book first, the shelf filling, only on your iPhone, a device used before signing in (merge or keep both My songs). Workflow 13. Tests: behavior (the home book first, the shelf filling, only on your iPhone; axe); e2e-web (a second browser context signs in to the same account on the stack and fills its shelf; a device used before signing in merges or keeps both My songs; axe). Refinement: tasks/refinements/account/new_device.md"
  }
  task commit_author "Authoring as the account" {
    effort 2d
    allocate team
    complete 100
    depends !new_device, sync.engine
    note "After sign-in, saves, merges and home syncs are authored as <account-id>@users.estantedecifras.app instead of the device-local id; the account id comes from the sign-in reply and the attach and is kept in the Worker's meta store. On sign-in the saves not yet pushed that carry the local id are re-authored (chain rewritten from the first local-authored commit); sign-out reverts to the local id; AppShell's LOCAL_IDENTITY is retired. Source: tasks/refinements/account/new_device.md Decision 8 (account.new_device commit). Governing: DIRECTION §3.3, workflow 6, sign_in.md Decision 6, sign_out.md. Tests: unit (re-author of a mixed local and foreign chain); behavior (Worker: pre-sign-in saves re-authored, hosted pushes authored by the account, sign-out reverts); e2e-web (a song saved before sign-in shows as you in history after signing in and putting the book online; axe). Refinement: tasks/refinements/account/commit_author.md"
  }
  task account_screen "The account screen" {
    effort 2d
    allocate team
    complete 100
    depends !sign_in, design.theme_picker
    note "Signed-in devices with sign out, passkeys, language and theme. Workflow 13. Tests: behavior (devices with sign out, passkeys, language and theme; axe); e2e-web (another device signed out from here; theme and language kept across a reload; axe). Refinement: tasks/refinements/account/account_screen.md"
  }
  task sign_out "Signing out" {
    effort 1d
    allocate team
    complete 100
    depends !account_screen
    note "Remove this account's books (default) or keep them as local books, with unsaved changes and unpushed saves counted. Workflow 13. Tests: behavior (the choice with unsaved changes and unpushed saves counted; axe); e2e-web (sign out removing the books, and keeping them as local books; axe). Refinement: tasks/refinements/account/sign_out.md"
  }
  task leaving "Leaving" {
    effort 2d
    allocate team
    complete 100
    depends design.leaving, !account_screen, service.books, books.share
    note "Workflow 17 built: deleting the account, taking the data out. Tests: unit (leave.test.js pure predicates; account_test.go Go package); behavior (the steps workflow 17 decides; axe); e2e-api (deleting an account against the stack: its books and sessions gone, books others are members of handled as decided); e2e-web (taking the data out, then deleting the account; axe). Refinement: tasks/refinements/account/leaving.md"
  }
  task recovery_email "Recovery email; deleting a passkey-only account" {
    effort 2d
    allocate team
    complete 100
    depends !account_screen, !leaving, service.recovery_email, design.recovery_email
    note "As design.recovery_email decides: set, verify and change the recovery email on the account screen; Leaving confirms a passkey-only account's deletion with a passkey instead of the typed email. Source: tasks/parking-lot.md 2026-10-14. Tests: behavior (the email set and pending verification; the passkey confirm when there is no email; axe); e2e-web (an email set and verified via the mail catcher; a passkey-only account deleted with a virtual authenticator; axe). Refinement: tasks/refinements/account/recovery_email.md"
  }
  task preferences_layout "The account screen as drawn: compact theme rows, two columns on a computer" {
    effort 1d
    allocate team
    complete 100
    depends !account_screen
    note "The Estante, Caderno and Palco rows of the theme picker grow to about 850px each (the Theme list is about 2600px on a phone): the non-split swatch carries the theme root classes and stretches to the row (app/src/account/AccountScreen.jsx:145-159, account.css:147-150); the board draws 56px rows with a 52x40 swatch. On a computer the screen is one narrow column; the Theme-picker and W13 boards lay identity and sign-out in a left rail and Theme and Language beside devices and passkeys. Source: UI audit 2026-10-14 (app screens vs rendered boards; e2e/web/lib/mockup.js). Tests: behavior (each theme row the swatch height, axe); e2e-web (the account screen on the three viewports, mockup Theme-picker#1-4 and W13#4). Refinement: tasks/refinements/account/preferences_layout.md"
  }
  task sign_in_two_doors "Sign in and make an account as two doors" {
    effort 1.5d
    allocate team
    depends !sign_in, !recovery_email, design.sign_in_two_doors
    note "As design.sign_in_two_doors decides: one sign-in surface with an Already have an account? section (passkey, emailed link) and a New here? section (make an account), opened the same way from the cold first run, the Account screen (its not-signed-in card becomes a single entry into the surface, replacing its own passkey / email pair, AccountScreen.jsx:659-670), and a press elsewhere that names a step lands on it (Mine on Estante's email link), Mine on Estante and the add-book sheet, replacing the intent prop's create-vs-sign-in split; the invited screen's buttons land on their sections; a newly made account is asked for its recovery email at once, reusing the account screen's set-and-verify (account.recovery_email), with Not now leaving it to the account screen; and the fixed banner the design draws, shown on every screen while a signed-in account has no confirmed recovery email, gone once it is confirmed. Source: launch smoke test 2026-10-19 (the first account could not be made on a browser that already had a local book). Tests: behavior (both sections from every entry, create and authenticate each reaching the right ceremony, the emailed-link step, the recovery-email step after a create and its Not now, the banner shown with no or a pending address and gone once confirmed, not dismissible; axe); e2e-web (an account made, its recovery email set and verified via the mail catcher right after; an account that chose Not now sees the banner on every destination until it confirms one; from the Account screen after writing a local song, and signing in from the cold first run with an existing passkey makes no second account, with a virtual authenticator on the three viewports; axe). Refinement: tasks/refinements/account/sign_in_two_doors.md"
  }
}
