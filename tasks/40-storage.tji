# 40 — Storage in the browser (the Web Worker)
#
# Books as git repositories on IndexedDB, a working copy, the home book and
# the index — all owned by one Web Worker. DIRECTION §3, §3.7.

task storage "Storage" {
  depends foundation.app_tooling

  task worker "The Worker and its store protocol" {
    effort 3d
    allocate team
    complete 100
    note "One owner for the data; messages to the main thread's store, read through useSyncExternalStore. The main thread never touches IndexedDB. DIRECTION §3.7. Tests: unit (the message protocol, the store's reducer); behavior (the store fed by the Worker's logic in-process against a fake IndexedDB; components reading slices through useSyncExternalStore re-render only on their change — Testing Library). Sets up the behavior level for the Worker: fake IndexedDB and a local git remote served over HTTP inside the test. Refinement: tasks/refinements/storage/worker.md"
  }
  task fs "The filesystem layer" {
    effort 2d
    allocate team
    complete 100
    depends !worker
    note "lightning-fs behind a small interface, so OPFS can replace it; navigator.storage.persist(). Tests: unit (the filesystem interface's contract suite, run against lightning-fs on a fake IndexedDB so OPFS can later pass the same suite); behavior (persist() asked for once). Refinement: tasks/refinements/storage/fs.md"
  }
  task git "isomorphic-git" {
    effort 3d
    allocate team
    complete 100
    depends !fs
    note "Clone, fetch and push with credentials included to the one origin, protocol v1, a custom HTTP client; never getRemoteInfo2 for push. Tests: behavior (clone, fetch and push against a local git remote over HTTP; credentials included by the custom client; protocol v1; push never calls getRemoteInfo2). Refinement: tasks/refinements/storage/git.md"
  }
  task working_copy "Working copy, save and discard" {
    effort 3d
    allocate team
    complete 100
    depends !git, !locks, cifra_js.writer, cifra_js.setlists
    note "Real files written as the user types; save = canonicalise, commit one file or several, then push; discard; author as the per-user no-reply address. Workflows 3, 4, 14. Tests: unit (the author's no-reply address, canonicalising before commit); behavior (type, save one file and several, discard; the commit holds canonical text; push to the local remote; a marked text refused — workflows 3, 4, 14). Refinement: tasks/refinements/storage/working_copy.md"
  }
  task locks "One lock per book" {
    effort 1d
    allocate team
    complete 100
    depends !git
    note "Web Locks around every git operation, so two tabs never interleave. Tests: behavior (two operations on one book serialised, on two books not; a second tab's operation waits — Web Locks in the test environment). Refinement: tasks/refinements/storage/locks.md"
  }
  task home_book "The home book" {
    effort 2d
    allocate team
    complete 100
    depends !working_copy, design.home_book_format
    note "Committed automatically; settings and the shelf list; merged key by key, the later change winning. Workflows 1, 8, 13. Tests: unit (the key-by-key merge, the later change winning, equal times); behavior (settings changed in two working copies merged through the local remote, committed automatically). Refinement: tasks/refinements/storage/home_book.md"
  }
  task index "The search index" {
    effort 3d
    allocate team
    complete 100
    depends !working_copy, cifra_js.reader
    note "MiniSearch with accent folding; title, properties, sections, words, chords; keyed by blob hash; covers unsaved work; kept in IndexedDB. Workflow 2. Tests: unit (accent folding, the fields, ranking); behavior (the index built in the Worker from a book, updated on save and on unsaved edits, kept across a restart in a fake IndexedDB, keyed by blob hash so unchanged files are not re-read). Refinement: tasks/refinements/storage/index.md"
  }
  task progression_search "Chord-progression search" {
    effort 2d
    allocate team
    complete 100
    depends !index
    note "Chord n-gram field on the MiniSearch index plus a progression-aware query, so a query like 'Am F C G' finds songs that contain that chord run. App-side extension of the search index; the reader's structured item.chord is already available. Workflow 2 (Later, L42). Source of debt: tasks/refinements/storage/index.md (storage.index). Tests: unit (n-gram extraction and progression match); behavior (a progression query finds a song that contains the run, built in the Worker). Refinement: tasks/refinements/storage/progression_search.md"
  }
  task history "History" {
    effort 2d
    allocate team
    complete 100
    depends !working_copy
    note "A song's log following renames, merges hidden unless resolved, versions read as they were, restore into the working copy; the book's whole log for the file view. Workflows 6, 14. Tests: behavior (a song's log following a rename, merges hidden unless resolved, a version read as it was, restore into the working copy, the book's whole log — against a repository built in the test). Refinement: tasks/refinements/storage/history.md"
  }
  task download "Download a book" {
    effort 1d
    allocate team
    depends !working_copy
    note "Zip of the repository as it is on the device, working tree and unsaved changes included, remote removed; Explore Chords' zip writer. Workflow 7. Tests: behavior (the zip of a book with unsaved changes holds the working tree and its .git with no remote; unpacked, the git CLI shows the same log and the unsaved changes)."
  }
  task migrations "On-device versions" {
    effort 1d
    allocate team
    complete 100
    depends !worker
    note "Versioned migrations of what the Worker keeps in IndexedDB; an app update applied on the next launch, never mid-song. Tests: unit (each migration step); behavior (a store at version N opened by N+1 in a fake IndexedDB and migrated; an update held until the next launch). Refinement: tasks/refinements/storage/migrations.md"
  }
  task preferences_surface "Surface preferences from the home book" {
    effort 1d
    allocate team
    complete 100
    depends !home_book, shell.tokens
    note "The Worker reads preferences.json from the home book and emits a PREFERENCES event the reducer folds into the preferences slice (the contract defined by shell.tokens), re-emitted when sync changes a register. DIRECTION §3.2, §3.7; home-book-format §4.1. Source of debt: tasks/refinements/shell/tokens.md (shell.tokens). Tests: unit (a preferences.json map → the event payload of {value, at} registers; an absent register stays absent); behavior (the Worker against a fake IndexedDB and a local git remote surfaces a theme change, the reducer folds it, the ThemeRoot re-applies). Refinement: tasks/refinements/storage/preferences_surface.md"
  }
  task shelf_surface "Surface shelf.json for book labels and status" {
    effort 1d
    allocate team
    complete 100
    depends !home_book
    note "The Worker reads shelf.json from the home book and emits a SHELF event the reducer folds into a shelf slice (each book's label, link, and per-book status — 'reading', 'N setlists'), mirroring storage.preferences_surface; the search screen and books.shelf both read it for labels and counts. Source of debt: tasks/refinements/songs/search.md (songs.search), Decision 6. Tests: unit (shelf.json → the shelf event payload; an absent book stays absent); behavior (the Worker against a fake IndexedDB and a local git remote surfaces a shelf change, the reducer folds it). Refinement: tasks/refinements/storage/shelf_surface.md"
  }
  task fs_flush "Flush the fs superblock on save, discard, and book creation" {
    effort 0.5d
    allocate team
    complete 100
    depends !working_copy
    note "working-copy.save(), working-copy.discard(), and the CREATE_BOOK handler in logic.js still rely on lightning-fs's 500ms superblock debounce without an explicit flush() call. The same latent reload-durability gap that caused editor e2e failures (songs.editor fix 2) exists for save, discard, and book creation — a tab closed immediately after any of these operations may lose the path-to-inode map, causing ENOENT on the next open. Fix: add await fs.flush() after the git commit in working-copy.save(), after the git reset in working-copy.discard(), and after CREATE_BOOK's git.init in logic.js, mirroring the flush already applied to working-copy.write() and example-book.js. Source of debt: tasks/refinements/songs/editor.md (songs.editor). Tests: unit (none — no isolatable pure logic); behavior (save then immediate reload does not ENOENT; discard then immediate reload does not ENOENT; CREATE_BOOK then immediate reload finds the book). Refinement: tasks/refinements/storage/fs_flush.md"
  }
  task shelf_flush "Flush the fs superblock after shelf-mutating command handlers" {
    effort 0.5d
    allocate team
    complete 100
    depends !fs_flush
    note "OPEN_EXAMPLE_BOOK, RENAME_BOOK, and other command handlers that persist a home-book shelf write via home.set have no handler-tail await fs.flush(). An immediate reload after any of these can lose the shelf change (the home-book.js writes never flush on their own). Fix: a handler-tail await ensureFs().flush() on each affected handler in logic.js, mirroring the CREATE_BOOK fix from storage.fs_flush. Source of debt: tasks/refinements/storage/fs_flush.md (storage.fs_flush), Deferred-work section. Tests: unit (none — no isolatable pure logic); behavior (open-example then fresh-instance reload keeps the shelf entry; rename then fresh-instance reload keeps the new label). Refinement: tasks/refinements/storage/shelf_flush.md"
  }
  task recents_reconcile "Remove synced recents.json and reconcile home-book-format" {
    effort 0.5d
    allocate team
    complete 100
    depends songs.search
    note "Remove the now-superseded synced recents.json from the home book's SETTINGS_FILES (app/src/worker/home-book.js:56–63) and reconcile docs/home-book-format.md §4.6/§7 and tasks/refinements/storage/home_book.md §2.1/§7 with device-local recents, resolving the contradiction with DIRECTION §3.2 / workflow 2 L17–20. Source of debt: tasks/refinements/songs/search.md (songs.search). Tests: unit (recents.json no longer in SETTINGS_FILES; the key-by-key home-book merge unaffected; recording a recent commits nothing to the home book). Refinement: tasks/refinements/storage/recents_reconcile.md"
  }
}
