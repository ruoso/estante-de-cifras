# 75 — Quality
#
# Tests the design depends on, beyond each task's own.

task quality "Quality" {
  depends foundation.ci

  task e2e_local "End-to-end: local books" {
    effort 3d
    allocate team
    depends songs.save_sheet, songs.history, songs.arrange
    note "Playwright on phone, tablet and computer viewports: write, edit, save, discard, arrange, history, transpose — offline."
  }
  task e2e_sync "End-to-end: two devices, one book" {
    effort 3d
    allocate team
    depends sync.conflicts, books.share
    note "Against compose: invite, edit on both, sync, clean merges, a conflict settled, losing access."
  }
  task service_tests "Service and hook tests" {
    effort 2d
    allocate team
    depends hook.messages, service.sharing
    note "gzip bodies, protocol v2 fetches, a client disconnecting mid-push, every refusal of the hook, the fifty-person limit, quotas."
  }
  task a11y "Accessibility" {
    effort 2d
    allocate team
    depends shell.a11y_chart, songs.arrange, books.setlists
    note "axe at WCAG 2.1 AA on every screen; keyboard paths through the picker, setlist reorder, conflicts; screen-reader passes on a chart."
  }
  task offline "Offline" {
    effort 1d
    allocate team
    depends shell.pwa, songs.reading
    note "Reload with the network off and use a song, search, the explorer and a save that waits."
  }
}
